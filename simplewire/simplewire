#!/usr/bin/env bash
#
# simplewire — WireGuard server manager for a fresh VPS.
#
# Requires systemd and iptables: Debian, Ubuntu, Arch, and Fedora/RHEL with
# firewalld off. Anything else is refused at startup rather than half-supported.
#
# Install     : installs wireguard-tools and qrencode with whichever of apt-get,
#               pacman, dnf or zypper is present, generates the server keypair
#               under /etc/wireguard/keys (0600), writes wg0.conf that
#               *references* the key file instead of embedding it, sets up NAT +
#               forwarding in iptables, enables wg-quick@wg0.
# Add device  : new keypair, next free IP, [Peer] block, ready-to-use client .conf,
#               QR code printed to the terminal.
# Remove      : deletes the peer block and its files, live-reloads without dropping
#               the other peers' sessions.
# Uninstall   : tears down the interface, the iptables rules and /etc/wireguard.
#
# Design notes:
#   * No secrets live in wg0.conf. The server private key is loaded at interface-up
#     via `PostUp = wg set %i private-key <file>`; client private keys live only in
#     their own 0600 files under /etc/wireguard/clients.
#   * IPv4 tunnel only. Clients also get a ULA IPv6 address and AllowedIPs ::/0, so
#     IPv6 traffic is pulled into the tunnel and dropped at the server rather than
#     leaking out over the client's own IPv6 connection.
#   * Default iptables policies are never touched — this cannot lock you out of SSH.
#     Every rule it adds carries the comment "simplewire" so you can audit/remove
#     them by hand:  iptables-save | grep simplewire
#   * A device's web traffic can be diverted to an intercepting proxy running on
#     another device on the VPN (menu option 6) — Burp Suite with "invisible
#     proxying", or mitmproxy. tcp/80 and tcp/443 are DNAT'd to it and udp/443 is
#     rejected so QUIC cannot slip past. The device itself is configured with
#     nothing, which is what makes it work on apps that ignore proxy settings.
#   * Devices share one tunnel subnet, so by default each one can reach the others
#     — that is what makes a personal VPN useful. "Add device" asks per device, and
#     answering 'n' stops that one from OPENING connections to the rest, while your
#     other devices can still reach in to it and its internet access is untouched.
#     A device that is both isolated and proxied reaches its proxy on the proxy
#     port only. It does NOT fence it off from this server:
#     traffic to the server's own address hits INPUT, not FORWARD, so whatever
#     your host firewall already allows from the internet is also reachable from
#     the tunnel. Bind private services to localhost, or add INPUT rules for wg0.
#
# On port choice:
#   The default listen port is 443/udp (QUIC / HTTP-3), because a network that
#   permits web traffic usually permits it; 51820 is aliased to it, and 53 is
#   offered as an opt-in alias. Every port is probed first, and anything already
#   in use is skipped — if both defaults are taken the script suggests a free
#   random port. Aliases are DNAT'd to the one instance, so a client can just
#   switch its Endpoint line if one port is filtered. This defeats *port-based*
#   blocking — ACLs on hotel, campus and
#   office networks. It does NOT defeat deep packet inspection: WireGuard's
#   handshake is trivially fingerprintable (fixed 148/92-byte handshake packets
#   with a constant leading message-type byte), so DPI identifies it on any port.
#   Beating DPI requires a different protocol, not a different port.
#
set -euo pipefail
umask 077

WG_IF=wg0
WGDIR=/etc/wireguard
KEYDIR=$WGDIR/keys
CLIENTDIR=$WGDIR/clients
WG_CONF=$WGDIR/$WG_IF.conf
STATE=$WGDIR/simplewire.env
SYSCTL_FILE=/etc/sysctl.d/99-wireguard.conf
TAG=simplewire
V6_NET="fd42:42:42::"          # ULA prefix used inside the tunnel (blackholed v6)

# ---------------------------------------------------------------- helpers ----

die()  { printf '\nERROR: %s\n' "$*" >&2; exit 1; }
info() { printf '  %s\n' "$*"; }
head1(){ printf '\n== %s ==\n' "$*"; }

ask() {  # ask "prompt" ["default"] -> answer on stdout (bash prints -p to stderr)
    local prompt=$1 def=${2-} ans=''
    if [ -n "$def" ]; then
        read -r -p "$prompt [$def]: " ans || true
        printf '%s' "${ans:-$def}"
    else
        read -r -p "$prompt: " ans || true
        printf '%s' "$ans"
    fi
}

confirm() {  # confirm "question" -> 0 if user typed y/yes
    local ans
    ans=$(ask "$1 (y/N)" "n")
    [[ ${ans,,} == y || ${ans,,} == yes ]]
}

confirm_yes() {  # confirm "question" -> 0 unless user typed n/no
    local ans
    ans=$(ask "$1 (Y/n)" "y")
    [[ ${ans,,} != n && ${ans,,} != no ]]
}

ip2int() {
    local IFS=. a b c d
    read -r a b c d <<<"$1"
    printf '%s' $(( (10#$a << 24) + (10#$b << 16) + (10#$c << 8) + 10#$d ))
}

int2ip() {
    local i=$1
    printf '%s.%s.%s.%s' $(( (i >> 24) & 255 )) $(( (i >> 16) & 255 )) \
                         $(( (i >> 8) & 255 ))  $((  i        & 255 ))
}

valid_ipv4() {
    [[ $1 =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
    local IFS=. o
    for o in $1; do [ "$o" -le 255 ] || return 1; done
}

detect_wan() { ip -4 route show default 2>/dev/null | awk '/^default/{print $5; exit}'; }
detect_ip()  { ip -4 addr show dev "$1" 2>/dev/null | awk '/inet /{print $2; exit}' | cut -d/ -f1; }

# A WireGuard interface name is the config file's basename, and wg-quick only
# accepts ^[a-zA-Z0-9_=+.-]{1,15}$ — so "john@vm1" cannot be an interface name.
# The client tunnel is therefore named after the SERVER host (that is what
# identifies which VPN it is, from the client's point of view), while the
# NetworkManager connection gets the pretty "<device>@<server>" label, which is
# free-form text and is what the user actually sees in the desktop menu.
sanitize_ifname() {
    local s
    s=$(printf '%s' "$1" | tr -c 'a-zA-Z0-9_=+.-' '-')
    s=${s:0:15}
    s=$(printf '%s' "$s" | sed 's/-*$//')
    printf '%s' "${s:-wg}"
}

# Name suggested for the tunnel itself, on any platform. Must satisfy
# [a-zA-Z0-9_=+.-]{1,15} — the Android app enforces exactly the same rule as
# wg-quick (Tunnel.NAME_PATTERN), so "device@server" is not usable there. iOS
# and the desktop apps are more permissive, so a name that satisfies Android
# satisfies all of them; that is why the strictest rule is the one used.
# Prefer "device-server" when it fits; otherwise fall back to the server name,
# which is what actually identifies the VPN from the client's side.
suggest_tunnel_name() {
    local raw="$1-$SERVER_HOST"
    if [ "${#raw}" -le 15 ]; then
        sanitize_ifname "$raw"
    else
        sanitize_ifname "$SERVER_HOST"
    fi
}

# "server" is reserved: peer keys live in the same directory as the server's, so
# a device by that name would overwrite $KEYDIR/server.key and permanently break
# every existing peer.
valid_name() {
    [[ $1 =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid device name: $1"
    [ "$1" != server ] || die "'server' is reserved — it would overwrite the server keypair"
}

# ------------------------------------------------------------- platform ------
#
# Supported: systemd + iptables. That is Debian, Ubuntu, Arch, and Fedora/RHEL
# with firewalld turned off. Anything else is refused rather than half-supported
# — see the firewalld note below for why a silent half-success is the worse
# outcome here.

detect_pm() {  # first supported package manager on PATH
    local pm
    for pm in apt-get pacman dnf zypper; do
        command -v "$pm" >/dev/null 2>&1 && { printf '%s' "$pm"; return 0; }
    done
    return 1
}

require_platform() {
    command -v systemctl >/dev/null 2>&1 \
        || die "systemd is required — the tunnel is run as the wg-quick@$WG_IF unit.
  On OpenRC/runit systems, bring wg-quick up however your init does it and
  this script has nothing left to manage."
    command -v iptables >/dev/null 2>&1 || die "iptables is required (iptables-nft is fine)"
    # firewalld keeps its rules in the nftables 'inet firewalld' table while
    # ours land in 'ip filter'. Both are evaluated and a DROP in either wins, so
    # our INPUT ACCEPT would install cleanly and the port would still be shut.
    # That failure looks exactly like a working install, hence the hard stop.
    if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
        die "firewalld is running, and it would silently override these rules.
  Its rules live in the nftables 'inet firewalld' table, ours in 'ip filter';
  both are evaluated, so firewalld's default zone keeps dropping the traffic
  even once the rules here are installed. The listen port would look open and
  not be. Either turn it off:
      systemctl disable --now firewalld
  or drop this script and configure WireGuard through firewall-cmd instead."
    fi
}

need_root()      { [ "$(id -u)" -eq 0 ] || die "run this as root (sudo $0)"; }
is_installed()   { [ -f "$STATE" ] && [ -f "$WG_CONF" ]; }
load_state()     { # shellcheck source=/dev/null
                   . "$STATE"; : "${ALT_PORTS:=}"
                   : "${SERVER_HOST:=$(sanitize_ifname "$(hostname -s 2>/dev/null || echo wg)")}"; }

# Written in one place so install and later edits produce the same file. Values
# are quoted because load_state *sources* it; everything stored here is
# validated at the prompt, so a single quote cannot appear in one.
write_state() {
    cat > "$STATE" <<EOF
WG_IF='$WG_IF'
WAN_IF='$WAN_IF'
SUBNET='$SUBNET'
NET_ADDR='$NET_ADDR'
PREFIX='$PREFIX'
SERVER_IP='$SERVER_IP'
MAX_HOST='$MAX_HOST'
PORT='$PORT'
ALT_PORTS='$ALT_PORTS'
SERVER_HOST='$SERVER_HOST'
ENDPOINT='$ENDPOINT'
CLIENT_DNS='$CLIENT_DNS'
EOF
    chmod 600 "$STATE"
}

# ---------------------------------------------------------- port picking -----
#
# "Busy" means two different things here, and the difference is what lets us
# share udp/53 with a local resolver:
#
#   * The port WireGuard BINDS must have no UDP socket on it at all — not even a
#     loopback-only one. Binding 0.0.0.0:P returns EADDRINUSE while another
#     process holds 127.0.0.1:P, so a local resolver really does block it.
#
#   * An ALIASED port is only DNAT'd; nothing binds it. The redirect matches
#     "-i $WAN_IF", so it sees external traffic only, and locally-generated
#     lookups traverse OUTPUT->POSTROUTING and never reach PREROUTING at all.
#     A resolver bound to 127.0.0.53 or 127.0.0.1 therefore keeps working
#     untouched. Only a *publicly* bound service genuinely conflicts, because
#     its inbound traffic would be redirected away to WireGuard.

port_listeners() {  # <port> -> "local-address process" lines, empty if free
    ss -H -lunp "sport = :$1" 2>/dev/null | awk '{print $4, $6}'
}

port_free() { [ -z "$(port_listeners "$1")" ]; }

port_public() {  # 0 if something reachable from off-box holds the port
    local addr rest
    while read -r addr rest; do
        [ -n "$addr" ] || continue
        case ${addr%:*} in
            127.*|'[::1]'|*%lo) continue ;;   # loopback-only: harmless for an alias
        esac
        return 0
    done < <(port_listeners "$1")
    return 1
}

describe_port() {  # one-line human description of what holds <port>
    local all n first addr proc
    all=$(port_listeners "$1")
    if [ -z "$all" ]; then printf 'nothing'; return; fi
    n=$(printf '%s\n' "$all" | wc -l)
    first=$(printf '%s\n' "$all" | head -1)
    addr=${first%% *}
    proc=$(printf '%s' "$first" | sed -n 's/.*users:((\"\([^\"]*\)\".*/\1/p')
    printf '%s' "$addr"
    [ -n "$proc" ] && printf ' (%s)' "$proc"
    [ "$n" -gt 1 ] && printf ' +%d more' "$(( n - 1 ))"
    return 0
}

random_free_port() {
    local p n=0
    while [ "$n" -lt 100 ]; do
        p=$(( 20000 + RANDOM % 40000 ))
        if port_free "$p"; then printf '%s' "$p"; return 0; fi
        n=$((n+1))
    done
    die "could not find a free UDP port"
}

# Sets PORT and ALT_PORTS. Needs WAN_IF.
choose_ports() {
    local pref=443 fallback=51820 suggest p alt=()

    head1 "Ports"
    if port_free "$pref"; then
        suggest=$pref
    elif port_free "$fallback"; then
        suggest=$fallback
        info "udp/$pref is taken by $(describe_port "$pref")"
        info "suggesting udp/$fallback as the listen port instead"
    else
        suggest=$(random_free_port)
        info "udp/$pref is taken by $(describe_port "$pref")"
        info "udp/$fallback is taken by $(describe_port "$fallback")"
        info "both defaults are in use — suggesting a free random port, udp/$suggest"
    fi

    PORT=$(ask "UDP listen port" "$suggest")
    [[ $PORT =~ ^[0-9]+$ ]] && [ "$PORT" -ge 1 ] && [ "$PORT" -le 65535 ] || die "bad port: $PORT"
    port_free "$PORT" || die "udp/$PORT is held by $(describe_port "$PORT") — WireGuard cannot bind it"

    # Alias whichever of the two standard ports we are not already using,
    # unless something publicly reachable is sitting on it.
    for p in "$pref" "$fallback"; do
        if [ "$p" = "$PORT" ]; then continue; fi
        if port_public "$p"; then
            info "not aliasing udp/$p — publicly served by $(describe_port "$p")"
            continue
        fi
        alt+=("$p")
    done

    # udp/53 is opt-in: it is the most useful port on captive-portal networks
    # but also the one most likely to collide with something real.
    if port_public 53; then
        info "not offering udp/53 — it is served publicly by $(describe_port 53),"
        info "and redirecting it would hijack DNS queries sent to this server"
    else
        printf '\n  udp/53 is often reachable on captive-portal, hotel and guest networks.\n'
        if port_free 53; then
            printf '  Nothing is listening on udp/53 here.\n'
        else
            printf '  A resolver holds udp/53 but only on loopback (%s).\n' "$(describe_port 53)"
            printf '  It keeps working: the redirect only matches traffic arriving on\n'
            printf '  %s, and local lookups never traverse PREROUTING.\n' "$WAN_IF"
        fi
        if confirm "  Also accept WireGuard on udp/53?"; then
            alt+=(53)
        fi
    fi

    ALT_PORTS=$(IFS=,; printf '%s' "${alt[*]:-}")

    # Say what was decided — ports accepted silently are otherwise invisible.
    printf '\n'
    info "listen port : udp/$PORT   (clients use this by default)"
    if [ -n "$ALT_PORTS" ]; then
        info "also answers: udp/${ALT_PORTS//,/, udp/}   (redirected to udp/$PORT)"
    else
        info "also answers: nothing else — udp/$PORT only"
    fi
    info "open udp/$PORT${ALT_PORTS:+,$ALT_PORTS} in your provider's cloud firewall"
}

# ------------------------------------------------------------- iptables ------

# Rules are "<command> <table> <chain> <spec…>". The comment match is part of
# the spec so that -C / -D match exactly what -I inserted.
build_rules() {
    local ip dev px port
    RULES=(
      "iptables nat POSTROUTING -s $SUBNET -o $WAN_IF -m comment --comment $TAG -j MASQUERADE"
      "iptables filter INPUT -p udp --dport $PORT -m comment --comment $TAG -j ACCEPT"
      "iptables filter FORWARD -i $WG_IF -o $WAN_IF -m comment --comment $TAG -j ACCEPT"
      "iptables filter FORWARD -i $WAN_IF -o $WG_IF -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment $TAG -j ACCEPT"
      # Devices share one subnet, so device-to-device traffic is wg0 -> wg0.
      # Stated explicitly so it works the same whether the host's FORWARD
      # policy is ACCEPT (stock Debian) or DROP (hardened box).
      "iptables filter FORWARD -i $WG_IF -o $WG_IF -m comment --comment $TAG -j ACCEPT"
    )
    # The ULA v6 inside the tunnel exists only to swallow the client's IPv6
    # traffic, so nothing from wg0 should ever be forwarded or delivered. These
    # make that true instead of relying on net.ipv6.conf.all.forwarding being 0:
    # where a host image has it on, the isolation DROPs below would be bypassed
    # entirely — they are iptables, and peer-to-peer over fd42:42:42::/64 is
    # ip6tables. Skipped on hosts built without IPv6.
    if ip6tables -L -n >/dev/null 2>&1; then
        RULES+=("ip6tables filter FORWARD -i $WG_IF -m comment --comment $TAG -j DROP")
        RULES+=("ip6tables filter INPUT -i $WG_IF -m comment --comment $TAG -j DROP")
    fi
    # Devices answered "n" at add time cannot OPEN a connection to the others.
    # The reverse direction stays open on purpose: the isolated device is the
    # untrusted one, the rest are yours, so you keep being able to reach in and
    # administer it. The conntrack ACCEPT is what makes that work — the reply
    # leg of an inbound connection is sourced by the isolated device, so a bare
    # source DROP would leave every inbound connection half-open.
    #
    # Their internet access (wg0 -> WAN) and their access to this server (INPUT)
    # are untouched either way.
    #
    # ORDER: apply_rules inserts every rule at position 1, so entries LATER in
    # this array end up HIGHER in the chain. The DROP must stay after the blanket
    # ACCEPT above, and the conntrack ACCEPT after the DROP it sits above.
    while read -r ip; do
        [ -n "$ip" ] || continue
        RULES+=("iptables filter FORWARD -i $WG_IF -o $WG_IF -s $ip/32 -m comment --comment $TAG -j DROP")
        RULES+=("iptables filter FORWARD -i $WG_IF -o $WG_IF -s $ip/32 -m conntrack --ctstate RELATED,ESTABLISHED -m comment --comment $TAG -j ACCEPT")
    done < <(isolated_ips)
    # Transparent proxying. Burp ("invisible proxying") and mitmproxy recover the
    # real destination from the Host header and the TLS SNI rather than from
    # SO_ORIGINAL_DST, which is why the proxy can sit on a different machine than
    # the one doing the NAT — a plain DNAT to it is enough. The device needs no
    # proxy settings at all, so apps that ignore them (Flutter's HttpClient being
    # the usual offender) are caught too.
    #
    # ORDER: these go last in the array, so they land at the TOP of their chains
    # — above the isolation DROPs, which would otherwise block a fenced-off
    # device from reaching the very proxy it is supposed to use.
    while read -r dev px port; do
        [ -n "$dev" ] || continue
        # Excluding the tunnel subnet keeps device-to-device traffic, and traffic
        # to this server, off the proxy — only outbound web traffic is diverted.
        RULES+=("iptables nat PREROUTING -i $WG_IF -s $dev ! -d $SUBNET -p tcp -m multiport --dports 80,443 -m comment --comment $TAG -j DNAT --to-destination $px:$port")
        # QUIC sails straight past an HTTP proxy, so a proxied device must not be
        # allowed to speak it — otherwise a large share of its traffic silently
        # bypasses the intercept and nothing looks wrong. REJECT rather than DROP
        # so clients fall back to TCP at once instead of waiting for a timeout.
        RULES+=("iptables filter FORWARD -i $WG_IF -s $dev -p udp --dport 443 -m comment --comment $TAG -j REJECT --reject-with icmp-port-unreachable")
        # nat/PREROUTING has already rewritten the destination by the time the
        # packet reaches FORWARD, so matching the proxy port here grants an
        # isolated device exactly its proxy and nothing else on that machine —
        # no SSH, no file shares, no dev servers. Replies need no rule: the
        # isolation DROP above is source-scoped, so inbound is never blocked.
        RULES+=("iptables filter FORWARD -i $WG_IF -o $WG_IF -s $dev -d $px -p tcp --dport $port -m comment --comment $TAG -j ACCEPT")
    done < <(proxied_peers)
    # Extra ports are DNAT'd to the real listen port, so one wg instance answers
    # on several ports and a client can just switch its Endpoint if one is
    # blocked. No extra INPUT rule needed: nat/PREROUTING runs before
    # filter/INPUT, so by then the dport is already $PORT.
    if [ -n "${ALT_PORTS:-}" ]; then
        RULES+=("iptables nat PREROUTING -i $WAN_IF -p udp -m multiport --dports $ALT_PORTS -m comment --comment $TAG -j REDIRECT --to-ports $PORT")
    fi
}

apply_rules() {  # apply_rules add|del
    local action=$1 r cmd table chain spec
    build_rules
    for r in "${RULES[@]}"; do
        cmd=${r%% *};   r=${r#* }
        table=${r%% *}; r=${r#* }
        chain=${r%% *}; spec=${r#* }
        # shellcheck disable=SC2086  # deliberate word splitting of the rule spec
        if [ "$action" = add ]; then
            "$cmd" -t "$table" -C "$chain" $spec 2>/dev/null || \
            "$cmd" -t "$table" -I "$chain" 1 $spec
        else
            while "$cmd" -t "$table" -C "$chain" $spec 2>/dev/null; do
                "$cmd" -t "$table" -D "$chain" $spec
            done
        fi
    done
}

# Rules are NOT persisted through a distro package. wg0.conf carries
#   PostUp = simplewire --apply-rules
# so they reinstall themselves whenever the interface comes up. That works the
# same on every distro, needs no iptables-persistent equivalent (every distro
# spells it differently), and self-heals after anything that flushes iptables.
# To restore them by hand at any time:  simplewire --apply-rules

# --------------------------------------------------------------- wg state ----

reload_wg() {
    systemctl is-active --quiet "wg-quick@$WG_IF" || return 0
    wg syncconf "$WG_IF" <(wg-quick strip "$WG_IF")
    wg set "$WG_IF" private-key "$KEYDIR/server.key"   # not carried by `strip`
}

used_ips() { awk -F'[ =,/]+' '/^AllowedIPs/{print $2}' "$WG_CONF"; }

peer_names() { awk '/^### BEGIN peer /{print $4}' "$WG_CONF"; }

peer_exists() { peer_names | grep -qxF -- "$1"; }

peer_ip() {  # peer_ip <name> -> its tunnel IPv4
    awk -v w="$1" '
        $0 == "### BEGIN peer " w {f=1}
        f && /^AllowedIPs/ {split($3,a,"/"); print a[1]; exit}' "$WG_CONF"
}

# All peers share one subnet, so by default any device can reach any other. A
# device added with "reach the other devices? n" gets "# reach-peers = no" in
# its block and a pair of DROP rules (see build_rules). Blocks written before
# this option existed carry no marker and stay unrestricted.
peer_isolated() {  # peer_isolated <name> -> 0 if fenced off from the other peers
    awk -v w="$1" '
        $0 == "### BEGIN peer " w  {f=1}
        f && /^### END peer /      {f=0}
        f && $0 == "# reach-peers = no" {iso=1}
        END {exit iso ? 0 : 1}' "$WG_CONF"
}

isolated_ips() {  # tunnel IPv4 of every device fenced off from the other peers
    [ -f "$WG_CONF" ] || return 0
    awk '
        /^### BEGIN peer /         {iso=0; ip=""}
        $0 == "# reach-peers = no" {iso=1}
        /^AllowedIPs/              {split($3,a,"/"); ip=a[1]}
        /^### END peer /           {if (iso && ip != "") print ip}' "$WG_CONF"
}

# A device's web traffic can be DNAT'd to an intercepting proxy running on
# another device on the VPN — Burp Suite with "invisible proxying" enabled, or
# mitmproxy. Recorded per device as "# proxy = <ip>:<port>".
peer_proxy() {  # peer_proxy <name> -> "<ip>:<port>", empty if not proxied
    awk -v w="$1" '
        $0 == "### BEGIN peer " w {f=1}
        f && /^### END peer /     {f=0}
        f && /^# proxy = /        {print $4}' "$WG_CONF"
}

proxied_peers() {  # "<device-ip> <proxy-ip> <proxy-port>" per proxied device
    [ -f "$WG_CONF" ] || return 0
    awk '
        /^### BEGIN peer / {px=""; ip=""}
        /^# proxy = /      {px=$4}
        /^AllowedIPs/      {split($3,a,"/"); ip=a[1]}
        /^### END peer /   {if (px != "" && ip != "") {split(px,b,":"); print ip, b[1], b[2]}}
    ' "$WG_CONF"
}

# Accepts the name of another device on the VPN (its tunnel address is looked
# up) or a bare <ip>[:<port>]. Port defaults to 8080 — Burp's and mitmproxy's.
resolve_proxy() {  # resolve_proxy <answer> -> "<ip>:<port>"
    local a=$1 host port
    host=${a%%:*}; port=${a#*:}
    [ "$port" = "$a" ] && port=8080
    if peer_exists "$host"; then host=$(peer_ip "$host"); fi
    valid_ipv4 "$host" || die "proxy must be a device name or an IP address: $a"
    [[ $port =~ ^[0-9]+$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] \
        || die "bad proxy port: $port"
    printf '%s:%s' "$host" "$port"
}

list_peers() {
    local n=0 name flags px
    while read -r name; do
        [ -n "$name" ] || continue
        n=$((n+1))
        flags=''
        peer_isolated "$name" && flags='isolated'
        px=$(peer_proxy "$name")
        [ -n "$px" ] && flags="${flags:+$flags, }proxy $px"
        printf '  %-22s %-14s %-34s %s\n' "$name" "$(peer_ip "$name")" \
            "$([ -f "$CLIENTDIR/$name.conf" ] && echo "$CLIENTDIR/$name.conf" || echo '(conf missing)')" \
            "$flags"
    done < <(peer_names)
    [ "$n" -gt 0 ] || info "(no devices yet)"
}

# Next address = highest currently-assigned host + 1
next_ip() {
    local max cur ip
    max=$(ip2int "$SERVER_IP")
    while read -r ip; do
        [ -n "$ip" ] || continue
        cur=$(ip2int "$ip")
        if [ "$cur" -gt "$max" ]; then max=$cur; fi
    done < <(used_ips)
    int2ip $(( max + 1 ))
}

v6_for() {  # v6_for <ipv4>  -> ULA address with the same host offset
    local off
    off=$(( $(ip2int "$1") - $(ip2int "$NET_ADDR") ))
    printf '%s%x' "$V6_NET" "$off"
}

# ---------------------------------------------------------------- install ----

do_install() {
    head1 "Install WireGuard server"

    local wan pubip subnet dns endpoint prefix net_int mask SELF
    SELF=$(readlink -f "$0")   # baked into wg0.conf's PostUp, so it must be absolute

    wan=$(detect_wan) || true
    wan=$(ask "WAN interface" "${wan:-eth0}")
    ip link show "$wan" >/dev/null 2>&1 || die "interface '$wan' does not exist"

    pubip=$(detect_ip "$wan") || true
    # Kept to hostname/IP characters: this value is written into the state file
    # (which load_state sources) and into the paste-and-run block for clients.
    endpoint=$(ask "Public address clients will connect to (IP or hostname)" "${pubip:-}")
    [[ $endpoint =~ ^[A-Za-z0-9._-]+$ ]] || die "endpoint must be an IP or hostname: ${endpoint:-<empty>}"

    subnet=$(ask "Tunnel subnet (CIDR)" "10.8.0.0/24")
    [[ $subnet =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]{1,2})$ ]] || die "bad subnet: $subnet"
    prefix=${subnet#*/}
    [ "$prefix" -ge 8 ] && [ "$prefix" -le 30 ] || die "prefix must be between /8 and /30"
    valid_ipv4 "${subnet%/*}" || die "bad network address"

    WAN_IF=$wan          # choose_ports explains the udp/53 redirect in terms of it
    choose_ports         # sets PORT and ALT_PORTS

    dns=$(ask "DNS pushed to clients (or 'none')" "1.1.1.1")
    if [ "$dns" = "none" ]; then dns=""; fi
    [ -z "$dns" ] || [[ $dns =~ ^[0-9a-fA-F.:,\ ]+$ ]] || die "DNS must be IP addresses: $dns"

    # normalise to the real network address, derive the server address
    mask=$(( 0xFFFFFFFF ^ ((1 << (32 - prefix)) - 1) ))
    net_int=$(( $(ip2int "${subnet%/*}") & mask ))

    NET_ADDR=$(int2ip "$net_int")
    SUBNET="$NET_ADDR/$prefix"
    PREFIX=$prefix
    SERVER_IP=$(int2ip $(( net_int + 1 )))
    SERVER_HOST=$(sanitize_ifname "$(hostname -s 2>/dev/null || echo wg)")
    ENDPOINT=$endpoint
    CLIENT_DNS=$dns
    MAX_HOST=$(( net_int + (1 << (32 - prefix)) - 2 ))

    head1 "Installing packages"
    local pm
    pm=$(detect_pm) || die "no supported package manager found (apt-get, pacman, dnf or zypper)"
    info "using $pm"
    # No persistence package: wg0.conf's PostUp re-applies the rules on every
    # interface-up, which is portable and self-healing. See save_rules' comment.
    case $pm in
        apt-get) DEBIAN_FRONTEND=noninteractive apt-get update -qq
                 DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
                     --no-install-recommends wireguard-tools qrencode iptables ;;
        pacman)  pacman -Sy --needed --noconfirm wireguard-tools qrencode iptables ;;
        dnf)     dnf install -y -q wireguard-tools qrencode iptables ;;
        zypper)  zypper --non-interactive --quiet install wireguard-tools qrencode iptables ;;
    esac
    modprobe wireguard 2>/dev/null || true

    head1 "Configuring"
    printf 'net.ipv4.ip_forward=1\n' > "$SYSCTL_FILE"
    chmod 644 "$SYSCTL_FILE"
    sysctl -q --system
    info "IPv4 forwarding enabled ($SYSCTL_FILE)"

    install -d -m 700 "$WGDIR" "$KEYDIR" "$CLIENTDIR"
    wg genkey > "$KEYDIR/server.key"
    chmod 600 "$KEYDIR/server.key"
    wg pubkey < "$KEYDIR/server.key" > "$KEYDIR/server.pub"
    chmod 644 "$KEYDIR/server.pub"
    info "server keypair written to $KEYDIR (private key 0600, root-only dir)"

    cat > "$WG_CONF" <<EOF
# Managed by simplewire — edit peers through the script, not by hand.
[Interface]
Address    = $SERVER_IP/$PREFIX, ${V6_NET}1/64
ListenPort = $PORT
# The private key deliberately does not live in this file:
PostUp     = wg set %i private-key $KEYDIR/server.key
# Re-applies the firewall rules on every interface-up, so they survive reboots
# without a persistence package and come back after anything flushes iptables.
# '|| true' so that moving this script cannot stop the tunnel from coming up.
PostUp     = "$SELF" --apply-rules || true
EOF
    chmod 600 "$WG_CONF"

    write_state

    apply_rules add

    systemctl enable -q --now "wg-quick@$WG_IF"

    head1 "Done"
    info "interface : $WG_IF  ($SERVER_IP/$PREFIX, listening on udp/$PORT)"
    info "endpoint  : $ENDPOINT:$PORT"
    if [ -n "$ALT_PORTS" ]; then
        info "also on   : udp/${ALT_PORTS//,/, udp/}  (redirected to udp/$PORT)"
    fi
    info "server pub: $(cat "$KEYDIR/server.pub")"
    printf '\nOpen udp/%s%s in your VPS provider'"'"'s firewall if it has one, then add a device.\n' \
        "$PORT" "$([ -n "$ALT_PORTS" ] && printf ',%s' "$ALT_PORTS" || true)"
}

