def ffmpeg_missing():
    return not (have("ffmpeg") and have("ffprobe"))


def has_encoder(name):
    """True if this ffmpeg build ships the given encoder (e.g. libx264)."""
    try:
        out = subprocess.check_output(["ffmpeg", "-hide_banner", "-encoders"],
                                      stderr=subprocess.DEVNULL).decode()
    except Exception:
        return False
    return any(line.split()[1:2] == [name]
               for line in out.splitlines() if line[:1] == " ")


def probe(path):
    """Return dict: has_video, has_audio, audio_codec, duration_us."""
    try:
        out = subprocess.check_output(
            ["ffprobe", "-v", "error", "-show_streams", "-show_format",
             "-of", "json", path], stderr=subprocess.DEVNULL)
        data = json.loads(out.decode("utf-8", "replace"))
    except Exception:
        return {"has_video": False, "has_audio": False,
                "audio_codec": None, "duration_us": 0}
    hv = ha = False
    acodec = None
    for s in data.get("streams", []):
        t = s.get("codec_type")
        if t == "video" and s.get("disposition", {}).get("attached_pic", 0) == 0:
            hv = True
        elif t == "audio":
            ha = True
            if acodec is None:
                acodec = s.get("codec_name")
    try:
        dur = float(data.get("format", {}).get("duration", 0)) * 1_000_000
    except (TypeError, ValueError):
        dur = 0
    return {"has_video": hv, "has_audio": ha,
            "audio_codec": acodec, "duration_us": int(dur)}


# ================================================================ gpu detection ==
def gpu_method(pref):
    """Return (method_or_None, alert_message_or_None) for hardware DECODE."""
    if pref == "off":
        return None, None
    try:
        avail = subprocess.check_output(["ffmpeg", "-hide_banner", "-hwaccels"],
                                        stderr=subprocess.DEVNULL).decode().split()
    except Exception:
        avail = []
    if pref not in ("auto", ""):
        if pref in avail:
            return pref, None
        return None, "requested --hwaccel '%s' not in this ffmpeg; using CPU" % pref
    if have("nvidia-smi"):
        if "cuda" in avail and subprocess.call(
                ["nvidia-smi"], stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL) == 0:
            return "cuda", None
        return None, ("NVIDIA GPU found but unusable by ffmpeg - install the "
                      "NVIDIA driver + an ffmpeg with nvdec.")
    dri = os.path.isdir("/dev/dri") and any(
        n.startswith("renderD") for n in os.listdir("/dev/dri"))
    if dri:
        if "vaapi" in avail:
            return "vaapi", None
        return None, ("GPU present but VAAPI not ready - install a VAAPI driver "
                      "(intel-media-driver / mesa) + libva.")
    return None, None


# ==================================================================== encoding ==
def default_output(inp, profile, audio):
    """Return (out_path_next_to_input, ffmpeg_tail, duration_us)."""
    info = probe(inp)
    base = os.path.splitext(inp)[0]

    if not info["has_video"] and info["has_audio"]:
        ext = AUDIO_ONLY_EXT.get(audio, "wav")
        tail = ["-vn"] + AUDIO[audio][0]
        return base + "." + ext, tail, info["duration_us"]

    vargs, pix, ext = PROFILES[profile]
    # keep the requested audio if the container allows it, else fall back to a
    # container-valid, Resolve-decodable codec (prefer lossless).
    if ext in AUDIO[audio][1]:
        a = audio
    else:
        a = next((c for c in ("pcm16", "alac", "mp3") if ext in AUDIO[c][1]), "none")
    tail = list(vargs) + ["-pix_fmt", pix, "-map", "0:v:0"]
    if a != "none":
        tail += ["-map", "0:a:0?"]
    tail += ["-color_primaries", "bt709", "-color_trc", "bt709",
             "-colorspace", "bt709"] + AUDIO[a][0]
    return base + "." + ext, tail, info["duration_us"]


def deliver_output(inp, crf, codec):
    """Return (out_path.mp4, ffmpeg_tail, duration_us) for a universal upload file."""
    info = probe(inp)
    base = os.path.splitext(inp)[0]
    q = str(DELIVER_DEFAULT_CRF[codec] if crf is None else crf)

    # if the source audio is already AAC, copy it as-is (no needless lossy re-encode);
    # otherwise (e.g. a PCM DNxHR master) encode to AAC 192k.
    atail = (["-c:a", "copy"] if info["audio_codec"] == "aac"
             else ["-c:a", "aac", "-b:a", "192k"])

    if not info["has_video"] and info["has_audio"]:
        # audio-only input -> plain .m4a
        return base + ".m4a", ["-vn"] + atail, info["duration_us"]

    if codec == "av1":
        vtail = ["-c:v", "libsvtav1", "-crf", q, "-preset", "6"]
    elif codec == "hevc":
        # -tag:v hvc1 so QuickTime/Apple/Instagram recognise the H.265 stream
        vtail = ["-c:v", "libx265", "-crf", q, "-preset", "medium", "-tag:v", "hvc1"]
    else:
        vtail = ["-c:v", "libx264", "-crf", q, "-preset", "medium"]
    tail = vtail + ["-pix_fmt", "yuv420p", "-movflags", "+faststart",
                    "-map", "0:v:0", "-map", "0:a:0?", "-dn", "-sn",
                    "-write_tmcd", "0"] + atail  # drop Resolve's timecode data track
    return base + ".mp4", tail, info["duration_us"]


def resolve_target(inp, default_out, out_file, out_dir):
    """Apply -o override and never overwrite the input itself."""
    if out_file:
        # honour the user's path/name but force the container the profile needs
        want_ext = os.path.splitext(default_out)[1]      # ".mov" or audio ext
        out = os.path.splitext(out_file)[0] + want_ext
    elif out_dir:
        out = os.path.join(out_dir, os.path.basename(default_out))
    else:
        out = default_out
    if os.path.abspath(out) == os.path.abspath(inp):
        b, e = os.path.splitext(out)
        out = b + "_dr" + e          # e.g. clip.mp4 -> clip_dr.mp4 (avoid clobber)
    return out


def convert(inp, out, tail, dur_us, hw, on_pct):
    """Encode to a temp file then atomically move onto `out`. Returns True/ok."""
    tmp = out + ".mdvtmp." + out.rsplit(".", 1)[-1]

    def run(use_hw):
        cmd = ["ffmpeg", "-y", "-v", "error"]
        if on_pct and dur_us > 0:
            cmd += ["-progress", "pipe:1", "-nostats"]
        if use_hw:
            cmd += ["-hwaccel", use_hw]
        cmd += ["-i", inp] + tail + [tmp]
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True)
        if on_pct and dur_us > 0:
            for line in proc.stdout:
                if line.startswith("out_time_us="):
                    try:
                        us = int(line.strip().split("=", 1)[1])
                        on_pct(min(100, us * 100 // dur_us))
                    except ValueError:
                        pass
        err = proc.communicate()[1]
        return proc.returncode, err

    rc, err = run(hw)
    if rc != 0 and hw:
        rc, err = run(None)
    if rc != 0:
        try:
            os.remove(tmp)
        except OSError:
            pass
        sys.stderr.write(err or "")
        return False
    os.replace(tmp, out)
    return True


def gather_inputs(paths):
    """-> (files, problems).  A path that does not exist is reported, never
    skipped: a typo like `manodavinci deliverr clip.mp4` must not silently
    look like a normal run."""
    files, problems = [], []
    for p in paths:
        if os.path.isdir(p):
            try:
                names = sorted(os.listdir(p))
            except OSError as e:
                problems.append("cannot read folder: %s (%s)" % (p, e.strerror))
                continue
            found = [os.path.join(p, n) for n in names
                     if os.path.isfile(os.path.join(p, n))
                     and n.rsplit(".", 1)[-1].lower() in MEDIA_EXTS]
            if found:
                files.extend(found)
            else:
                problems.append("no video/audio files in folder: %s" % p)
        elif os.path.isfile(p):
            files.append(p)
        else:
            problems.append("not found: %s" % p)
    return files, problems


# ================================================================ GUI dialogs ==
class Dialogs:
    """kdialog / zenity / terminal abstraction. Plain text only (no markup)."""
    def __init__(self):
        gui = bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))
        if gui and have("kdialog") and have("qdbus6"):
            self.kind = "kdialog"
        elif gui and have("zenity"):
            self.kind = "zenity"
        else:
            self.kind = "term"

    def notice(self, text):
        if self.kind == "kdialog":
            subprocess.call(["kdialog", "--title", "manodavinci", "--msgbox", text])
        elif self.kind == "zenity":
            subprocess.call(["zenity", "--info", "--no-markup", "--width=460",
                             "--title", "manodavinci", "--text", text])
        else:
            print(text)

    def error(self, text):
        if self.kind == "kdialog":
            subprocess.call(["kdialog", "--title", "manodavinci", "--error", text])
        elif self.kind == "zenity":
            subprocess.call(["zenity", "--error", "--no-markup", "--width=460",
                             "--title", "manodavinci", "--text", text])
        else:
            sys.stderr.write(text + "\n")

    def confirm(self, text):
        if self.kind == "kdialog":
            return subprocess.call(["kdialog", "--title", "manodavinci",
                                    "--yesno", text]) == 0
        if self.kind == "zenity":
            return subprocess.call(["zenity", "--question", "--no-markup",
                                    "--width=460", "--title", "manodavinci",
                                    "--text", text]) == 0
        try:
            return input(text + " [y/N] ").strip().lower().startswith("y")
        except EOFError:
            return False

    # progress ---------------------------------------------------------------
    def progress_start(self, label):
        self._p = None
        if self.kind == "kdialog":
            ref = subprocess.check_output(
                ["kdialog", "--title", "manodavinci", "--progressbar", label, "100"]
            ).decode().split()
            self._svc, self._path = ref[0], ref[1]
        elif self.kind == "zenity":
            self._p = subprocess.Popen(
                ["zenity", "--progress", "--title", "manodavinci", "--auto-close",
                 "--no-cancel", "--width=460", "--percentage=0"],
                stdin=subprocess.PIPE, text=True)

    def progress_update(self, pct, label):
        if self.kind == "kdialog":
            subprocess.call(["qdbus6", self._svc, self._path, "setLabelText", label],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.call(["qdbus6", self._svc, self._path,
                             "org.freedesktop.DBus.Properties.Set",
                             "org.kde.kdialog.ProgressDialog", "value", str(pct)],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif self.kind == "zenity" and self._p:
            try:
                self._p.stdin.write("# %s\n%d\n" % (label, pct))
                self._p.stdin.flush()
            except (BrokenPipeError, ValueError):
                pass
        else:
            sys.stdout.write("\r\033[K%3d%%  %s" % (pct, label))  # \033[K clears to EOL
            sys.stdout.flush()

    def progress_close(self):
        if self.kind == "kdialog":
            subprocess.call(["qdbus6", self._svc, self._path, "close"],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif self.kind == "zenity" and self._p:
            try:
                self._p.stdin.close()
            except Exception:
                pass
            self._p.wait()
        else:
            sys.stdout.write("\n")


# ================================================================ batch runner ==
def _run_plans(plans, force, dlg):
    """Given [(inp, out, tail, dur)], confirm overwrites then encode with progress."""
    existing = [o for (_, o, _, _) in plans if os.path.exists(o)]
    if existing and not force:
        msg = ("%d output file(s) already exist and will be overwritten:\n\n%s\n\n"
               "Continue?" % (len(existing),
                              "\n".join("  " + os.path.basename(e) for e in existing[:8])))
        if not dlg.confirm(msg):
            return 0, 0, None

    total = len(plans)
    dlg.progress_start("Preparing %d file(s)..." % total)
    ok = fail = 0
    last_out_dir = None
    written = []
    for i, (inp, out, tail, dur) in enumerate(plans):
        label = "(%d/%d) %s" % (i + 1, total, os.path.basename(inp))

        def on_pct(p, _i=i, _l=label):
            dlg.progress_update((_i * 100 + p) // total, _l)

        dlg.progress_update(i * 100 // total, label)
        d = os.path.dirname(out)
        if d and not os.path.isdir(d):
            try:                          # created only once we really encode,
                os.makedirs(d)            # so a cancelled run leaves no folder
            except OSError as e:
                sys.stderr.write("cannot create %s: %s\n" % (d, e))
                fail += 1
                continue
        if convert(inp, out, tail, dur, HW_METHOD, on_pct):
            ok += 1
            last_out_dir = os.path.dirname(out) or "."
            written.append(os.path.abspath(out))
        else:
            fail += 1
    dlg.progress_update(100, "Done")
    dlg.progress_close()
    if written and dlg.kind == "term":
        print_written(written)
    return ok, fail, last_out_dir


def print_written(written):
    """Say where the new file(s) landed - the terminal otherwise only shows a
    count, leaving the user hunting for what was just made."""
    c = palette()
    if len(written) == 1:
        print("Saved: {G}%s{Z}".format(**c) % written[0])
        return
    dirs = set(os.path.dirname(w) for w in written)
    if len(dirs) == 1:
        print("Saved {G}%d files{Z} in {G}%s{Z}:".format(**c)
              % (len(written), dirs.pop()))
        for w in written[:8]:
            print("  %s" % os.path.basename(w))
        if len(written) > 8:
            print("  ... and %d more" % (len(written) - 8))
    else:
        print("{G}Saved:{Z}".format(**c))
        for w in written:
            print("  %s" % w)


def run_batch(inputs, profile, audio, force, dlg, out_file=None, out_dir=None,
              subdir=None):
    """subdir: put each output in that folder next to its own input (Resolve flow)."""
    plans = []
    for inp in inputs:
        default_out, tail, dur = default_output(inp, profile, audio)
        d = out_dir
        if subdir and not out_file and not out_dir:
            d = os.path.join(os.path.dirname(os.path.abspath(inp)), subdir)
        out = resolve_target(inp, default_out, out_file, d)
        plans.append((inp, out, tail, dur))
    return _run_plans(plans, force, dlg)


def run_deliver(inputs, crf, codec, force, dlg, out_file=None, out_dir=None):
    plans = []
    for inp in inputs:
        default_out, tail, dur = deliver_output(inp, crf, codec)
        out = resolve_target(inp, default_out, out_file, out_dir)
        plans.append((inp, out, tail, dur))
    return _run_plans(plans, force, dlg)


# ===================================================== DaVinci Resolve support ==
def get_resolve():
    g = globals()
    if g.get("resolve") is not None:
        return g["resolve"]
    if "bmd" in g:
        try:
            r = g["bmd"].scriptapp("Resolve")
            if r:
                return r
        except Exception:
            pass
    try:
        import DaVinciResolveScript as dvr
        return dvr.scriptapp("Resolve")
    except Exception:
        return None


def resolve_flow(resolve):
    dlg = Dialogs()
    if ffmpeg_missing():
        dlg.error(FFMPEG_MSG)
        return
    where = ("Click on the video clip you want to convert in the MEDIA POOL. \n"
             "This is the panel at the BOTTOM of the \"Media\" page,\n"
             " or the top-left of the \"Cut\" and \"Edit\" pages.\n\n"
             "If you are starting a new project now and are still confused:\n"
             "1. Press SHIFT + 1 to go to the \"Media\" page.\n"
             "2. Then drag the 'broken' clips (the ones with incompatible codec)\n"
             "into the MEDIA POOL (the BOTTOM part of the screen).\n"
             "3. In the MEDIA POOL, select all the clips you want, and then\n"
             "press your shortcut again to convert it.\n\n"
             "Run \"manodavinci --help\" in a terminal: the GETTING STARTED\n"
             "section at the end has important advice for beginners.")
    try:
        proj = resolve.GetProjectManager().GetCurrentProject()
        mp = proj.GetMediaPool()
        clips = mp.GetSelectedClips() or []
    except Exception as exc:
        dlg.error("Could not read the Media Pool:\n%s" % exc)
        return

    paths = []
    for c in clips:
        try:
            p = c.GetClipProperty("File Path")
        except Exception:
            p = None
        if p and os.path.isfile(p):
            paths.append(p)

    if not clips:
        dlg.notice("No clip selected.\n\n" + where)
        return
    if not paths:
        dlg.notice("The selected item has no source video file\n"
                   "(it may be a timeline or compound clip).\n\n" + where)
        return

    # figure out whether we converted video clips, audio files, or a mix,
    # so the message names the right thing.
    kinds = set()
    for p in paths:
        info = probe(p)
        kinds.add("video" if info["has_video"] else "audio")
    if kinds == {"audio"}:
        noun = "audio file(s)"
    elif kinds == {"video"}:
        noun = "clip(s)"
    else:
        noun = "file(s)"

    ok, fail, out_dir = run_batch(paths, DEFAULT_PROFILE, "pcm16", force=False,
                                  dlg=dlg, subdir=RESOLVE_SUBDIR)
    if ok and out_dir:
        if have("xdg-open"):
            subprocess.Popen(["xdg-open", out_dir],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        dlg.notice(
            "Converted %d %s into the folder \"%s\", which just opened\n"
            "(it sits next to your original files).\n\n"
            "To use: drag it into the Media Pool.\n"
            "Now you can remove the original \"broken\" %s from your\n"
            "project's Media Pool.%s"
            % (ok, noun, RESOLVE_SUBDIR, noun,
               "" if not fail else "\n\n%d failed." % fail))
    elif fail:
        dlg.error("Conversion failed for %d file(s)." % fail)


# ============================================================== install / CLI ==
def do_install():
    src = os.path.realpath(__file__)
    try:
        os.makedirs(RESOLVE_UTILITY, exist_ok=True)
    except OSError as e:
        die("cannot create %s: %s" % (RESOLVE_UTILITY, e))
    dst = os.path.join(RESOLVE_UTILITY, INSTALL_NAME)
    existed = os.path.exists(dst)
    import shutil
    shutil.copyfile(src, dst)
    os.chmod(dst, 0o755)
    c = palette()
    print("{D}Copied:\n  %s\n->\n  %s{Z}\n".format(**c) % (src, dst))
    print("{G}%s successfully.{Z}\n".format(**c)
          % ("Upgraded" if existed else "Installed"))
    print(paint("""{H}Now, configure a keyboard shortcut to use it:{Z}
  1. Restart DaVinci Resolve for it to detect the new script
  2. Press {Y}Ctrl+Alt+K{Z}, or alternatively open
     DaVinci Resolve > Keyboard Customization
  3. In the small search box, type:  {Y}mano{Z}
  4. Inside '>  Scripts', click on the keystroke field of '{Y}manodavinci{Z}',
     then press your keys combination (my suggestion: {Y}Ctrl+Alt+E{Z})
  5. Save it. If asked to create a new preset, do it.
  6. Select a clip and press your shortcut.
  7. Enjoy!"""))


def do_uninstall():
    dst = os.path.join(RESOLVE_UTILITY, INSTALL_NAME)
    if os.path.exists(dst):
        os.remove(dst)
        print("Removed:\n  %s" % dst)
    else:
        print("Nothing to remove (not installed at %s)." % dst)


def gui_pick_files(dlg):
    """Pop a file-chooser for --gui mode; return a list of paths (may be empty)."""
    if dlg.kind == "kdialog":
        cmd = ["kdialog", "--getopenfilename", os.path.expanduser("~"),
               "Videos (*.mp4 *.mov *.mkv *.m4v *.avi *.mts *.m2ts *.webm)",
               "--multiple", "--separate-output"]
    elif dlg.kind == "zenity":
        cmd = ["zenity", "--file-selection", "--multiple", "--separator=\n"]
    else:
        return []
    try:
        sel = subprocess.check_output(cmd).decode().splitlines()
    except subprocess.CalledProcessError:
        return []
    return [s for s in sel if s]


def split_output(output, inputs):
    """Interpret -o as a single output file or an output directory."""
    out_file = out_dir = None
    if output:
        if len(inputs) > 1 or os.path.isdir(output) or output.endswith(os.sep):
            out_dir = output
            os.makedirs(out_dir, exist_ok=True)
        else:
            out_file = output
    return out_file, out_dir


def cli(argv):
    profile, audio, hwpref, force, use_gui, output = \
        DEFAULT_PROFILE, "pcm16", "auto", False, False, None
    rest = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-p", "--profile"):
            profile = argv[i + 1]; i += 2
        elif a in ("-a", "--audio"):
            audio = argv[i + 1]; i += 2
        elif a in ("-o", "--output"):
            output = argv[i + 1]; i += 2
        elif a == "--hwaccel":
            hwpref = argv[i + 1]; i += 2
        elif a in ("-f", "--force"):
            force = True; i += 1
        elif a == "--gui":
            use_gui = True; i += 1
        elif a.startswith("-"):
            die("unknown option: %s (try --help)" % a)
        else:
            rest.append(a); i += 1

    if profile not in PROFILES:
        die("unknown profile '%s' (see --list)" % profile)
    if audio not in AUDIO:
        die("unknown audio '%s' (see --list)" % audio)

    dlg = Dialogs()
    if ffmpeg_missing():
        if use_gui:
            dlg.error(FFMPEG_MSG)
        else:
            sys.stderr.write(FFMPEG_MSG + "\n")
        return

    global HW_METHOD
    HW_METHOD, alert = gpu_method(hwpref)
    if alert:
        sys.stderr.write("GPU: %s\n" % alert)

    if use_gui and not rest:
        rest = gui_pick_files(dlg)

    if not rest:
        print(paint(SHORT)); return

    inputs, problems = gather_inputs(rest)
    if problems:
        msg = "\n".join(problems) + "\nNothing was converted."
        dlg.error(msg) if use_gui else die(msg)
        return

    out_file, out_dir = split_output(output, inputs)

    if use_gui:
        ok, fail, _ = run_batch(inputs, profile, audio, force, dlg, out_file, out_dir)
        dlg.notice("Converted %d of %d file(s).%s\n\nImport the new file(s) into "
                   "DaVinci Resolve." % (ok, len(inputs),
                                         "" if not fail else "  Failed: %d." % fail))
    else:
        term = Dialogs(); term.kind = "term"
        ok, fail, _ = run_batch(inputs, profile, audio, force, term, out_file, out_dir)
        c = palette()
        print("%sDone. converted=%d failed=%d%s"
              % (c["G"] if not fail else c["Y"], ok, fail, c["Z"]))


def deliver_cli(argv):
    """`deliver`: any video -> small universal MP4 (H.264/AAC) for upload sites."""
    crf, codec, hwpref, force, use_gui, output = None, "h264", "auto", False, False, None
    rest = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--crf":
            crf = int(argv[i + 1]); i += 2
        elif a == "--av1":
            codec = "av1"; i += 1
        elif a == "--hevc":
            codec = "hevc"; i += 1
        elif a in ("-o", "--output"):
            output = argv[i + 1]; i += 2
        elif a == "--hwaccel":
            hwpref = argv[i + 1]; i += 2
        elif a in ("-f", "--force"):
            force = True; i += 1
        elif a == "--gui":
            use_gui = True; i += 1
        elif a.startswith("-"):
            die("unknown option: %s (try --help)" % a)
        else:
            rest.append(a); i += 1

    dlg = Dialogs()
    if not use_gui:
        dlg.kind = "term"

    if ffmpeg_missing():
        dlg.error(FFMPEG_MSG) if use_gui else sys.stderr.write(FFMPEG_MSG + "\n")
        return

    encoder = DELIVER_ENCODER[codec]
    if not has_encoder(encoder):
        msg = ("this ffmpeg build has no %s encoder.\n"
               "Install a full ffmpeg (Arch: sudo pacman -S ffmpeg; "
               "Debian/Ubuntu: sudo apt install ffmpeg)." % encoder)
        dlg.error(msg) if use_gui else die(msg)
        return

    global HW_METHOD
    HW_METHOD, alert = gpu_method(hwpref)
    if alert:
        sys.stderr.write("GPU: %s\n" % alert)

    if use_gui and not rest:
        rest = gui_pick_files(dlg)
    if not rest:
        print(paint(SHORT)); return

    inputs, problems = gather_inputs(rest)
    if problems:
        msg = "\n".join(problems) + "\nNothing was delivered."
        dlg.error(msg) if use_gui else die(msg)
        return

    out_file, out_dir = split_output(output, inputs)
    ok, fail, out_dir_done = run_deliver(inputs, crf, codec, force, dlg,
                                         out_file, out_dir)
    what = DELIVER_LABEL[codec] + " mp4"
    if use_gui:
        dlg.notice("Delivered %d of %d file(s) as %s.%s"
                   % (ok, len(inputs), what,
                      "" if not fail else "  Failed: %d." % fail))
    else:
        c = palette()
        print("%sDone. delivered=%d failed=%d (%s)%s"
              % (c["G"] if not fail else c["Y"], ok, fail, what, c["Z"]))


HW_METHOD = None


def open_help_in_terminal():
    """Double-clicked in a file manager (no terminal)? Pop an interactive shell
    that shows the intro, then stays open so the user can run e.g. `manodavinci
    install` next (a `manodavinci` command is defined for the session)."""
    py = shlex.quote(sys.executable)
    script = shlex.quote(os.path.realpath(__file__))
    d = shlex.quote(os.path.dirname(os.path.realpath(__file__)))
    # define `manodavinci`, print the intro, then drop into a normal interactive
    # bash.  NO_SPAWN stops that intro from opening yet another terminal.
    inner = ('cd %s; manodavinci() { %s %s "$@"; }; export -f manodavinci; '
             'export MANODAVINCI_NO_SPAWN=1; manodavinci; echo; exec bash'
             % (d, py, script))
    launchers = [
        ["konsole", "-e", "bash", "-c", inner],
        ["gnome-terminal", "--", "bash", "-c", inner],
        ["xfce4-terminal", "-e", "bash -c " + shlex.quote(inner)],
        ["kitty", "bash", "-c", inner],
        ["alacritty", "-e", "bash", "-c", inner],
        ["xterm", "-e", "bash", "-c", inner],
        ["x-terminal-emulator", "-e", "bash", "-c", inner],
    ]
    for cmd in launchers:
        if have(cmd[0]):
            try:
                subprocess.Popen(cmd)
                return True
            except Exception:
                continue
    return False


def main():
    argv = sys.argv[1:]
    if not argv:
        r = get_resolve()
        if r is not None:
            resolve_flow(r)
            return
        # launched from a file manager (GUI session, no terminal attached)?
        gui = os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")
        if (gui and not sys.stdout.isatty()
                and not os.environ.get("MANODAVINCI_NO_SPAWN")):
            if open_help_in_terminal():
                return
            Dialogs().notice(paint(SHORT, color=False))    # fallback if no terminal emulator found
            return
        print(paint(SHORT))
        return

    cmd = argv[0]
    if cmd == "install":
        do_install(); return
    if cmd == "uninstall":
        do_uninstall(); return
    if cmd == "deliver":
        deliver_cli(argv[1:]); return
    if cmd in ("-h", "--help", "help"):
        print(paint(HELP)); return
    if cmd in ("-l", "--list", "list"):
        print(paint(LIST)); return
    if cmd in ("-V", "--version", "version"):
        print("manodavinci %s" % VERSION); return

    # a misspelled command would otherwise be read as a file name; the missing
    # file is caught later, but naming the command the user meant is friendlier.
    if not cmd.startswith("-") and not os.path.exists(cmd):
        near = difflib.get_close_matches(
            cmd.lower(), ("deliver", "install", "uninstall", "list", "help"), 1, 0.6)
        if near:
            die("unknown command '%s' - did you mean '%s'?" % (cmd, near[0]))

    cli(argv)


if __name__ == "__main__":
    main()
