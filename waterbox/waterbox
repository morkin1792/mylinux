# --- Bootstrap image verification (req 6) -------------------------------------
verify_tarball() {
    local tarball="$1" sig="$2"
    log_info "Verifying the Arch bootstrap image signature..."

    # Preferred on Arch hosts: the official, self-maintaining pacman keyring.
    if command -v pacman-key >/dev/null 2>&1 \
       && sudo pacman-key -v "$sig" >/dev/null 2>&1; then
        log_success "Signature verified via pacman-key (official keyring)."
        return 0
    fi

    # Portable path (e.g. Linux Mint): gpg against the pinned signing key.
    command -v gpg >/dev/null 2>&1 \
        || log_error "Need 'gpg' (or pacman-key) to verify the image. Install gnupg."
    local gdir ks ok=1
    gdir="$(mktemp -d)"
    for ks in hkps://keyserver.ubuntu.com hkps://keys.openpgp.org; do
        if gpg --homedir "$gdir" --batch --keyserver "$ks" \
               --recv-keys "$ARCH_BOOTSTRAP_KEY" >/dev/null 2>&1; then
            ok=0; break
        fi
    done
    [ "$ok" -eq 0 ] \
        || { rm -rf "$gdir"; log_error "Could not fetch Arch signing key $ARCH_BOOTSTRAP_KEY from any keyserver."; }

    if gpg --homedir "$gdir" --status-fd 1 --verify "$sig" "$tarball" 2>/dev/null \
         | grep -q "VALIDSIG $ARCH_BOOTSTRAP_KEY"; then
        log_success "Signature verified via gpg (pinned key $ARCH_BOOTSTRAP_KEY)."
        rm -rf "$gdir"; return 0
    fi
    rm -rf "$gdir"
    log_error "Bootstrap image FAILED signature verification. Aborting."
}

# Nameserver lines for the container's /etc/resolv.conf, derived from the HOST's DNS
# so the box resolves names the same way the host does (incl. split-DNS / internal
# domains). Key case: a host-local resolver on 127.0.0.1:53 is unreachable as-is from
# inside (loopback is the container's own), so it's remapped to HOST_IP — which the
# container->host DNAT forwards to the host's 127.0.0.1:53. Other loopback stubs (e.g.
# systemd-resolved's 127.0.0.53) are skipped in favour of its real upstreams in
# /run/systemd/resolve/resolv.conf. Public DNS_SERVERS are appended as a fallback so
# there's always something that works. Deduped, order preserved.
#
# The remapped HOST_IP resolver is reachable even when the host binds DNS to 127.0.0.1
# only (not 0.0.0.0): the DNAT to 127.0.0.1 + route_localnet (both set by net_up) hand
# the query to the loopback-bound listener. If that resolver has a source ACL and drops
# or refuses the container's query, glibc moves to the next nameserver — so the public
# fallback still answers. 'options timeout:2 attempts:2' keeps that fall-through quick
# (≈2s) instead of the default 5s-per-query stall.
_container_nameservers() {
    local kw val seen=" " src
    for src in /etc/resolv.conf /run/systemd/resolve/resolv.conf; do
        [ -r "$src" ] || continue
        while read -r kw val _; do
            [ "$kw" = nameserver ] || continue
            case "$val" in
                127.0.0.1)    val="$HOST_IP" ;;   # host-local resolver: reach via DNAT
                127.*|::1|::) continue ;;         # other loopback stubs: unreachable
            esac
            case "$seen" in *" $val "*) continue ;; esac
            seen="$seen$val "; echo "nameserver $val"
        done < "$src"
    done
    for val in "${DNS_SERVERS[@]}"; do
        case "$seen" in *" $val "*) continue ;; esac
        seen="$seen$val "; echo "nameserver $val"
    done
    echo "options timeout:2 attempts:2"   # fall through to the fallback quickly
}

# Probe --restrict-address-families rather than inferring it from a version number:
# distro backports can expose a mixed feature set. Used by both this host function
# and the root helper's boots.
_NSPAWN_RAF=""   # "" until probed, then "yes"/"no"
_nspawn_supports_raf() {
    [ -n "$_NSPAWN_RAF" ] || \
        { systemd-nspawn --help 2>/dev/null | grep -q -- '--restrict-address-families' \
            && _NSPAWN_RAF=yes || _NSPAWN_RAF=no; }
    [ "$_NSPAWN_RAF" = yes ]
}

# Every build-time nspawn run gets the same explicit socket-address-family allowlist
# the booted box uses (see boot_min/boot_full). systemd-nspawn will soon default to
# permitting only AF_INET/AF_INET6/AF_UNIX and warns until you set this; that default
# would break more than the runtime box — even here, glibc getaddrinfo() opens an
# AF_NETLINK route socket (AI_ADDRCONFIG) to pick a source address, so pacman/git
# downloads need it. AF_PACKET matches the box's CAP_NET_RAW.
_nspawn_build() {
    local raf=() userns=(--private-users=pick --private-users-ownership=map)
    _nspawn_supports_raf && raf=(--restrict-address-families="AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET")
    [ "$WATERBOX_UNSAFE_HOST_ROOT" = 1 ] && userns=(--private-users=no)
    # Package hooks and AUR builds are code too. Keep them in the same private-user
    # boundary as a normal boot so a compromised mirror/package cannot run as host
    # root during bootstrap. The hidden Mint-live escape hatch deliberately restores
    # v1.8's host-root behavior only after the real ID-map probe has failed.
    sudo systemd-nspawn -q "${raf[@]}" \
        "${userns[@]}" \
        -D "$JAIL_ROOT" "$@"
}

# `--private-users-ownership=map` can be understood by nspawn while still failing
# on the actual directory: support also depends on the running kernel and the
# filesystem backing the rootfs. Probe the extracted tree before the first real
# command so Debian-family live media (commonly overlayfs) gets an actionable error
# instead of dying cryptically halfway through pacman-key initialization.
_require_rootfs_idmap() {
    local fs detail short_detail
    if detail=$(sudo systemd-nspawn -q \
            --private-users=pick --private-users-ownership=map \
            -D "$JAIL_ROOT" /usr/bin/true 2>&1); then
        [ "$WATERBOX_UNSAFE_HOST_ROOT" != 1 ] \
            || log_error "--unsafe-host-root was refused because this rootfs supports secure ID mapping. Start Waterbox normally."
        return 0
    fi
    fs=$(findmnt -T "$JAIL_ROOT" -n -o FSTYPE 2>/dev/null || true)
    [ -n "$fs" ] || fs="unknown filesystem"
    if ! printf '%s\n' "$detail" | grep -qiE 'ID.?mapped mounts?.*(not available|not supported)'; then
        short_detail=$(printf '%s\n' "$detail" | tail -n 2 | tr '\n' ' ')
        log_error "The secure rootfs probe failed for a reason other than unavailable ID-mapped mounts, so --unsafe-host-root cannot override it. nspawn: ${short_detail:-no error detail}"
    fi
    if [ "$WATERBOX_UNSAFE_HOST_ROOT" = 1 ]; then
        log_warn "ID mapping is unavailable on $fs; accepting the explicit --unsafe-host-root request."
        return 0
    fi
    echo
    log_warn "Secure ID mapping is unavailable on '$fs' (common on Linux Mint Live)."
    echo "Normal fix: use installed Mint, or place ~/.waterbox on ext4, btrfs, or XFS."
    echo
    echo -e "\e[1;31mUnsafe v1.8-compatible fallback:\e[0m"
    echo -e "  Run: \e[1mwaterbox --unsafe-host-root\e[0m"
    echo "  Warning: container root will be real host root."
    echo
    log_error "Waterbox did not start."
}

# Write waterbox's /etc/hosts entries idempotently (safe to re-run on refresh): the
# box answers to its own name on 127.0.0.1, and the host machine is reachable from
# inside BOTH as 'host' and by its real hostname — both via the veth IP. Any prior
# waterbox lines are stripped first; everything else (localhost, VPN-added entries, …)
# is preserved. The host hostname is dropped when empty, not a plain hostname, or a
# clash with our own names (the box name or the 'host' alias).
configure_hosts() {
    local hosts="$JAIL_ROOT/etc/hosts" host_hn ip_re tmp
    host_hn=$(cat /proc/sys/kernel/hostname 2>/dev/null || true)
    case "$host_hn" in
        ''|localhost|"$HOST_ALIAS"|"$INSIDE_HOSTNAME"|*[!A-Za-z0-9.-]*) host_hn="" ;;
    esac
    ip_re="${HOST_IP//./\\.}"
    tmp=$(mktemp)
    [ -f "$hosts" ] && grep -vE "^(127\.0\.0\.1[[:space:]]+${INSIDE_HOSTNAME}[[:space:]]*\$|${ip_re}[[:space:]])" "$hosts" > "$tmp" 2>/dev/null || true
    {
        cat "$tmp"
        printf '127.0.0.1    %s\n' "$INSIDE_HOSTNAME"
        printf '%s    %s%s\n' "$HOST_IP" "$HOST_ALIAS" "${host_hn:+ $host_hn}"
    } | wb_tee "$hosts"
    rm -f "$tmp"
}

# --- Bootstrap (runs once) ----------------------------------------------------
bootstrap_sandbox() {
    # A sentinel written only at the very end marks a *complete* build. Testing
    # for it (not just $JAIL_ROOT/usr) means a bootstrap that dies mid-way — e.g.
    # a network hiccup during the pacman/yay steps — is retried cleanly instead
    # of leaving a half-configured rootfs that the next run mistakes for ready.
    if [ -f "$JAIL_ROOT/.waterbox-ready" ]; then
        # Also gates an existing v1.8/unsafe tree. Cold starts are cheap enough to
        # test the real filesystem capability; an explicitly unsafe request is
        # accepted only when this exact probe fails.
        is_running || _require_rootfs_idmap
        return 0
    fi
    # Never replace a rootfs that a live container is still using. A damaged or
    # removed sentinel must not turn an ordinary `start` into an unannounced wipe.
    if is_running; then
        log_error "The sandbox is running but its readiness marker is missing. Refusing to rebuild a live rootfs; stop it and run 'waterbox reset'."
    fi
    # Check before downloading or replacing anything. start/reset normally preflight
    # this already; keeping the guard here makes the destructive function safe when
    # called from a future code path too.
    _require_secure_nspawn

    log_info "Bootstrapping Arch rootfs at $JAIL_ROOT (this takes a few minutes)..."
    # WB_TMP is script-scope (not local) so the EXIT trap can remove it even when
    # set -e aborts mid-bootstrap — the ~200 MB tarball must not leak on failure.
    WB_TMP="$(mktemp -d)"
    trap 'rm -rf "$WB_TMP"' EXIT

    log_info "Downloading $ARCH_BOOTSTRAP_TARBALL ..."
    curl -fSL --progress-bar "$ARCH_MIRROR/$ARCH_BOOTSTRAP_TARBALL" -o "$WB_TMP/img.tar.zst"
    # Signature from the canonical origin (not the mirror), verified vs pinned key.
    curl -fsSL "$ARCH_SIG_ORIGIN/$ARCH_BOOTSTRAP_TARBALL.sig" -o "$WB_TMP/img.tar.zst.sig"

    verify_tarball "$WB_TMP/img.tar.zst" "$WB_TMP/img.tar.zst.sig"

    log_info "Extracting rootfs (needs root to preserve ownership/devices)..."
    sudo mkdir -p "$(dirname "$JAIL_ROOT")"
    sudo tar --zstd -xpf "$WB_TMP/img.tar.zst" -C "$WB_TMP"   # unpacks to $WB_TMP/root.x86_64
    sudo rm -rf "$JAIL_ROOT"
    sudo mv "$WB_TMP/root.x86_64" "$JAIL_ROOT"
    rm -rf "$WB_TMP"

    _require_rootfs_idmap

    log_info "Configuring locale, user, networking..."

    # The bootstrap ships a commented mirrorlist; point it at the geo mirror.
    echo 'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch' \
        | wb_tee "$JAIL_ROOT/etc/pacman.d/mirrorlist"
    # CheckSpace mis-reports on overlay/df; disable while we install.
    sudo sed -i 's/^CheckSpace/#CheckSpace/' "$JAIL_ROOT/etc/pacman.conf"

    log_info "Initializing pacman keyring inside the rootfs..."
    _nspawn_build bash -c \
        'pacman-key --init && pacman-key --populate archlinux'

    log_info "Installing base packages inside the rootfs..."
    # pacman 7's download sandbox needs a WORKING kernel Landlock; live-ISO / VM /
    # older kernels (e.g. Linux Mint on VirtualBox) don't have one, so the sync aborts
    # with "Landlock is not supported by the kernel". Detecting that from outside is
    # unreliable (the LSM can be listed yet non-functional), so just try once and, on
    # failure, disable pacman's sandbox in the rootfs and retry. It then stays disabled
    # so the files DB, yay, and in-box pacman all keep working on that same kernel;
    # Landlock-capable hosts never hit this and keep the sandbox.
    if ! _nspawn_build \
            pacman -Syu --noconfirm --needed "${PKGS[@]}"; then
        log_warn "pacman couldn't use its download sandbox (kernel Landlock unavailable) — disabling it and retrying."
        sudo sed -i '/^\[options\]/a DisableSandbox' "$JAIL_ROOT/etc/pacman.conf"
        _nspawn_build \
            pacman -Syu --noconfirm --needed "${PKGS[@]}"
    fi

    # Download the files database too, so `pacman -F` / `pkgfile` work and there's no
    # "database file for 'core' does not exist (use '-Fy')" warning later.
    log_info "Syncing the pacman files database (pacman -Fy)..."
    _nspawn_build pacman -Fy --noconfirm || true

    echo "$INSIDE_HOSTNAME" | wb_tee "$JAIL_ROOT/etc/hostname"

    # resolv.conf derived from the host's DNS (see _container_nameservers) — nspawn
    # won't touch it (--resolv-conf=off), systemd-resolved is masked below so it can't
    # reclaim it, and a VPN client inside is free to overwrite it.
    sudo rm -f "$JAIL_ROOT/etc/resolv.conf"
    _container_nameservers | wb_tee "$JAIL_ROOT/etc/resolv.conf"

    # /etc/hosts: box on loopback + the host reachable as 'host' and by its real
    # hostname (idempotent, so 'refresh-config' can re-apply it without a rebuild).
    configure_hosts

    # Locale
    echo "en_US.UTF-8 UTF-8" | wb_tee "$JAIL_ROOT/etc/locale.gen"
    _nspawn_build locale-gen
    echo "LANG=en_US.UTF-8" | wb_tee "$JAIL_ROOT/etc/locale.conf"

    # User uid 1000 is owner-mapped to the invoking host user on explicit shares;
    # container root remains mapped to an unrelated high host uid.
    _nspawn_build \
        useradd -m -s /usr/bin/zsh -u 1000 "$USER_NAME" 2>/dev/null || true
    echo "$USER_NAME ALL=(ALL) NOPASSWD: ALL" \
        | wb_tee "$JAIL_ROOT/etc/sudoers.d/10-$USER_NAME"
    sudo chmod 0440 "$JAIL_ROOT/etc/sudoers.d/10-$USER_NAME"

    # GPU access for the user (best-effort: groups may not match host gids, in
    # which case GUI apps fall back to software rendering — fine for occasional use).
    _nspawn_build bash -c '
        getent group render >/dev/null || groupadd -r render
        getent group video  >/dev/null || groupadd -r video
        usermod -aG video,render '"$USER_NAME"'' 2>/dev/null || true

    sudo mkdir -p "$JAIL_ROOT$CONTAINER_WORKSPACE"
    sudo chown -R 1000:1000 "$JAIL_ROOT$CONTAINER_WORKSPACE"

    # Static network config for host0 (container side of the veth pair).
    sudo mkdir -p "$JAIL_ROOT/etc/systemd/network"
    {
        echo "[Match]"
        echo "Name=host0"
        echo ""
        echo "[Network]"
        echo "Address=$CONTAINER_IP/$NET_CIDR"
        echo "Gateway=$HOST_IP"
        for dns in "${DNS_SERVERS[@]}"; do echo "DNS=$dns"; done
    } | wb_tee "$JAIL_ROOT/etc/systemd/network/80-container-host0.network"

    # Enable the container's network/login stack; mask resolved (so it can't
    # hijack /etc/resolv.conf → 127.0.0.53 stub) and tmp.mount (so it doesn't
    # tmpfs-shadow /tmp, which would hide the GUI X11 socket under /tmp/.X11-unix).
    # Separate calls so one failing doesn't skip the others; also disable resolved
    # outright. (start still re-asserts a working resolv.conf via 'ensure-dns'.)
    _nspawn_build \
        systemctl enable systemd-networkd dbus systemd-logind >/dev/null 2>&1 || true
    _nspawn_build systemctl disable systemd-resolved >/dev/null 2>&1 || true
    _nspawn_build systemctl mask systemd-resolved >/dev/null 2>&1 || true
    _nspawn_build systemctl mask tmp.mount >/dev/null 2>&1 || true

    # AUR + extras (yay, claude-code, oh-my-posh). No veth here => host network.
    # Run the build as $USER_NAME (makepkg refuses root). Use the short -u: its long
    # form was renamed --user= → --uid= in systemd 261, but -u has meant "run as this
    # user" since forever, so it works on both Arch (261) and the systemd 255 on Mint.
    log_info "Installing yay + claude-code + extras inside the rootfs..."
    _nspawn_build -u "$USER_NAME" bash -c "
        cd /tmp &&
        git clone https://aur.archlinux.org/yay.git &&
        cd yay &&
        makepkg -si --noconfirm &&
        yay -S --noconfirm oh-my-posh-bin claude-code
    "

    # Codex needs nothing here: openai-codex is in [extra] and came in with $PKGS,
    # signed by Arch and upgraded by the same pacman -Syu as everything else. (The
    # AUR openai-codex-bin is the one to avoid — it has shipped without the
    # codex-code-mode-host companion binary, needed by code-capable models.)

    sudo sed -i 's/#CheckSpace/CheckSpace/' "$JAIL_ROOT/etc/pacman.conf"

    configure_dotfiles
    install_agent_env
    write_task_helper
    write_statusline

    # Mark the build complete (see the sentinel check at the top) and drop the
    # tmp-cleanup trap now that bootstrap succeeded.
    sudo touch "$JAIL_ROOT/.waterbox-ready"
    trap - EXIT
    log_success "Rootfs ready at $JAIL_ROOT"
}

# Dotfiles, claude defaults, git identity — all per-user, written once.
configure_dotfiles() {
    wb_tee "$JAIL_ROOT/home/$USER_NAME/.zshrc" <<'EOF'
HISTFILE=~/.histfile
HISTSIZE=20000
SAVEHIST=20000

alias yay='yay --color=auto'
alias pacman='pacman --color=auto'

bindkey '^U' backward-kill-line

. /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
. /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
. /usr/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh

eval "$(oh-my-posh init zsh --config blue-owl)"
export PATH="$HOME/.local/bin:$PATH"

# Enable the completion system so agent-env (and others) get Tab-completion.
autoload -Uz compinit && compinit -u

# Source AFTER compinit so agent-env can register its Tab-completion.
[ -f "$HOME/.config/agent-env.zsh" ] && source "$HOME/.config/agent-env.zsh"

# GUI display env, written at boot by 'waterbox … --gui'. Sourcing it here makes
# DISPLAY / WAYLAND_DISPLAY available in every session, independent of how the
# session was spawned — so X/Wayland apps launched from the box just work.
[ -f /etc/waterbox/gui-env ] && source /etc/waterbox/gui-env

# Small orientation banner, printed once per tmux session.
waterbox_welcome() {
    print -P "%F{cyan}── waterbox ─────────────────────────────────────────%f"
    print    "  agent-env           account menu — one account switches EVERY agent · 'help' for subcommands"
    print    "  agent-env usage     plan usage of every account"
    print    "  agent-env default   set the account new sessions start on (Tab-completes names)"
    print    "  claude · codex      run that agent in the active account"
    print    "  Copy fallback       hold Shift while selecting, then Ctrl-Shift-C"
    print    "  Ctrl-b d            detach (session keeps running) — re-attach with 'waterbox' on the host"
    print    "  exit / Ctrl-d       end this session"
    print    "  Ctrl-b c            new window   ·   Ctrl-b n / p   next / previous window"
    print    "  Ctrl-b g            join previous window here (split)   ·   Ctrl-b !   break pane into its own window"
    print    "  Ctrl-b <number>     jump to window N (1, 2, …)   ·   more: https://tmuxai.dev/tmux-shortcuts/"
    print -P "%F{cyan}─%f Tip: copy ~/.agent-env off the box to back up every account + the shared chats."
    print -P "%F{cyan}─────────────────────────────────────────────────────%f"
}
# Key the "already welcomed" marker to the tmux SERVER pid + session id. The pid
# is unique per boot, so markers left in /tmp by a previous boot (/tmp is NOT a
# tmpfs here — tmp.mount is masked) can't collide and silently suppress the banner
# in a brand-new session that happens to reuse an old session id.
if [[ -o interactive && -n "$TMUX" ]]; then
    _wb_sid=$(tmux display -p '#{pid}_#{session_id}' 2>/dev/null)
    _wb_mark="/tmp/.waterbox-welcomed-${_wb_sid//[^0-9_]/}"
    [[ -n "$_wb_sid" && ! -e "$_wb_mark" ]] && { waterbox_welcome; : > "$_wb_mark"; }
    unset _wb_sid _wb_mark
fi
EOF
    sudo chown 1000:1000 "$JAIL_ROOT/home/$USER_NAME/.zshrc"

    wb_tee "$JAIL_ROOT/home/$USER_NAME/.tmux.conf" <<'EOF'
set -g mouse on
set -g history-limit 50000

# Let tmux copy selections to terminals that support OSC 52, without allowing
# arbitrary applications inside tmux to use tmux's clipboard channel. On terminals
# without OSC 52, Shift-drag bypasses tmux for native selection and Ctrl-Shift-C.
set -s set-clipboard external

# When a session ends (e.g. you type 'exit'), drop any scheduled commands that
# targeted it, so they don't linger pointing at a dead session (req 14).
set-hook -g session-closed 'run-shell "waterbox-fire cleanup-session #{q:hook_session_name}"'

# Keep scheduled commands attached to their session across a rename — including the
# native Ctrl-b $, not just waterbox's own 'r' rename. @wb_name records each session's
# name at creation; on rename, waterbox-fire repoints the schedule-command timers from
# @wb_name (the old name) to the new one, then updates @wb_name. #{q:…} shell-quotes
# the name so an odd name can't break the run-shell command.
set-hook -g session-created 'set -F @wb_name "#{session_name}"'
set-hook -g session-renamed 'run-shell "waterbox-fire rename-session #{q:session_name}"'

# Tint the WHOLE status bar with the active pane's account colour, so you can tell
# which account you're on at a glance. agent-env sets @ce_name/@ce_color
# on the pane (see .config/agent-env.zsh) and forces a redraw; the bar falls back
# to a neutral grey when no profile is active. Formats in styles are expanded per
# active pane, so the colour tracks whichever pane you're in.
set -g status-style 'bg=colour#{?@ce_color,#{@ce_color},250},fg=colour16'
set -g window-status-current-style 'bold,reverse'
# status-left = "profile · session" (the identity); centre the window list so it no
# longer crowds the session name; clock on the right.
set -g status-justify centre
set -g status-left-length 40
set -g status-right-length 20
set -g status-left  ' #{?@ce_name,#[bold]#{@ce_name}#[nobold] · ,}#S '
set -g status-right '%H:%M '

# New windows/splits are an extension of the pane you're in: same directory AND
# same agent-env profile (the pane's @ce_name goes into the new shell's env;
# .zshrc re-selects it there). Wrapped in run-shell because tmux format-expands
# run-shell's argument but not new-window's -e.
bind c   run-shell 'tmux new-window      -c "#{pane_current_path}" -e "AGENT_ENV_PROFILE=#{@ce_name}"'
bind %   run-shell 'tmux split-window -h -c "#{pane_current_path}" -e "AGENT_ENV_PROFILE=#{@ce_name}"'
bind '"' run-shell 'tmux split-window -v -c "#{pane_current_path}" -e "AGENT_ENV_PROFILE=#{@ce_name}"'

# Ctrl-b g: pull the previously-active window in beside this one (its active pane
# joins as a right-hand split), so two already-existing windows show side by side.
# The source window is consumed; Ctrl-b ! breaks a pane back out into its own window.
bind g join-pane -h -s :!

# Ctrl-b s: session chooser, but each row also carries the pane's agent-env profile
# ("<session>: <profile> · N windows"), which updates as you move the cursor. The
# status bar can't follow the chooser cursor (it renders for the attached session),
# so the profile is surfaced in the list itself. #{session_name} is omitted on
# purpose — choose-tree already prints it as the row label.
bind s choose-tree -Zs -F '#{?@ce_name,#{@ce_name} · ,}#{session_windows} window#{?#{==:#{session_windows},1},,s}#{?session_attached, (attached),}'
EOF
    sudo chown 1000:1000 "$JAIL_ROOT/home/$USER_NAME/.tmux.conf"

    # Inherit the host user's global git identity (name + email), if set.
    local host_git_name host_git_email
    host_git_name=$(git config --global user.name 2>/dev/null || true)
    host_git_email=$(git config --global user.email 2>/dev/null || true)
    if [ -n "$host_git_name" ] || [ -n "$host_git_email" ]; then
        {
            echo "[user]"
            [ -n "$host_git_name" ]  && echo "    name = $host_git_name"
            [ -n "$host_git_email" ] && echo "    email = $host_git_email"
        } | wb_tee "$JAIL_ROOT/home/$USER_NAME/.gitconfig"
        sudo chown 1000:1000 "$JAIL_ROOT/home/$USER_NAME/.gitconfig"
        log_info "Copied host git identity ($host_git_name <$host_git_email>) into the sandbox."
    fi

    # Personal vim/nano dotfiles (best-effort; a dead URL just warns).
    local rc url dest tmpfile
    for rc in vimrc nanorc; do
        url="https://raw.githubusercontent.com/morkin1792/mylinux/master/$rc"
        dest="$JAIL_ROOT/home/$USER_NAME/.$rc"
        tmpfile=$(mktemp)
        if curl -fsSL "$url" -o "$tmpfile" 2>/dev/null && [ -s "$tmpfile" ]; then
            # cp writes THROUGH a symlinked destination and chown dereferences it, so
            # a box-planted ~/.vimrc -> /etc/... would land outside the rootfs as root.
            _in_jail "$dest" || log_error "Refusing to write '$dest': it resolves outside $JAIL_ROOT. Run 'waterbox reset'."
            sudo cp "$tmpfile" "$dest"
            sudo chown -h 1000:1000 "$dest"
            log_success "Installed .$rc from $url"
        else
            log_warn "Could not download .$rc from $url — skipping it."
        fi
        rm -f "$tmpfile"
    done

    # Per-agent defaults, written into each agent's own home dir. These are both the
    # config used when no profile is active AND the template new profiles are seeded
    # from (see _agent_env_seed in the in-box switcher).
    local key hdir sfile
    for key in $(_agent_keys); do
        hdir="$JAIL_ROOT/home/$USER_NAME/$(_agent_field "$key" 6)"
        sfile="$(_agent_field "$key" 5)"
        _in_jail "$hdir/$sfile" \
            || log_error "Refusing to create '$hdir': its managed settings path resolves outside $JAIL_ROOT. Run 'waterbox reset'."
        sudo mkdir -p "$hdir"
        _agent_settings_template "$key" | wb_tee "$hdir/$sfile"
        sudo chown -R 1000:1000 "$hdir"
    done
}

# --- agent-env: multiple accounts, shared by every agent, inside one box -------
# A PROFILE is one account identity, and it spans all agents: each agent stores its
# own login for it under ~/.agent-env/<agent>/<profile>, and selecting the profile
# points every agent's config-dir variable (CLAUDE_CONFIG_DIR, CODEX_HOME, …) at its
# slot at once. So there is no "current agent" to switch — `agent-env load work`
# moves Claude AND Codex to your work account, and which agent you use is just which
# binary you type.
# write_agent_env_zsh writes only the zsh switcher (re-runnable by 'refresh-config');
# install_agent_env also seeds the default 'personal' profile so the box is ready.
write_agent_env_zsh() {
    local row
    _in_jail "$JAIL_ROOT/home/$USER_NAME/.config/agent-env.zsh" \
        || log_error "Refusing to create the agent config directory: it resolves outside $JAIL_ROOT. Run 'waterbox reset'."
    sudo mkdir -p "$JAIL_ROOT/home/$USER_NAME/.config"
    # The in-box registry is GENERATED from $AGENTS above, so the box's view of which
    # agents exist can never drift from the host script's.
    {
        cat <<'AGENTENV_HEAD'
# agent-env — pick which ACCOUNT this shell's AI agents use.
#
# A profile is one account identity shared across every agent: selecting it points
# each agent's config-dir variable at that profile's slot, so one command switches
# them all. Each agent keeps its OWN login per profile (you sign in to Claude and to
# Codex separately), but within an agent chat history is SHARED across profiles — so
# you can switch accounts and keep the same conversations. See _agent_env_share_history.
#
# Subcommands: load / add / default / usage / delete / help (see _agent_env_help);
# with no arguments it opens the interactive menu.

AGENT_ENV_HOME="$HOME/.agent-env"
AGENT_ENV_DEFAULT_FILE="$AGENT_ENV_HOME/.default"   # account new sessions start on

# --- agent registry (generated by waterbox from its $AGENTS) -------------------
#   key|label|binary|home var|settings file|home dir|history paths
AGENTENV_HEAD
        printf 'AGENT_ENV_REGISTRY=(\n'
        for row in "${AGENTS[@]}"; do printf "    '%s'\n" "$row"; done
        printf ')\n'
        cat <<'AGENTENV'

# Field <n> (1-based) of agent <key>; and the list of every/installed agent key.
_agent_f()   { local r; for r in $AGENT_ENV_REGISTRY; do [[ "${r%%|*}" == "$1" ]] || continue; print -r -- "${${(s:|:)r}[$2]}"; return 0; done; return 1; }
_agent_all() { local r; for r in $AGENT_ENV_REGISTRY; do print -r -- "${r%%|*}"; done; }
_agent_installed() { local k; for k in $(_agent_all); do (( $+commands[$(_agent_f $k 3)] )) && print -r -- $k; done; return 0; }

# Every account name known to any agent (union, sorted, dot-dirs like .shared out).
_agent_env_profiles() {
    local k p; local -a all
    for k in $(_agent_all); do
        for p in "$AGENT_ENV_HOME/$k"/*(N/); do
            [[ "${p:t}" == .* ]] || all+=("${p:t}")
        done
    done
    print -rl -- ${(ou)all}
}
_agent_env_list() { local -a a; a=(${(f)"$(_agent_env_profiles)"}); print -rl -- ${a:#}; }

# Which account a new shell starts on: the configured default if it still exists,
# else 'personal', else the first one alphabetically, else empty. So a deleted or
# missing default never leaves a session with no account selected.
_agent_env_resolve_default() {
    local d=""; local -a ps
    ps=(${(f)"$(_agent_env_list)"})
    [[ -r "$AGENT_ENV_DEFAULT_FILE" ]] && d="$(<"$AGENT_ENV_DEFAULT_FILE")"
    [[ -n "$d" ]] && (( ${ps[(I)$d]} )) && { print -r -- "$d"; return }
    (( ${ps[(I)personal]} )) && { print -r -- personal; return }
    [[ -n "${ps[1]}" ]] && print -r -- "${ps[1]}"
    return 0
}
_agent_env_set_default() {   # $1 = account name (must exist)
    local -a ps; ps=(${(f)"$(_agent_env_list)"})
    (( ${ps[(I)$1]} )) || { print "No such account: '$1'."; return 1 }
    mkdir -p "$AGENT_ENV_HOME"
    print -r -- "$1" > "$AGENT_ENV_DEFAULT_FILE"
    print "Default account set to '$1' — new sessions start there, on every agent."
}

# Seed a new slot from the agent's own home dir, which waterbox filled with the
# bypass defaults at bootstrap. So a fresh account starts configured, not prompting.
_agent_env_seed() {   # $1 = agent key, $2 = slot dir
    local sfile hdir
    sfile="$(_agent_f $1 5)"; hdir="$HOME/$(_agent_f $1 6)"
    [[ -f "$2/$sfile" ]] && return 0
    [[ -f "$hdir/$sfile" ]] && cp "$hdir/$sfile" "$2/$sfile"
    return 0
}

# Apply Waterbox's newer Claude defaults to an existing account and point it at the
# shared statusline script, so every account shows the same line and one /statusline
# changes all of them. New preference keys are ADD-ONLY, except that the former
# exact Waterbox default (Opus + xhigh) migrates to the new Opus + high default.
# Other explicit account choices remain untouched.
#
# PRESERVE OVERRIDES: a custom/null statusLine is never touched; only Waterbox's
# own current/retired entry may be refreshed. Set "statusLine": null in an account
# to drop the line there. (Path must match STATUSLINE_PATH on the host side — both
# heredocs are quoted.)
_agent_env_ensure_claude_defaults() {   # $1 = the claude slot dir
    local s="$1/settings.json"
    local have_statusline=0
    [[ -f "$s" ]] || return 0
    [[ -x "$HOME/.claude/statusline-command.sh" ]] && have_statusline=1
    python3 -c '
import json, sys
p = sys.argv[1]
have_statusline = sys.argv[2] == "1"
cmd = "~/.claude/statusline-command.sh"
# refreshInterval is seconds: without it the line only repaints on an assistant
# message, so the quota % and the reset countdown sit stale while you read /usage.
new = {"type": "command", "command": cmd, "refreshInterval": 30}
ours = (cmd, "/usr/local/bin/waterbox-statusline")   # current + retired paths
try:
    with open(p) as f: d = json.load(f)
except Exception:
    sys.exit(0)                      # unreadable/invalid: leave it entirely alone
if not isinstance(d, dict):
    sys.exit(0)
changed = False
# Default to Opus with high effort. Migrate the exact former Waterbox pair while
# preserving any other explicit model/effort combination.
if "model" not in d:
    d["model"] = "opus"
    changed = True
if "effortLevel" not in d:
    d["effortLevel"] = "high"
    changed = True
elif d.get("model") == "opus" and d["effortLevel"] == "xhigh":
    d["effortLevel"] = "high"
    changed = True
# /focus is available only in Claude Code fullscreen rendering. These are defaults,
# not policy: preserve an explicit per-account choice if either key already exists.
for key, value in (("tui", "fullscreen"), ("viewMode", "focus")):
    if key not in d:
        d[key] = value
        changed = True
if have_statusline:
    cur = d.get("statusLine")
    if "statusLine" not in d:
        d["statusLine"] = new
        changed = True
    # Only rewrite an entry that is still OURS — a retired path to migrate, or our
    # own path missing newer keys. Anything else is a deliberate choice: left be.
    elif isinstance(cur, dict) and cur.get("command") in ours and cur != new:
        d["statusLine"] = new
        changed = True
if not changed:
    sys.exit(0)
with open(p, "w") as f:
    json.dump(d, f, indent=2); f.write("\n")
' "$s" "$have_statusline" 2>/dev/null
    return 0
}

# Point a slot's history paths at that AGENT's shared store (symlinks), so chat
# history follows you across accounts. Anything real already there is migrated into
# the store first (dirs union-merged, files appended), then replaced by the symlink.
# Idempotent: once linked, re-running is a no-op. Credentials are deliberately NOT
# in the history list, so this shares conversations WITHOUT sharing logins. Stores
# are per agent — the formats aren't interchangeable.
_agent_env_share_history() {   # $1 = agent key, $2 = slot dir
    local shared="$AGENT_ENV_HOME/$1/.shared" ent name
    mkdir -p "$shared"
    for ent in ${=$(_agent_f $1 7)}; do
        name="${ent%/}"
        if [[ "$ent" == */ ]]; then                      # a directory of history
            if [[ -d "$2/$name" && ! -L "$2/$name" ]]; then
                mkdir -p "$shared/$name"
                cp -a "$2/$name/." "$shared/$name/" 2>/dev/null && rm -rf "$2/$name" || continue
            fi
            mkdir -p "$shared/$name"
        else                                             # a single history file
            if [[ -f "$2/$name" && ! -L "$2/$name" ]]; then
                cat "$2/$name" >> "$shared/$name" 2>/dev/null && rm -f "$2/$name" || continue
            fi
            [[ -e "$shared/$name" ]] || : > "$shared/$name"
        fi
        ln -sfn "$shared/$name" "$2/$name"
    done
    return 0
}

# A stable tmux colour for an account name (same name -> same colour). 16 bright
# tones (readable with black text); green is fine here since "none" is grey.
_agent_env_color() {
    local pal=(2 3 6 10 11 14 208 214 220 45 213 118 51 205 154 111) h
    h=$(print -rn -- "$1" | cksum | cut -d' ' -f1)
    print -r -- "${pal[ h % ${#pal} + 1 ]}"
}
# Publish the active account (+ its colour) onto the tmux pane so the status bar can
# show it. No-op outside tmux. The @ce_* names predate 1.9 and are kept so a tmux
# server started by an older waterbox keeps rendering the bar correctly.
_agent_env_tmux_status() {
    [[ -n "$TMUX" ]] || return 0
    tmux set -p @ce_name "$1" 2>/dev/null
    [[ -n "$1" ]] && tmux set -p @ce_color "$(_agent_env_color "$1")" 2>/dev/null
    tmux refresh-client -S 2>/dev/null   # repaint now, don't wait for the interval
    return 0
}

# Select an account for THIS shell: create + seed its slot for EVERY agent, wire
# each agent's config-dir variable to it, and colour the status bar.
_agent_env_select() {   # $1 = account name
    local k dir
    for k in $(_agent_all); do
        dir="$AGENT_ENV_HOME/$k/$1"
        mkdir -p "$dir"
        _agent_env_seed "$k" "$dir"
        _agent_env_share_history "$k" "$dir"
        [[ "$k" == claude ]] && _agent_env_ensure_claude_defaults "$dir"
        export "$(_agent_f $k 4)=$dir"
    done
    export AGENT_ENV_PROFILE="$1"
    export CLAUDE_ENV_PROFILE="$1"   # pre-1.9 name; harmless, keeps old panes happy
    _agent_env_tmux_status "$1"
}

_agent_env_menu() {   # args = account options; sets REPLY to the chosen one, or:
    #   '(delete)' + MENU_NAME=highlighted account   when 'd' is pressed
    #   '(status)'                                   when 's' is pressed
    #   '(new)'                                      when 'a' is pressed (caller prompts a name)
    #   '(quit)'                                     when 'q' ends the menu (Ctrl-C also exits, via the trap)
    local opts=("$@") sel=1 n=$# key i first=1
    MENU_NAME=""
    print -u2 -- "Select an account (↑/↓ move · Enter load · a new · d delete · s status · q quit):"
    print -nu2 -- $'\e[?25l'
    while true; do
        (( first )) || print -nu2 -- $'\e['"$n"'A'
        first=0
        for (( i = 1; i <= n; i++ )); do
            if (( i == sel )); then
                print -nu2 -- $'\r\e[K  \e[36m> '"${opts[i]}"$'\e[0m\n'
            else
                print -nu2 -- $'\r\e[K    '"${opts[i]}"$'\n'
            fi
        done
        read -k1 -s key
        if [[ "$key" == $'\e' ]]; then
            read -k2 -s key
            case "$key" in
                '[A'|'OA') (( sel = sel > 1 ? sel - 1 : n ));;
                '[B'|'OB') (( sel = sel < n ? sel + 1 : 1 ));;
            esac
            continue
        fi
        case "$key" in
            d) print -nu2 -- $'\e[?25h'; MENU_NAME="${opts[sel]}"; REPLY='(delete)'; return 0 ;;
            s) print -nu2 -- $'\e[?25h'; REPLY='(status)'; return 0 ;;
            a) print -nu2 -- $'\e[?25h'; REPLY='(new)';    return 0 ;;
            q) print -nu2 -- $'\e[?25h'; REPLY='(quit)';   return 0 ;;
        esac
        if [[ -z "$key" || "$key" == $'\n' || "$key" == $'\r' ]]; then
            print -nu2 -- $'\e[?25h'; REPLY="${opts[sel]}"; return 0
        fi
    done
}

# Print (but never run) how to delete an account — the user copy-pastes it.
_agent_env_delete_hint() {
    local p="$1"; local -a ps
    ps=(${(f)"$(_agent_env_list)"})
    if [[ -z "$p" ]] || ! (( ${ps[(I)$p]} )); then
        print "No account selected to delete."; return 0
    fi
    print -P "%F{yellow}Deleting '$p' removes its login for EVERY agent. Chat history is shared%f"
    print -P "%F{yellow}across accounts, so your conversations are kept.%f"
    print "If you're sure, copy-paste this:"
    print -P "    %F{cyan}agent-env delete $p%f"
}

_agent_env_help() {
    local k
    print "agent-env — manage the accounts your AI agents use on this box"
    print ""
    print "An account is shared by every agent: selecting one points all of them at it."
    print "Each agent still has its own login per account — sign in to each once."
    print ""
    print "usage:"
    print "  agent-env                 interactive account menu (a new · d delete · s status · q quit)"
    print "  agent-env load <name>     switch this shell to account <name>"
    print "  agent-env add <name>      create account <name> and switch to it"
    print "  agent-env default [name]  show or set the account new sessions start on"
    print "  agent-env usage           show plan usage for every account"
    print "  agent-env delete <name>   delete an account's logins (shared chats are kept)"
    print "  agent-env help            this help"
    print ""
    print -n "agents on this box:"
    for k in $(_agent_all); do
        if (( $+commands[$(_agent_f $k 3)] )); then print -n " $(_agent_f $k 3)"
        else print -n " $(_agent_f $k 3)(not installed)"; fi
    done
    print ""
    print "(pre-1.9 name 'claude-env' still works)"
}

_agent_env_load() {   # $1 = name of an EXISTING account
    local name="$1"; local -a ps
    [[ -z "$name" ]] && { print "usage: agent-env load <account>"; return 1 }
    ps=(${(f)"$(_agent_env_list)"})
    if ! (( ${ps[(I)$name]} )); then
        print "No such account: '$name'.  Create it with: agent-env add $name"; return 1
    fi
    _agent_env_select "$name"
    print "Active account: $name  (run 'claude' or 'codex')"
}

_agent_env_create() {   # $1 = account name; created if missing, then selected
    local name="$1"; local -a ps
    if [[ -z "$name" || "$name" == */* || "$name" == .* ]]; then
        print "Invalid account name: '$name'"; return 1
    fi
    ps=(${(f)"$(_agent_env_list)"})
    if (( ${ps[(I)$name]} )); then
        print "Account '$name' already exists — switching to it."
    else
        print "Created account '$name' (sign each agent in once: run 'claude', then 'codex')."
    fi
    _agent_env_select "$name"   # creates + seeds the slot for every agent
    print "Active account: $name"
}

# Plan usage per account. Only agents that can report usage NON-interactively are
# probed; the others are listed as such rather than silently dropped, so the table
# always accounts for every agent you have.
_agent_env_usage() {
    local p k out line day week lbl
    local -a profiles
    profiles=(${(f)"$(_agent_env_list)"})
    (( ${#profiles} )) || { print "No accounts yet."; return 0 }
    print "Plan usage per account (probes each agent once per account — takes a moment):"
    print ""
    for p in "${profiles[@]}"; do
        print -r -- "${p}:"
        for k in $(_agent_installed); do
            lbl="$(_agent_f $k 2)"
            case "$k" in
                claude)
                    print -nu2 -- "  checking ${p} / ${lbl}…"
                    out="$(CLAUDE_CONFIG_DIR="$AGENT_ENV_HOME/claude/$p" command timeout 20 \
                             claude --model haiku --no-session-persistence --print "/usage" 2>/dev/null)"
                    print -nu2 -- $'\r\e[K'
                    day="" week=""
                    while IFS= read -r line; do
                        case "$line" in
                            'Current session: '*)           day="${line#"Current session: "}" ;;
                            # NB: quoted pattern — the () would otherwise be glob grouping.
                            'Current week (all models): '*) week="${line#"Current week (all models): "}" ;;
                        esac
                    done <<< "$out"
                    if [[ -n "$day" || -n "$week" ]]; then
                        printf '  %-12s current -> %s\n' "$lbl" "${day:-unavailable}"
                        printf '  %-12s week    -> %s\n' ''    "${week:-unavailable}"
                    else
                        printf '  %-12s no usage data (not logged in on this account?)\n' "$lbl"
                    fi
                    ;;
                codex)
                    # Codex exposes usage only through /status inside its TUI — there is
                    # no non-interactive equivalent to probe (openai/codex#15281).
                    printf '  %-12s n/a — run '\''codex'\'' and type /status\n' "$lbl"
                    ;;
                *)
                    printf '  %-12s n/a — no non-interactive usage command\n' "$lbl"
                    ;;
            esac
        done
        print ""
    done
}

agent-env() {
    emulate -L zsh   # LOCAL_TRAPS: the Ctrl-C trap below dies with this function
    # Ctrl-C ends agent-env gracefully: restore the cursor the menu may have
    # hidden, move to a fresh line, and exit 0 — no error status on the prompt.
    # `return` in a trap only exits the INNERMOST running function (e.g. the
    # menu), so _ae_int flags the interrupt for the checks after nested calls.
    local _ae_int=0
    trap 'print -nu2 "\e[?25h"; print; _ae_int=1; return 0' INT
    mkdir -p "$AGENT_ENV_HOME"
    local sub="$1" ans name target d k
    local profiles=()

    case "$sub" in
        help|--help|-h) _agent_env_help; return 0 ;;
        usage|status)   _agent_env_usage; return 0 ;;
        load)           _agent_env_load "$2"; return $? ;;
        add)
            [[ -z "$2" ]] && { print "usage: agent-env add <account>"; return 1 }
            _agent_env_create "$2"; return $? ;;
        default)
            if [[ -n "$2" ]]; then _agent_env_set_default "$2"; return $?; fi
            print "Default account: '$(_agent_env_resolve_default)'."
            print "Change it with: agent-env default <name>   (Tab-completes account names)"
            return 0 ;;
        delete|rm)
            target="$2"
            [[ -z "$target" ]] && { print "usage: agent-env delete <account>"; return 1 }
            profiles=(${(f)"$(_agent_env_list)"})
            (( ${profiles[(I)$target]} )) || { print "No such account: $target"; return 1 }
            print -n "Delete account '$target' — its login on EVERY agent (shared chats are kept)? [y/N] "; read -r ans
            if [[ "$ans" == [Yy]* ]]; then
                for k in $(_agent_all); do rm -rf "${AGENT_ENV_HOME:?}/$k/$target"; done
                # If it was the configured default, forget it so the default re-resolves.
                d=""
                [[ -r "$AGENT_ENV_DEFAULT_FILE" ]] && d="$(<"$AGENT_ENV_DEFAULT_FILE")"
                [[ "$d" == "$target" ]] && rm -f "$AGENT_ENV_DEFAULT_FILE"
                print "Deleted account '$target' (chat history kept in the shared stores)."
                # If it was the active one, switch to another rather than leaving none.
                if [[ "$AGENT_ENV_PROFILE" == "$target" ]]; then
                    local nx="$(_agent_env_resolve_default)"
                    if [[ -n "$nx" ]]; then
                        _agent_env_select "$nx"; print "Switched to '$nx'."
                    else
                        unset AGENT_ENV_PROFILE CLAUDE_ENV_PROFILE
                        for k in $(_agent_all); do unset "$(_agent_f $k 4)"; done
                        _agent_env_tmux_status ""
                    fi
                fi
            else
                print "Kept '$target'."
            fi
            return 0 ;;
        '') ;;                       # fall through to the interactive menu
        *)  _agent_env_load "$sub"; return $? ;;
    esac

    profiles=(${(f)"$(_agent_env_list)"})
    if (( ! ${#profiles} )); then
        print "No accounts yet."
        name=""; vared -p "Name for the first account: " name
        (( _ae_int )) && return 0
        [[ -z "$name" ]] && { print "No name given."; return 0 }
        _agent_env_create "$name"; return $?
    fi

    _agent_env_menu "${profiles[@]}"
    (( _ae_int )) && return 0
    case "$REPLY" in
        '(quit)')   return 0 ;;
        '(delete)') _agent_env_delete_hint "$MENU_NAME"; return 0 ;;
        '(status)') _agent_env_usage; return 0 ;;
        '(new)')
            name=""; vared -p "Name for the new account: " name   # vared = ZLE line editing (arrows)
            (( _ae_int )) && return 0
            [[ -z "$name" ]] && { print "No name given."; return 0 }
            _agent_env_create "$name"; return $? ;;
        *)          _agent_env_load "$REPLY" ;;
    esac
}

# Pre-1.9 name. Kept so muscle memory, docs and any script inside the box still work.
claude-env() { agent-env "$@" }

# claude-desktop (AUR) is a SEPARATE Electron app with its own login store; it does
# not read the CLI's CLAUDE_CONFIG_DIR, so it can't inherit an agent-env login. This
# wrapper does three things:
#   1) points its user-data-dir at a PER-ACCOUNT folder (kept under the active
#      account's Claude slot), so its login is scoped to and switches with the
#      account — you log in once per account and it sticks (best-effort: only if the
#      app honours --user-data-dir; if not, it uses its default and this is a no-op).
#   2) gives it a working OS keyring so the sign-in PERSISTS across restarts. The app
#      stores its token via Electron safeStorage, which needs a Secret Service; with
#      none, isEncryptionAvailable() is false and it warns "sign-in won't be saved".
#      We start a private gnome-keyring on a throwaway D-Bus session and point the app
#      at it with --password-store=gnome-libsecret. The keyring lives UNDER the slot
#      (XDG_DATA_HOME), so the desktop login is per-account AND survives restarts, and
#      travels with the ~/.agent-env backup just like the CLI credentials do. The
#      keyring password is generated once per account and kept beside it — the box (and
#      its backup) is the security boundary, same as the CLI's stored credentials.
#      gnome-keyring is NOT baked into the box: its gcr dependency drags in the whole
#      GTK stack, none of which we use (our --login recipe never prompts) — dead weight
#      on a CLI-agent box. So we install it lazily, on first launch here. (When
#      claude-desktop itself is installed most of that stack is already present, so the
#      extra cost is small — hence no scary size in the prompt.)
#   3) launches it FULLY DETACHED (new session, no controlling tty), so closing the
#      window frees your shell — the raw binary stays attached and hangs the terminal.
# Defined even when the app isn't installed, and the binary is checked at RUN time:
# that way installing it makes the wrapper work immediately in already-open shells
# (a definition-time check would need a new session), and without it you get an
# install hint instead of "command not found".
claude-desktop() {
    emulate -L zsh
    local dd xdg pwfile ans
    if [[ ! -x /usr/bin/claude-desktop ]]; then
        print "claude-desktop is not installed. Install it first, then run this again:"
        print -P "    %F{cyan}yay -S claude-desktop%f"
        return 1
    fi
    if [[ -n "$AGENT_ENV_PROFILE" && -d "$AGENT_ENV_HOME/claude/$AGENT_ENV_PROFILE" ]]; then
        dd="$AGENT_ENV_HOME/claude/$AGENT_ENV_PROFILE/desktop"
        xdg="$AGENT_ENV_HOME/claude/$AGENT_ENV_PROFILE/desktop-xdg"   # holds keyrings/
    else
        dd="$HOME/.config/Claude"   # no active account: the app's default location
        xdg="$HOME/.local/share"
    fi
    mkdir -p "$dd" "$xdg"

    # No Secret Service => the sign-in can't persist. gnome-keyring isn't preinstalled
    # (it pulls the GTK stack we don't use), so offer to install it here — once. Decline
    # and it still launches, just without persistence (the old behaviour). The in-box
    # user has passwordless sudo, so the install is non-interactive.
    if [[ ! -x /usr/bin/gnome-keyring-daemon ]]; then
        print    "claude-desktop keeps you signed in via an OS keyring (gnome-keyring),"
        print    "which isn't installed yet (a one-time install)."
        print -n "Install it now so your sign-in persists across restarts? [Y/n] "
        read -r ans
        if [[ "$ans" == [Nn]* ]]; then
            print -P "%F{yellow}Skipping — the sign-in won't persist. Re-run claude-desktop to install later.%f"
            setsid -f /usr/bin/claude-desktop --user-data-dir="$dd" "$@" </dev/null >/dev/null 2>&1
            print "claude-desktop launched detached (account: ${AGENT_ENV_PROFILE:-none})."
            return 0
        fi
        print "Installing gnome-keyring + libsecret..."
        # -Sy up front: a long-lived box's sync db may be stale, and without a refresh
        # pacman can't find/resolve the package (acceptable partial-sync in a sandbox).
        if ! sudo pacman -Sy --needed --noconfirm gnome-keyring libsecret; then
            print -P "%F{yellow}Install failed (network/mirrors?). Launching without persistence.%f"
            setsid -f /usr/bin/claude-desktop --user-data-dir="$dd" "$@" </dev/null >/dev/null 2>&1
            print "claude-desktop launched detached (account: ${AGENT_ENV_PROFILE:-none})."
            return 0
        fi
    fi

    # One stable per-account keyring password, generated once and kept beside the
    # keyring (mode 600). It must be identical on every launch or the existing
    # keyring won't unlock (verified: wrong password => token unreadable).
    pwfile="$xdg/keyring-pw"
    if [[ ! -s "$pwfile" ]]; then
        ( umask 077; head -c 24 /dev/urandom | base64 | tr -d '\n' > "$pwfile" )
    fi

    # gnome-keyring's --login creates+unlocks the login keyring from a password on
    # stdin (empty-password --unlock instead pops a GUI prompt and fails headless),
    # all inside a private dbus-run-session so we don't depend on a user bus.
    # Run the daemon in the FOREGROUND (backgrounded) rather than --daemonize: that
    # keeps it as OUR child so the EXIT trap kills it when the app quits. A
    # --daemonize'd daemon instead orphans to init and lingers after every launch,
    # piling up stray daemons (each with a control socket in the shared
    # XDG_RUNTIME_DIR). The Secret Service is D-Bus-activated on demand, so we don't
    # need --start; the secret-tool warm-up just blocks until it's up so the app never
    # races ahead of the keyring. (printf, not a here-string: the password must carry
    # NO trailing newline, or it won't match keyrings created by earlier launches.)
    setsid -f env XDG_DATA_HOME="$xdg" dbus-run-session -- bash -c '
        pw="$(cat "$2")"
        printf "%s" "$pw" | gnome-keyring-daemon --foreground --components=secrets --login >/dev/null 2>&1 &
        gkd=$!
        trap "kill $gkd 2>/dev/null" EXIT INT TERM
        secret-tool lookup _waterbox_warmup 1 >/dev/null 2>&1 || true
        /usr/bin/claude-desktop --password-store=gnome-libsecret \
             --user-data-dir="$1" "${@:3}"
    ' claude-desktop "$dd" "$pwfile" "$@" </dev/null >/dev/null 2>&1
    print "claude-desktop launched detached (account: ${AGENT_ENV_PROFILE:-none}). Shell is free; close the window to quit."
}

# The active account is shown in the tmux status bar (colored per account), so no
# in-prompt indicator is needed. Strip any indicator a previous version left in
# RPROMPT, once, so upgrades don't leave a stale "(name)" behind.
_agent_env_prompt_cleanup() {
    if [[ "$RPROMPT" == %F\{cyan\}\(*%f\ * ]]; then
        RPROMPT="${RPROMPT#*%f }"
    fi
    add-zsh-hook -d precmd _agent_env_prompt_cleanup
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd _agent_env_prompt_cleanup

# Tab-completion for agent-env: subcommands + existing account names.
_agent_env_complete() {
    local -a subcmds profiles
    subcmds=(
        'load:switch this shell to an account'
        'add:create a new account'
        'default:show or set the account new sessions start on'
        'usage:plan usage for every account'
        'delete:delete an account (shared chats kept)'
        'help:show help'
    )
    if (( CURRENT == 2 )); then
        _describe -t commands 'agent-env command' subcmds
        profiles=(${(f)"$(_agent_env_list)"})
        (( ${#profiles} )) && _describe -t profiles 'account' profiles
    elif (( CURRENT == 3 )); then
        case "${words[2]}" in
            load|delete|rm|default)
                profiles=(${(f)"$(_agent_env_list)"})
                (( ${#profiles} )) && _describe -t profiles 'account' profiles ;;
        esac
    fi
}
(( $+functions[compdef] )) && compdef _agent_env_complete agent-env claude-env 2>/dev/null

# Auto-select an account for every new shell. Precedence: one inherited via the
# environment (Ctrl-b c and splits pass the source pane's @ce_name through tmux's
# -e, so new windows keep the account of the pane they came from), else the
# configured default — so a session is never left with no account selected.
# Re-selecting the inherited name wires each agent's config-dir var and THIS pane's
# status-bar colour, which the env var alone doesn't carry.
_wb_inherit="${AGENT_ENV_PROFILE:-$CLAUDE_ENV_PROFILE}"
_wb_ps=(${(f)"$(_agent_env_list)"})
if [[ -n "$_wb_inherit" ]] && (( ${_wb_ps[(I)$_wb_inherit]} )); then
    _agent_env_select "$_wb_inherit"
else
    _wb_def="$(_agent_env_resolve_default)"
    [[ -n "$_wb_def" ]] && _agent_env_select "$_wb_def"
    unset _wb_def
fi
unset _wb_inherit _wb_ps
AGENTENV
    } | wb_tee "$JAIL_ROOT/home/$USER_NAME/.config/agent-env.zsh"
    # Drop the pre-1.9 file so a stale copy can't shadow the new switcher.
    # rm -f drops a symlinked file itself, but a symlinked PARENT (.config) would aim
    # the unlink at a host path, so resolve the whole chain before deleting.
    _in_jail "$JAIL_ROOT/home/$USER_NAME/.config/claude-env.zsh" \
        && sudo rm -f "$JAIL_ROOT/home/$USER_NAME/.config/claude-env.zsh" || true
    sudo chown -R 1000:1000 "$JAIL_ROOT/home/$USER_NAME/.config"
}

install_agent_env() {
    write_agent_env_zsh
    # Auto-create the 'personal' account once, with a slot per agent seeded from
    # that agent's defaults.
    local key hdir sfile dir home="$JAIL_ROOT/home/$USER_NAME"
    for key in $(_agent_keys); do
        dir="$home/.agent-env/$key/personal"
        hdir="$home/$(_agent_field "$key" 6)"
        sfile="$(_agent_field "$key" 5)"
        # These live in the box's own home, so every component is box-controlled:
        # mkdir -p follows a symlinked slot dir and cp writes straight through it.
        _in_jail "$dir/$sfile" || log_error "Refusing to seed '$dir/$sfile': it resolves outside $JAIL_ROOT. Run 'waterbox reset'."
        sudo mkdir -p "$dir"
        if [ -f "$hdir/$sfile" ]; then sudo cp "$hdir/$sfile" "$dir/$sfile"; fi
    done
    sudo chown -R 1000:1000 "$home/.agent-env"
    # Pre-1.9 path kept as a symlink (relative, so it resolves both on the host and
    # inside the box) — old backups, docs and any lingering unit still find it.
    _link_legacy_claude_env
    log_info "Created default account 'personal' for: $(_agent_keys | tr '\n' ' ')"
    _write_config_version   # a fresh box is current for this waterbox version
}

# ~/.claude-env -> .agent-env/claude, unless a REAL directory is still sitting there
# (pre-migration); never clobber that, migrate_agent_env owns it.
_link_legacy_claude_env() {
    local legacy="$JAIL_ROOT/home/$USER_NAME/.claude-env"
    [ -d "$legacy" ] && [ ! -L "$legacy" ] && return 0
    sudo ln -sfn ".agent-env/claude" "$legacy"
}

# --- One-time layout migration (pre-1.9 -> multi-agent) -----------------------
# Up to 1.8 there was exactly one agent, so profiles lived flat in ~/.claude-env/.
# Now every agent gets its own tree (~/.agent-env/<agent>/<profile>) so the same
# account name can hold a Claude login and a Codex login side by side.
#
# Moving a profile directory while an agent has it open would corrupt that agent's
# state, so this only ever runs at a quiet moment — the caller checks the box is
# down, or up with no live session. Until then the old layout keeps working
# untouched, and we just say so.
_needs_agent_env_migration() {
    local legacy="$JAIL_ROOT/home/$USER_NAME/.claude-env"
    [ -d "$legacy" ] && [ ! -L "$legacy" ]
}

migrate_agent_env() {
    local home="$JAIL_ROOT/home/$USER_NAME"
    local legacy="$home/.claude-env" new="$home/.agent-env"
    local e key dir hdir sfile prof
    _needs_agent_env_migration || return 0

    log_info "Migrating accounts to the multi-agent layout (~/.agent-env/claude/…)..."
    # Everything here is under the box's own home, so the box picks both sides of the
    # move: it can make ~/.claude-env a real dir (which is what triggers us) and point
    # ~/.agent-env/claude at a HOST directory. mkdir -p follows that symlink and `mv`
    # then deposits box-authored files — names, contents and ownership all chosen by
    # container root — outside the rootfs. Resolve the destinations first and refuse.
    _in_jail "$new/claude" \
        || log_error "Refusing to migrate accounts: '$new/claude' resolves outside $JAIL_ROOT, so the box has tampered with it. Run 'waterbox reset' to rebuild the rootfs."
    sudo mkdir -p "$new/claude"
    # Move everything across wholesale: profile dirs, .shared and .default alike.
    # '|| true' so a failed move doesn't abort the whole start (set -e): the rmdir
    # below is the real check — anything left behind means we stop and keep the old
    # layout intact rather than half-migrating it.
    ( shopt -s dotglob nullglob
      for e in "$legacy"/*; do sudo mv -n "$e" "$new/claude/"; done ) || true
    sudo rmdir "$legacy" 2>/dev/null \
        || { log_warn "Couldn't migrate accounts: '$legacy' isn't empty. Left as-is, old layout still works."; return 0; }
    # The default account is now global (it applies to every agent), so lift it out
    # of the claude tree.
    if [ -f "$new/claude/.default" ] && _in_jail "$new/.default"; then
        sudo mv -n "$new/claude/.default" "$new/.default" 2>/dev/null || true
    fi

    # Give every other agent a slot for each account that already existed, seeded
    # with that agent's defaults — so `agent-env load <name>` finds them all and you
    # just sign in once per agent.
    for prof in $(cd "$new/claude" 2>/dev/null && ls -1 2>/dev/null || true); do
        [ -d "$new/claude/$prof" ] || continue
        case "$prof" in .*) continue ;; esac
        for key in $(_agent_keys); do
            [ "$key" = claude ] && continue
            dir="$new/$key/$prof"
            hdir="$home/$(_agent_field "$key" 6)"
            sfile="$(_agent_field "$key" 5)"
            _in_jail "$dir/$sfile" || { log_warn "Skipping '$dir/$sfile': it resolves outside $JAIL_ROOT."; continue; }
            sudo mkdir -p "$dir"
            if [ -f "$hdir/$sfile" ] && [ ! -f "$dir/$sfile" ]; then
                sudo cp "$hdir/$sfile" "$dir/$sfile"
            fi
        done
    done

    sudo chown -R 1000:1000 "$new"
    _link_legacy_claude_env
    log_success "Accounts migrated. ~/.claude-env still resolves (symlink); back up ~/.agent-env from now on."
}

# --- Helpers ---
# Container state via the root helper (passwordless) once it's installed; before
# that (fresh bootstrap) fall back to a plain read — the box isn't up yet anyway.
is_running() {
    if _helper_current; then
        [ "$(sudo -n "$HELPER_PATH" state 2>/dev/null)" = running ]
    else
        machinectl show "$MACHINE_NAME" --property=State 2>/dev/null | grep -q "State=running"
    fi
}

# GUI display passthrough. Runs AS THE USER (needs your DISPLAY/XAUTHORITY/runtime
# dir) and writes two spec files the root helper consumes at boot:
#   GUI_BINDS_FILE  — one "<src>[:<dst>]" per line; the helper validates each (only
#                     the display sockets + our own xauth file) before binding.
#   GUI_ENV_FILE    — "export VAR=..." lines; the helper copies these into the
#                     rootfs /etc/waterbox/gui-env, which the login shell sources
#                     (the reliable path — DISPLAY reaching a session must not
#                     depend on tmux/machinectl env propagation).
# Both files are cleared first, so a boot WITHOUT --gui leaves nothing stale.
#
# It auto-detects the host's display server from which socket actually binds, then
# sets the matching toolkit backend env so GUI apps "just work" without per-app
# flags: Wayland when a wayland socket is present (Wayland hosts), else X11 (Xorg
# hosts like Mint Cinnamon). Fallback lists keep the other backend reachable.
build_gui_bind_args() {
    : > "$GUI_ENV_FILE"; : > "$GUI_BINDS_FILE"
    [ "$WATERBOX_GUI" = "1" ] || return 0
    local env_lines=() l have_x=0 have_wl=0

    # Wayland first. On a Wayland host, plain --gui (and the automatic default)
    # must never quietly add Xwayland too: X11 has no client isolation. --x11 is
    # the explicit opt-in for users who knowingly need that compatibility path.
    local wlsock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/${WAYLAND_DISPLAY:-}"
    [ -S "$wlsock" ] || wlsock="${WAYLAND_DISPLAY:-}"
    if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$wlsock" ]; then
        echo "$wlsock:/tmp/.waterbox-wayland" >> "$GUI_BINDS_FILE"
        env_lines+=("WAYLAND_DISPLAY=/tmp/.waterbox-wayland")
        have_wl=1
    fi

    # X11. Bind the specific socket FILE (X<n>), not the /tmp/.X11-unix dir: the
    # container's systemd-tmpfiles wipes that dir at boot, which would empty a dir
    # bind; a file mountpoint survives it. If the display's socket isn't a real
    # file on the host (abstract-only Xwayland), we skip X and rely on Wayland.
    # Auth: the host cookie is keyed to the HOST hostname, but inside gethostname()
    # is 'box' — so rewrite the cookie to FamilyWild ('ffff' matches any hostname).
    local dnum="${DISPLAY#*:}"; dnum="${dnum%%.*}"
    local xsock="/tmp/.X11-unix/X$dnum"
    if { [ "$have_wl" = 0 ] || [ "$WATERBOX_X11" = 1 ]; } \
       && [ -n "${DISPLAY:-}" ] && [ -S "$xsock" ]; then
        echo "$xsock" >> "$GUI_BINDS_FILE"
        env_lines+=("DISPLAY=:$dnum")
        have_x=1
        local xsrc="${XAUTHORITY:-}"
        [ -f "$xsrc" ] || xsrc=$(xauth info 2>/dev/null | sed -n 's/.*Authority file:[[:space:]]*//p' | head -n1)
        [ -f "$xsrc" ] || xsrc="$HOME/.Xauthority"
        if command -v xauth >/dev/null 2>&1 && [ -f "$xsrc" ]; then
            local wx="$CONFIG_DIR/xauth"
            rm -f "$wx"; (umask 077; : > "$wx")
            xauth -f "$xsrc" nlist "$DISPLAY" 2>/dev/null \
                | sed -e 's/^..../ffff/' \
                | xauth -f "$wx" nmerge - 2>/dev/null || true
            if [ -s "$wx" ]; then
                echo "$wx:/tmp/.waterbox-xauth" >> "$GUI_BINDS_FILE"
                env_lines+=("XAUTHORITY=/tmp/.waterbox-xauth")
            fi
        fi
        command -v xhost >/dev/null 2>&1 && xhost +SI:localuser:"$RUN_USER" >/dev/null 2>&1 || true
    fi

    # Pick a default backend from what actually bound: prefer Wayland if present
    # (with X11 fallbacks), else X11. So bare `chromium`/GTK/Qt apps use the right
    # one with no flags. Values with ';'/',' are quoted when written to gui-env.
    if [ "$have_wl" = 1 ]; then
        if [ "$have_x" = 1 ]; then
            env_lines+=("GDK_BACKEND=wayland,x11" "QT_QPA_PLATFORM=wayland;xcb")
        else
            env_lines+=("GDK_BACKEND=wayland" "QT_QPA_PLATFORM=wayland")
        fi
        env_lines+=("XDG_SESSION_TYPE=wayland" "OZONE_PLATFORM=wayland" \
                    "MOZ_ENABLE_WAYLAND=1" "ELECTRON_OZONE_PLATFORM_HINT=auto")
    elif [ "$have_x" = 1 ]; then
        env_lines+=("XDG_SESSION_TYPE=x11" "OZONE_PLATFORM=x11" \
                    "GDK_BACKEND=x11" "QT_QPA_PLATFORM=xcb")
    fi

    # gui-env is sourced by the login shell, so quote values (they may hold ';'/',').
    { for l in "${env_lines[@]}"; do
          printf 'export %s="%s"\n' "${l%%=*}" "${l#*=}"
      done; } > "$GUI_ENV_FILE"
    return 0
}

# Run tmux inside the running container as uid 1000, non-interactively, so the
# host can query/list/kill sessions. Goes through the root helper (leader-PID +
# nsenter, dropped to uid 1000) so output is a clean pipe and no broad sudo is used.
container_tmux() {
    sudo "$HELPER_PATH" tmux "$@"
}

# Best-effort session listing for shell completion: `sudo -n` on the NOPASSWD helper
# never prompts. Prints nothing when the box is down — completion just offers none.
list_sessions_quiet() {
    sudo -n "$HELPER_PATH" tmux list-sessions -F '#{session_name}' 2>/dev/null || return 0
}

# Swallow any buffered keystrokes on /dev/tty (e.g. auto-repeat from a held arrow
# key) so leftover bytes don't leak to the shell as "^[[A" once a menu returns and
# the terminal is back in cooked/echo mode. Reads in chunks with a tiny timeout;
# stops as soon as the buffer is empty (one short timeout at the end).
_drain_tty() {
    local _junk
    while IFS= read -rsn64 -t 0.01 _junk < /dev/tty 2>/dev/null; do :; done
    return 0
}

# Arrow-key selectable menu drawn on /dev/tty (independent of stdout/stderr
# redirection). Navigate with up/down (or k/j), Enter selects. Sets MENU_CHOICE.
#
# Optional inline input row: set MENU_INPUT_ROW=1 before calling to mark the LAST
# option as a "type-on-select" field — its text is the prompt label (e.g.
# "+ new session: "). Set MENU_INPUT_DEFAULT to prefill it. When that row is
# selected it shows a block cursor and accepts editing (printable keys, Backspace
# down to empty); ↑/↓ still move off it and back with the text preserved. Enter on
# it confirms; the buffer lands in MENU_INPUT. Non-input rows behave as before.
# Set MENU_DELETE=1 before calling to let 'd' on a normal (non-input) row return
# with MENU_ACTION=delete and MENU_CHOICE=that row, so the caller can delete it and
# re-open the menu. MENU_ADD=1 ('a' → MENU_ACTION=add), MENU_RENAME=1 ('r' →
# MENU_ACTION=rename, MENU_CHOICE=row) and MENU_QUIT=1 ('q' cancels) work the same
# way. All cleared each call.
MENU_CHOICE=0
MENU_INPUT=""
MENU_INPUT_DEFAULT=""
MENU_ACTION=""
MENU_CANCELLED=0
choose_menu() {
    local prompt="$1"; shift
    local options=("$@")
    local input_row="${MENU_INPUT_ROW:-0}"
    local buf="${MENU_INPUT_DEFAULT:-}" delete_on="${MENU_DELETE:-0}"
    local cancel_on="${MENU_CANCEL:-0}" add_on="${MENU_ADD:-0}" quit_on="${MENU_QUIT:-0}"
    local rename_on="${MENU_RENAME:-0}" start_sel="${MENU_SELECT:-0}"
    MENU_INPUT_ROW=0; MENU_INPUT=""; MENU_INPUT_DEFAULT=""; MENU_DELETE=0; MENU_ACTION=""
    MENU_CANCEL=0; MENU_CANCELLED=0; MENU_ADD=0; MENU_QUIT=0; MENU_RENAME=0; MENU_SELECT=0
    # Optional navigable quit row (set MENU_CANCEL=1). Skipped when the last row is an
    # inline input field, which must stay last; 'q' and Ctrl-C cancel there too.
    local quit_idx=-1
    if [ "$cancel_on" = 1 ] && [ "$input_row" != 1 ]; then
        options+=("✗ quit"); quit_idx=$(( ${#options[@]} - 1 ))
    fi
    local selected=0 key count=${#options[@]} first=1 i
    local last=$(( ${#options[@]} - 1 ))
    # Start highlighted on a caller-requested row (MENU_SELECT), clamped in range.
    [ "$start_sel" -gt 0 ] 2>/dev/null && [ "$start_sel" -lt "$count" ] && selected=$start_sel
    # 'q' or the quit row cancels (sets MENU_CANCELLED). Ctrl-C is handled globally
    # (see _on_interrupt) — it restores the cursor and exits cleanly.
    local cancelled=0

    printf '\e[?25l' > /dev/tty                  # hide cursor (block cursor is drawn)
    echo "$prompt" > /dev/tty
    # redraw=0 coalesces held-key auto-repeat: after a move we skip the redraw when
    # more input is already queued, so the buffer drains at read speed (no lag).
    local redraw=1
    while true; do
        if [ "$redraw" = 1 ]; then
            [ -z "$first" ] && printf '\e[%dA' "$count" > /dev/tty
            first=
            for i in "${!options[@]}"; do
                if [ "$input_row" = 1 ] && [ "$i" -eq "$last" ]; then
                    # Input row: label + live buffer, with a reverse-video block cursor
                    # when it's the selected row so it reads as an editable field.
                    if [ "$i" -eq "$selected" ]; then
                        printf '\e[K  \e[36m❯ %s%s\e[0m\e[7m \e[0m\n' "${options[$i]}" "$buf" > /dev/tty
                    else
                        printf '\e[K    %s%s\n' "${options[$i]}" "$buf" > /dev/tty
                    fi
                elif [ "$i" -eq "$selected" ]; then
                    printf '\e[K  \e[36m❯ %s\e[0m\n' "${options[$i]}" > /dev/tty
                else
                    printf '\e[K    %s\n' "${options[$i]}" > /dev/tty
                fi
            done
        fi
        redraw=1
        IFS= read -rsn1 key < /dev/tty || true
        if [ "$key" = $'\e' ]; then
            # Short timeout: a lone ESC returns instead of blocking; a real arrow's
            # "[A"/"[B" bytes are already queued, so this reads them immediately.
            read -rsn2 -t 0.05 key < /dev/tty || key=""
            case "$key" in
                '[A'|'OA') selected=$(( (selected - 1 + count) % count )) ;;
                '[B'|'OB') selected=$(( (selected + 1) % count )) ;;
            esac
            read -t 0 < /dev/tty 2>/dev/null && redraw=0     # more queued → coalesce
            continue
        fi
        # Editing the input row: printable keys append, Backspace deletes (to
        # empty), Enter confirms. ↑/↓ were handled above, so you can leave & return.
        if [ "$input_row" = 1 ] && [ "$selected" -eq "$last" ]; then
            case "$key" in
                ''|$'\n'|$'\r') MENU_INPUT="$buf"; MENU_CHOICE=$last
                                _drain_tty; printf '\e[?25h' > /dev/tty; return 0 ;;
                $'\177'|$'\b')  buf="${buf%?}" ;;
                *)              buf="$buf$key" ;;
            esac
            continue
        fi
        case "$key" in
            k) selected=$(( (selected - 1 + count) % count ))
               read -t 0 < /dev/tty 2>/dev/null && redraw=0 ;;
            j) selected=$(( (selected + 1) % count ))
               read -t 0 < /dev/tty 2>/dev/null && redraw=0 ;;
            q|Q) { [ "$cancel_on" = 1 ] || [ "$quit_on" = 1 ]; } && { cancelled=1; break; } ;;
            a|A) if [ "$add_on" = 1 ]; then
                     MENU_CHOICE=-1; MENU_ACTION=add
                     _drain_tty; printf '\e[?25h' > /dev/tty; return 0
                 fi ;;
            r|R) if [ "$rename_on" = 1 ]; then
                     MENU_CHOICE=$selected; MENU_ACTION=rename
                     _drain_tty; printf '\e[?25h' > /dev/tty; return 0
                 fi ;;
            d|D) if [ "$delete_on" = 1 ]; then
                     MENU_CHOICE=$selected; MENU_ACTION=delete
                     _drain_tty; printf '\e[?25h' > /dev/tty; return 0
                 fi ;;
            ''|$'\n'|$'\r')
                [ "$quit_idx" -ge 0 ] && [ "$selected" -eq "$quit_idx" ] && cancelled=1
                break ;;
        esac
    done
    _drain_tty
    printf '\e[?25h' > /dev/tty                   # show cursor
    if [ "$cancelled" = 1 ]; then MENU_CANCELLED=1; MENU_CHOICE=-1; return 0; fi
    MENU_CHOICE=$selected
    return 0
}

# Multi-select checklist on /dev/tty. ↑/↓ (or j/k) move, Space toggles, 'a' checks
# all, Enter confirms, 'q' cancels. Fills MULTI_CHOICES with the checked options
# (empty on cancel or if nothing checked). $1 = prompt, rest = options.
# Set MULTI_PRECHECK=1 to start every option checked (e.g. a "keep which?" list).
MULTI_CHOICES=()
choose_multi() {
    local prompt="$1"; shift
    local options=("$@")
    local selected=0 key count=${#options[@]} first=1 i box
    local pre="${MULTI_PRECHECK:-0}"; MULTI_PRECHECK=0
    local checked=()
    for i in "${!options[@]}"; do checked[$i]=$pre; done
    MULTI_CHOICES=()

    printf '\e[?25l' > /dev/tty
    echo "$prompt" > /dev/tty
    printf '  \e[2mSpace toggle · a all · Enter confirm · q cancel\e[0m\n' > /dev/tty
    local redraw=1
    while true; do
        if [ "$redraw" = 1 ]; then
            [ -z "$first" ] && printf '\e[%dA' "$count" > /dev/tty
            first=
            for i in "${!options[@]}"; do
                box="[ ]"; [ "${checked[$i]}" = 1 ] && box="[x]"
                if [ "$i" -eq "$selected" ]; then
                    printf '\e[K  \e[36m❯ %s %s\e[0m\n' "$box" "${options[$i]}" > /dev/tty
                else
                    printf '\e[K    %s %s\n' "$box" "${options[$i]}" > /dev/tty
                fi
            done
        fi
        redraw=1
        IFS= read -rsn1 key < /dev/tty
        if [ "$key" = $'\e' ]; then
            read -rsn2 -t 0.05 key < /dev/tty || key=""
            case "$key" in
                '[A'|'OA') selected=$(( (selected - 1 + count) % count )) ;;
                '[B'|'OB') selected=$(( (selected + 1) % count )) ;;
            esac
            read -t 0 < /dev/tty 2>/dev/null && redraw=0     # coalesce held-key repeat
            continue
        fi
        case "$key" in
            ' ') checked[$selected]=$(( 1 - checked[selected] )) ;;
            k)   selected=$(( (selected - 1 + count) % count ))
                 read -t 0 < /dev/tty 2>/dev/null && redraw=0 ;;
            j)   selected=$(( (selected + 1) % count ))
                 read -t 0 < /dev/tty 2>/dev/null && redraw=0 ;;
            a|A) for i in "${!options[@]}"; do checked[$i]=1; done ;;
            ''|$'\n'|$'\r')
                for i in "${!options[@]}"; do
                    [ "${checked[$i]}" = 1 ] && MULTI_CHOICES+=("${options[$i]}")
                done
                break ;;
            q|Q) MULTI_CHOICES=(); break ;;
        esac
    done
    _drain_tty
    printf '\e[?25h' > /dev/tty
}

# Read one validated line from /dev/tty into FIELD. $1 = label, $2 = anchored
# regex the input must match (default: any non-empty), $3 = error hint. Empty
# input cancels (returns 1). Re-prompts until valid or cancelled.
FIELD=""
prompt_field() {
    local label="$1" re="${2:-.+}" err="${3:-invalid input}" allow_empty="${4:-0}"
    FIELD=""
    while true; do
        # read -e → readline editing (←/→ to move within the line, etc.); the label
        # is readline's prompt so its cursor math stays correct, and 2>/dev/tty keeps
        # the prompt+echo on the terminal even if the script's stderr is redirected.
        IFS= read -rep "$label" FIELD < /dev/tty 2>/dev/tty || return 1
        # Empty input cancels — unless allow_empty=1, where it's an accepted value
        # (e.g. an enter-only scheduled command); cancel there is Ctrl-C / EOF.
        [ -z "$FIELD" ] && { [ "$allow_empty" = 1 ] && return 0 || return 1; }
        [[ "$FIELD" =~ ^($re)$ ]] && return 0
        printf '  \e[31m%s\e[0m\n' "$err" > /dev/tty
    done
}

# Generic live "manager" screen (item 7). Arrow/j/k move, 'a' add, 'd' delete the
# highlighted row, 'q'/Enter quit. Args:
#   $1 title   $2 load_fn   $3 add_fn   $4 del_fn   [$5 del_verb (default "delete")]
# load_fn fills the parallel arrays M_IDS (delete handles) and M_ROWS (display).
# add_fn/del_fn are run in a subshell (`( ) || true`) so a log_error's exit ends
# only that action, not the whole manager. del_verb relabels the delete action in
# the hint and the confirmation (e.g. "detach" for shares — nothing is deleted).
#
# The screen is NEVER wiped (no \e[2J): the manager prints inline and scrolls like
# 'waterbox start', preserving whatever was on the terminal before. Navigation
# redraws the list in place (cursor up over the previous block); an add/delete
# action prints its wizard below (scrolling), then the list is redrawn fresh.
M_IDS=(); M_ROWS=(); M_SEL=0
task_manager() {
    local title="$1" load_fn="$2" add_fn="$3" del_fn="$4" del_verb="${5:-delete}" live="${6:-0}" warn_fn="${7:-}"
    local key n i first=1 drawn=0 rc redraw=1
    M_SEL=0
    printf '\e[?25l' > /dev/tty                    # hide cursor while navigating
    while true; do
        # redraw=0 coalesces held-key auto-repeat (see choose_menu): skip the reload
        # + redraw while more input is queued, so navigation stays snappy under a
        # held arrow instead of lagging behind a backlog of keystrokes.
        if [ "$redraw" = 1 ]; then
            M_IDS=(); M_ROWS=()
            "$load_fn"
            n=${#M_ROWS[@]}
            [ "$M_SEL" -ge "$n" ] && M_SEL=$(( n > 0 ? n - 1 : 0 ))

            # Redraw in place over the previous block (unless drawing fresh).
            [ "$first" = 0 ] && printf '\e[%dA' "$drawn" > /dev/tty
            first=0; drawn=0
            printf '\r\e[K\e[36m%s\e[0m\n' "$title" > /dev/tty; drawn=$((drawn + 1))
            printf '\r\e[K  \e[2m↑/↓ move · a add · d %s · q quit\e[0m\n' "$del_verb" > /dev/tty; drawn=$((drawn + 1))
            printf '\r\e[K\n' > /dev/tty; drawn=$((drawn + 1))
            if [ "$n" -eq 0 ]; then
                printf '\r\e[K    \e[2m(none yet — press a to add)\e[0m\n' > /dev/tty; drawn=$((drawn + 1))
            else
                for i in "${!M_ROWS[@]}"; do
                    if [ "$i" -eq "$M_SEL" ]; then
                        printf '\r\e[K  \e[36m❯ %s\e[0m\n' "${M_ROWS[$i]}" > /dev/tty
                    else
                        printf '\r\e[K    %s\n' "${M_ROWS[$i]}" > /dev/tty
                    fi
                    drawn=$((drawn + 1))
                done
            fi
            printf '\e[J' > /dev/tty        # drop any stale rows below (e.g. a live shrink)
        fi
        redraw=1

        # Live screens (wake-claude / schedule-command) refresh the "time left" every
        # second: a 1s read timeout re-runs the loop (redraw in place) vs blocking.
        rc=0
        if [ "$live" = 1 ]; then
            IFS= read -rsn1 -t 1 key < /dev/tty || rc=$?
            [ "$rc" -gt 128 ] && continue    # timed out → tick the countdown
        else
            IFS= read -rsn1 key < /dev/tty
        fi
        case "$key" in
            $'\e')
                read -rsn2 -t 0.05 key < /dev/tty || key=""
                case "$key" in
                    '[A'|'OA') [ "$n" -gt 0 ] && M_SEL=$(( (M_SEL - 1 + n) % n )) ;;
                    '[B'|'OB') [ "$n" -gt 0 ] && M_SEL=$(( (M_SEL + 1) % n )) ;;
                esac
                read -t 0 < /dev/tty 2>/dev/null && redraw=0 ;;
            k) [ "$n" -gt 0 ] && M_SEL=$(( (M_SEL - 1 + n) % n ))
               read -t 0 < /dev/tty 2>/dev/null && redraw=0 ;;
            j) [ "$n" -gt 0 ] && M_SEL=$(( (M_SEL + 1) % n ))
               read -t 0 < /dev/tty 2>/dev/null && redraw=0 ;;
            a|A)
                printf '\e[?25h\n' > /dev/tty
                ( "$add_fn" ) || true
                printf '\e[?25l\n' > /dev/tty
                first=1 ;;                          # redraw fresh below the wizard
            d|D)
                if [ "$n" -gt 0 ]; then
                    printf '\e[?25h\n' > /dev/tty
                    # A warn_fn (only shares set one) prints a caution AND returns 0
                    # when the action is risky → default No; otherwise it's safe →
                    # default Yes (Enter confirms). Managers with no warn_fn keep the
                    # cautious default No.
                    local defyes=0 ans=""
                    if [ -n "$warn_fn" ]; then
                        if ( "$warn_fn" "${M_IDS[$M_SEL]}" ); then defyes=0; else defyes=1; fi
                    fi
                    if [ "$defyes" = 1 ]; then
                        printf '%s "\e[36m%s\e[0m"? [Y/n] ' "${del_verb^}" "${M_ROWS[$M_SEL]}" > /dev/tty
                        IFS= read -r ans < /dev/tty || true
                        case "$ans" in [Nn]*) ans="" ;; *) ans="y" ;; esac
                    else
                        printf '%s "\e[36m%s\e[0m"? [y/N] ' "${del_verb^}" "${M_ROWS[$M_SEL]}" > /dev/tty
                        IFS= read -r ans < /dev/tty || true
                        case "$ans" in [Yy]*) ans="y" ;; *) ans="" ;; esac
                    fi
                    [ "$ans" = y ] && ( "$del_fn" "${M_IDS[$M_SEL]}" ) || true
                    printf '\e[?25l\n' > /dev/tty
                    first=1
                fi ;;
            q|Q|''|$'\n'|$'\r') break ;;
        esac
    done
    _drain_tty
    printf '\e[?25h' > /dev/tty                     # restore cursor; leave list in place
}

# --- Sessions & their scheduled commands (req: session lifecycle) --------------
# Live tmux session names inside the box (sorted).
_live_sessions() {
    container_tmux list-sessions -F '#{session_name}' 2>/dev/null | sort
}

# Print the schedule-command ids whose target session == $1 (the session is the
# first token of the timer's "# waterbox: <session> @ <time> <mode>" info line).
_schedules_for_session() {
    local want="$1" f b id info
    for f in "$JAIL_ROOT$TASK_ETC/waterbox-schd-com-"*.timer; do
        [ -e "$f" ] || continue
        b=$(basename "$f" .timer); id="${b#waterbox-}"
        info=$(grep -m1 '^# waterbox:' "$f" 2>/dev/null | sed 's/^# waterbox: //')
        [ "${info%% @ *}" = "$want" ] && echo "$id"
    done
}

# Remove every schedule-command targeting session $1 (req 14).
_remove_session_schedules() {
    local sess="$1" id
    while IFS= read -r id; do
        [ -n "$id" ] || continue
        _sched_remove "$id"
    done < <(_schedules_for_session "$sess")
}

# Remove ALL schedule-commands (used when every session dies: stop/reset).
_remove_all_schedules() {
    local f b id
    for f in "$JAIL_ROOT$TASK_ETC/waterbox-schd-com-"*.timer; do
        [ -e "$f" ] || continue
        b=$(basename "$f" .timer); id="${b#waterbox-}"
        _sched_remove "$id"
    done
}

# List live sessions and the count of scheduled commands each would take down.
# Returns 1 if there are no live sessions (nothing to warn about).
_print_session_impact() {
    local sessions=() s cnt
    while IFS= read -r s; do [ -n "$s" ] && sessions+=("$s"); done < <(_live_sessions)
    [ "${#sessions[@]}" -eq 0 ] && return 1
    for s in "${sessions[@]}"; do
        cnt=$(_schedules_for_session "$s" | grep -c . || true)   # grep -c prints 0, exits 1
        [ "${cnt:-0}" -gt 0 ] \
            && echo "  - $s   ($cnt scheduled command(s) will be removed)" \
            || echo "  - $s"
    done
    return 0
}

# Confirm (y/N) before an action ends live sessions (req 10). No sessions → yes.
_confirm_kill_sessions() {
    local what="${1:-end}" ans
    _print_session_impact > /dev/tty 2>&1 || return 0
    printf 'This will %s the live session(s) above and remove their scheduled commands.\nProceed? [y/N] ' "$what" > /dev/tty
    IFS= read -r ans < /dev/tty || return 1
    [[ "$ans" == [Yy]* ]]
}

# The suggested default name for a brand-new session: the basename of the
# directory the user launched from, sanitized to tmux-legal chars (letters,
# digits, - and _). Falls back to $TMUX_SESSION ("box") at $HOME or when nothing
# usable remains. The caller still auto-suffixes a collision (proj, proj-2, …).
_default_session_base() {
    local dir="$PWD" base
    if [ -z "$dir" ] || [ "$dir" = "$HOME" ]; then
        printf '%s' "$TMUX_SESSION"; return
    fi
    base="${dir##*/}"                    # basename of the launch directory
    base="${base//[^A-Za-z0-9_-]/-}"     # tmux forbids '.', ':', spaces, …
    while [ "${base#-}" != "$base" ]; do base="${base#-}"; done  # trim leading -
    while [ "${base%-}" != "$base" ]; do base="${base%-}"; done  # trim trailing -
    [ -n "$base" ] || base="$TMUX_SESSION"
    printf '%s' "$base"
}

# Echo a session name that isn't currently live: <base>, then <base>-2, -3, … — the
# same collision suffixing the picker's default uses, for the non-interactive
# `--here` path. One _live_sessions snapshot (cheap; collisions are rare).
_free_session_name() {
    local base="$1" name="$1" n=2 live
    live="$(_live_sessions)"
    while printf '%s\n' "$live" | grep -qxF "$name"; do name="$base-$n"; n=$((n + 1)); done
    printf '%s' "$name"
}

# If an existing share equals or contains $1 (a realpath), echo where it's reachable
# inside the box relative to the workspace — shared /home/u/work mounts as
# workspace/work, so /home/u/work/proj → "work/proj" — and return 0; else return 1.
# Lets --here reuse an ancestor share instead of adding an overlapping one, and lets
# the TUI skip offering a dir that's already covered.
_covering_subdir() {
    local rp="$1" line
    [ -s "$SHARE_LIST" ] || return 1
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        [ "$rp" = "$line" ] && { printf '%s' "$(basename "$line")"; return 0; }
        case "$rp" in
            "$line"/*) printf '%s/%s' "$(basename "$line")" "${rp#"$line"/}"; return 0 ;;
        esac
    done < "$SHARE_LIST"
    return 1
}

# After naming a NEW session in the picker, offer to share the launch directory —
# only when it isn't $HOME, isn't already shared, and passes the same security policy
# as `share add`. New shares are mounted live even with private users. Never fatal:
# declined or ineligible → silent skip.
_maybe_offer_share() {
    local here rp ans
    here="$PWD"
    [ -n "$here" ] && [ "$here" != "$HOME" ] || return 0
    rp=$(realpath "$here" 2>/dev/null) || return 0
    [ "$rp" != "$(realpath "$HOME" 2>/dev/null || echo "$HOME")" ] || return 0
    _covering_subdir "$rp" >/dev/null 2>&1 && return 0        # already shared (or under one)
    _host_share_allowed "$rp" || return 0                     # not shareable → don't ask
    printf "Share this directory '%s' into the box (as %s/%s)? [y/N] " \
        "$here" "$CONTAINER_WORKSPACE" "$(basename "$rp")" > /dev/tty
    IFS= read -r ans < /dev/tty || return 0
    [[ "$ans" == [Yy]* ]] || return 0
    manage_share add "$rp"
}

# Prompt for a NEW session name (Enter alone accepts the suggested default). Sets
# NEW_SESSION to a validated, unique name; returns 1 only on read failure (EOF).
# tmux forbids '.' and ':', so we constrain to letters/digits/-/_ and auto-suffix
# a collision (box, box-2, …). $1 = the suggested default name.
NEW_SESSION=""
_prompt_new_session() {
    local default_name="$1" name base k
    NEW_SESSION=""
    # read -e → readline line editing (←/→ to edit, etc.); prompt kept plain so
    # readline's cursor math stays correct; 2>/dev/tty keeps it on the terminal.
    IFS= read -rep "New session name [$default_name]: " name < /dev/tty 2>/dev/tty || return 1
    name="${name:-$default_name}"
    if ! [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]]; then
        log_warn "Invalid name '$name' (letters, digits, - or _); using '$default_name'."
        name="$default_name"
    fi
    # '=' forces an EXACT match — a bare '-t box' would prefix-match 'box-2' and
    # wrongly report a collision.
    base="$name"; k=2
    while container_tmux has-session -t "=$name" 2>/dev/null; do
        name="$base-$k"; k=$((k + 1))
    done
    NEW_SESSION="$name"
    return 0
}

# Rename a live tmux session and repoint any schedule-command timers targeting it
# (their unit files are root-owned in the rootfs, so the helper does the repoint).
# $1 = current name. Prompts for the new one; no-op on empty/unchanged/invalid/dup.
# Sets KEEP_SESSION to the name the caller should keep highlighted afterwards (the
# new name on success, the old one on any no-op) so the picker doesn't jump away.
KEEP_SESSION=""
_rename_session() {
    local old="$1" new
    KEEP_SESSION="$old"
    # -i pre-fills the field with the current name so you EDIT it instead of retyping
    # (readline's Ctrl-w / Ctrl-u clear a word / the whole line); Enter unchanged = no-op.
    IFS= read -rep "New name for '$old': " -i "$old" new < /dev/tty 2>/dev/tty || return 0
    new="${new:-$old}"
    [ "$new" = "$old" ] && { log_info "Name unchanged."; return 0; }
    if ! [[ "$new" =~ ^[A-Za-z0-9_-]+$ ]]; then
        log_warn "Invalid name '$new' (letters, digits, - or _ only)."; return 0
    fi
    # '=' forces an exact match so 'usa-trip' isn't reported as taken just because
    # 'usa-trip0' exists (a bare target prefix-matches).
    if container_tmux has-session -t "=$new" 2>/dev/null; then
        log_warn "A session named '$new' already exists."; return 0
    fi
    container_tmux rename-session -t "=$old" "$new" 2>/dev/null \
        || { log_warn "Rename failed (is '$old' still live?)."; return 0; }
    _helper_current && run_priv sched-rename "$old" "$new" >/dev/null 2>&1 || true
    KEEP_SESSION="$new"
    log_info "Renamed session '$old' → '$new' (its scheduled commands were repointed)."
}

# Pick a tmux session inside the running container, then exec an attached shell.
# 'a' creates a new session (name prompt), 'd' kills the highlighted one (after y/N)
# and cleans up its scheduled commands (req 5/14), 'q'/Ctrl-C quits. With no live
# sessions yet, we skip the picker and go straight to creating one.
# $1 (optional): a target session name (`waterbox start <name>`) — attach it if live,
# else create it, with no picker at all.
# --- Self-update ---------------------------------------------------------------
# True when A is a strictly-newer version than B (numeric/dotted, e.g. 1.10 > 1.9).
_version_gt() {
    [ "$1" = "$2" ] && return 1
    [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" = "$1" ]
}

# Fire-and-forget upstream version probe, throttled to once per UPDATE_CHECK_INTERVAL.
# Touches the cache up front so a failed/offline probe doesn't re-run every launch;
# a successful probe overwrites it with the upstream version; a failed one records a
# short error marker. Fully detached — never blocks the picker, all output discarded.
# The notice below reports the result on the next launch.
_spawn_update_check() {
    local now mtime
    if [ -f "$UPDATE_CHECK_FILE" ]; then
        now=$(date +%s 2>/dev/null || echo 0)
        mtime=$(stat -c %Y "$UPDATE_CHECK_FILE" 2>/dev/null || echo 0)
        [ $((now - mtime)) -ge "$UPDATE_CHECK_INTERVAL" ] || return 0
    fi
    touch "$UPDATE_CHECK_FILE" 2>/dev/null || return 0   # reset throttle regardless of outcome
    (
        set +e
        local remote
        remote=$(curl -fsSL --max-time 8 "$UPDATE_URL" 2>/dev/null \
                 | grep -m1 '^WATERBOX_VERSION=' | cut -d'"' -f2)
        if [ -n "$remote" ]; then
            printf '%s\n' "$remote" > "$UPDATE_CHECK_FILE"
        else
            printf '%s\n' "$UPDATE_CHECK_ERROR" > "$UPDATE_CHECK_FILE"
        fi
    ) >/dev/null 2>&1 &
    disown 2>/dev/null || true
}

# Prints the cached upstream version (exit 0) when it's newer than ours, else exit 1.
_update_notice() {
    local remote
    [ -f "$UPDATE_CHECK_FILE" ] || return 1
    remote=$(cat "$UPDATE_CHECK_FILE" 2>/dev/null)
    [ -n "$remote" ] || return 1
    if [ "$remote" = "$UPDATE_CHECK_ERROR" ]; then
        printf '%s' "$UPDATE_CHECK_ERROR"
        return 0
    fi
    _version_gt "$remote" "$WATERBOX_VERSION" || return 1
    printf '%s' "$remote"
}

# `waterbox update`: fetch the canonical script and atomically replace ourselves.
# Never truncate SELF_PATH in place: Bash may still be reading it, and continuing
# at the old byte offset in a differently-sized new script can execute random text.
self_update() {
    local tmp remote update_dir stage mode owner group
    log_info "Checking $UPDATE_URL ..."
    tmp=$(mktemp)
    if ! curl -fsSL --max-time 20 "$UPDATE_URL" -o "$tmp" 2>/dev/null || [ ! -s "$tmp" ]; then
        rm -f "$tmp"
        log_error "Couldn't download Waterbox. The script URL may have changed; open $PROJECT_URL to investigate."
    fi
    # Sanity-check it's actually a waterbox script before overwriting ourselves.
    if ! head -n1 "$tmp" | grep -q '^#!/usr/bin/env bash' || ! grep -q '^WATERBOX_VERSION=' "$tmp"; then
        rm -f "$tmp"
        log_error "The update URL did not return a Waterbox script. Open $PROJECT_URL to investigate."
    fi
    remote=$(grep -m1 '^WATERBOX_VERSION=' "$tmp" | cut -d'"' -f2)
    printf '%s\n' "${remote:-$WATERBOX_VERSION}" > "$UPDATE_CHECK_FILE" 2>/dev/null || true
    if [ "$remote" = "$WATERBOX_VERSION" ]; then
        rm -f "$tmp"; log_success "Already on the latest waterbox (v$WATERBOX_VERSION)."; return 0
    fi
    if ! _version_gt "$remote" "$WATERBOX_VERSION"; then
        rm -f "$tmp"; log_warn "Your waterbox (v$WATERBOX_VERSION) is ahead of upstream (v$remote) — leaving it as is."; return 0
    fi
    # Build the replacement beside SELF_PATH, then rename it over the old inode.
    # The running Bash keeps reading the intact old inode; future invocations open
    # the complete new one. Preserve ownership/mode, including root-owned installs.
    update_dir=$(dirname -- "$SELF_PATH")
    mode=$(stat -c %a "$SELF_PATH")
    owner=$(stat -c %u "$SELF_PATH")
    group=$(stat -c %g "$SELF_PATH")
    stage=""
    if [ -w "$update_dir" ] && [ "$owner" = "$(id -u)" ]; then
        stage=$(mktemp "$update_dir/.waterbox-update.XXXXXX") \
            || { rm -f "$tmp"; log_error "Couldn't prepare an update beside $SELF_PATH."; }
        if ! install -m "$mode" "$tmp" "$stage" || ! mv -f -- "$stage" "$SELF_PATH"; then
            rm -f "$stage" "$tmp"
            log_error "Couldn't write $SELF_PATH — check permissions or update it manually."
        fi
    else
        stage=$(sudo mktemp "$update_dir/.waterbox-update.XXXXXX") \
            || { rm -f "$tmp"; log_error "Couldn't prepare an update beside $SELF_PATH."; }
        if ! sudo install -m "$mode" -o "$owner" -g "$group" "$tmp" "$stage" \
           || ! sudo mv -f -- "$stage" "$SELF_PATH"; then
            sudo rm -f -- "$stage" 2>/dev/null || true
            rm -f "$tmp"
            log_error "Couldn't write $SELF_PATH — check permissions or update it manually."
        fi
    fi
    rm -f "$tmp"
    log_success "Updated waterbox: v$WATERBOX_VERSION → v$remote. The next 'waterbox start' syncs the box to it."
}

attach_session() {
    # GUI env reaches the shell via the in-box /etc/waterbox/gui-env (sourced by
    # .zshrc), so nothing to forward here beyond an optional API key.
    local want="${1:-}" target sessions=() s dn default_name base_name keep_name="" ki
    # `start --here`: skip the picker — open a brand-new session named after the launch
    # dir (dir, dir-2, …), landing inside its shared copy when start_sandbox mounted one
    # (WB_START_SUBDIR); empty subdir → the default workspace (couldn't/needn't share).
    if [ "${WB_HERE:-0}" = 1 ]; then
        target="$(_free_session_name "$(_default_session_base)")"
        if [ -n "${WB_START_SUBDIR:-}" ]; then
            log_info "Creating session '$target' in $CONTAINER_WORKSPACE/$WB_START_SUBDIR."
        else
            log_info "Creating new session '$target'."
        fi
        exec sudo "$HELPER_PATH" shell "$target" "${ANTHROPIC_API_KEY:-}" "${WB_START_SUBDIR:-}"
    fi
    if [ -n "$want" ]; then
        # No leading '-': such a name would be indistinguishable from a flag here and
        # would reach grep/tmux/systemd as one (an unrecognised `waterbox start --foo`
        # should be rejected, not turned into a session).
        [[ "$want" =~ ^[A-Za-z0-9._][A-Za-z0-9._-]*$ ]] \
            || log_error "Invalid session name '$want' (letters, digits, . _ - only, not starting with '-'). See 'waterbox start --help'."
        # `--`: belt-and-braces so the name is never parsed as a grep option.
        if _live_sessions | grep -qxF -- "$want"; then log_info "Attaching to '$want'."
        else log_info "Creating new session '$want'."; fi
        exec sudo "$HELPER_PATH" shell "$want" "${ANTHROPIC_API_KEY:-}"
    fi
    # Reaching the picker: refresh the upstream-version cache in the background and, if
    # last run's probe found a newer release, drop one WARN above the menu (it stays put
    # — the menu only ever redraws its own rows). Never blocks; silent when up to date.
    _spawn_update_check
    local _newver
    if _newver="$(_update_notice)"; then
        if [ "$_newver" = "$UPDATE_CHECK_ERROR" ]; then
            log_warn "Couldn't check for updates. The script URL may have changed; open $PROJECT_URL to investigate." > /dev/tty
        else
            log_warn "waterbox v$_newver is available (you have v$WATERBOX_VERSION) — run 'waterbox update'." > /dev/tty
        fi
    fi
    while true; do
        sessions=()
        while IFS= read -r s; do
            [ -n "$s" ] && sessions+=("$s")
        done < <(_live_sessions)

        # Next free auto name suggested for a brand-new session: the launch
        # directory's basename (box at $HOME), auto-suffixed on a collision
        # (proj, proj-2, …).
        base_name="$(_default_session_base)"
        default_name="$base_name"; dn=2
        while printf '%s\n' "${sessions[@]}" | grep -Fxq "$default_name"; do
            default_name="$base_name-$dn"; dn=$((dn + 1))
        done

        # No live sessions: nothing to pick — create the first one directly.
        if [ "${#sessions[@]}" -eq 0 ]; then
            _prompt_new_session "$default_name" || return 0
            target="$NEW_SESSION"; log_info "Creating new session '$target'."
            _maybe_offer_share
            break
        fi

        # Re-open on the row we were just acting on (after a rename/kill), not row 0.
        MENU_SELECT=0
        if [ -n "$keep_name" ]; then
            for ki in "${!sessions[@]}"; do
                [ "${sessions[$ki]}" = "$keep_name" ] && { MENU_SELECT=$ki; break; }
            done
            keep_name=""
        fi

        MENU_DELETE=1; MENU_ADD=1; MENU_QUIT=1; MENU_RENAME=1
        choose_menu "Select a session (↑/↓ move · Enter attach · a new · r rename · d kill · q quit):" \
            "${sessions[@]}"

        [ "$MENU_CANCELLED" = 1 ] && return 0        # 'q'/Ctrl-C → leave the box running

        # 'a' → name + create a new session.
        if [ "$MENU_ACTION" = add ]; then
            _prompt_new_session "$default_name" || continue
            target="$NEW_SESSION"; log_info "Creating new session '$target'."
            _maybe_offer_share
            break
        fi

        # 'r' on a session → rename it (and repoint its scheduled commands), re-loop
        # with the highlight kept on that session (new name on success, old on no-op).
        if [ "$MENU_ACTION" = rename ]; then
            _rename_session "${sessions[$MENU_CHOICE]}"
            keep_name="$KEEP_SESSION"
            continue
        fi

        # 'd' on a session → confirm, kill it + its schedules, re-loop. Keep the
        # highlight on a neighbour when it dies, or on the session itself if kept.
        if [ "$MENU_ACTION" = delete ]; then
            local victim="${sessions[$MENU_CHOICE]}" ans neighbor="" ci=$MENU_CHOICE
            if [ $((ci + 1)) -lt "${#sessions[@]}" ]; then neighbor="${sessions[$((ci + 1))]}"
            elif [ $((ci - 1)) -ge 0 ]; then neighbor="${sessions[$((ci - 1))]}"; fi
            printf "Kill session '%s' and its scheduled commands? [y/N] " "$victim" > /dev/tty
            IFS= read -r ans < /dev/tty || true
            if [[ "$ans" == [Yy]* ]]; then
                container_tmux kill-session -t "=$victim" 2>/dev/null || true
                _remove_session_schedules "$victim"
                log_info "Killed session '$victim'."
                keep_name="$neighbor"
            else
                keep_name="$victim"
            fi
            continue
        fi

        # Enter on an existing session → attach.
        target="${sessions[$MENU_CHOICE]}"
        log_info "Attaching to '$target'."
        break
    done

    # The helper 'shell' verb runs `machinectl shell … tmux new-session -A` (attach
    # if it exists, else create in the workspace). The optional API key is forwarded
    # as an -E env value inside the helper.
    exec sudo "$HELPER_PATH" shell "$target" "${ANTHROPIC_API_KEY:-}"
}

# --- Network setup on host ---
# The veth address/NAT/forwarding rules (DNAT 10.20.30.1 -> 127.0.0.1 so host
# loopback services are reachable inside; SOURCE-based MASQUERADE that survives a
# VPN route flip; FORWARD inserted ahead of killswitch DROPs) now live in the root
# helper's net_up/net_down — the same code path the unattended wake uses — so no broad
# sudo is needed. The 'boot' verb runs net_up after the container is up; 'down'
# runs net_down. These wrappers just reach the helper for the stop/reset paths.
teardown_host_network() {
    _helper_current && sudo -n "$HELPER_PATH" net-down 2>/dev/null || true
}

# Are all required host tools present? Fills MISSING_DEPS with any that aren't.
MISSING_DEPS=()
_check_host_deps() {
    local need=(systemd-nspawn machinectl systemd-run iptables nsenter ip curl tar zstd python3) c
    MISSING_DEPS=()
    for c in "${need[@]}"; do
        command -v "$c" >/dev/null 2>&1 || MISSING_DEPS+=("$c")
    done
    command -v gpg >/dev/null 2>&1 || command -v pacman-key >/dev/null 2>&1 || MISSING_DEPS+=("gpg")
    [ ${#MISSING_DEPS[@]} -eq 0 ]
}

# The rootfs needs nspawn's long-standing private-user ownership mapping, available
# on the Debian/Ubuntu/Mint systemd versions Waterbox supports. Share owner-mapping
# is implemented independently in the root helper, so it does not depend on the
# newer nspawn 256 `owneridmap` bind option.
_require_secure_nspawn() {
    systemd-nspawn --private-users-ownership=map --help >/dev/null 2>&1 \
        || log_error "This systemd-nspawn is too old for private-user rootfs mapping. Waterbox will not fall back to an unsafe host-root container."
}

# Preflight (mainly for non-Arch hosts, req 6): if a required host tool is missing,
# detect the package manager, show the install command, and offer to run it — rather
# than failing cryptically mid-bootstrap.
require_host_deps() {
    if _check_host_deps; then
        _require_secure_nspawn
        return 0
    fi
    log_warn "Missing required host tools: ${MISSING_DEPS[*]}"

    # The needed COMMANDS come from a small, distro-specific package set (a command
    # like systemd-nspawn ships in 'systemd-container' on Debian but 'systemd' on
    # Arch), so offer the whole recommended set for the detected package manager.
    local cmd=""
    if command -v apt-get >/dev/null 2>&1; then
        # ';' not '&&': a failed update (e.g. a broken source in sources.list.d) must
        # not stop the install, which usually still works from the cached lists.
        cmd="sudo apt-get update; sudo apt-get install -y systemd-container iptables iproute2 curl tar zstd gnupg python3"
    elif command -v pacman >/dev/null 2>&1; then
        cmd="sudo pacman -S --needed systemd iptables-nft iproute2 util-linux curl tar zstd gnupg python"
    elif command -v dnf >/dev/null 2>&1; then
        cmd="sudo dnf install -y systemd-container iptables iproute curl tar zstd gnupg2 python3"
    elif command -v zypper >/dev/null 2>&1; then
        cmd="sudo zypper install -y systemd-container iptables iproute2 curl tar zstd gpg2 python3"
    fi

    if [ -z "$cmd" ]; then
        log_warn "Couldn't detect your package manager. Install these, then retry:"
        log_info "  Debian/Mint: sudo apt install systemd-container iptables iproute2 curl tar zstd gnupg python3"
        log_info "  Arch:        sudo pacman -S --needed systemd iptables-nft iproute2 util-linux curl tar zstd gnupg python"
        log_error "Missing: ${MISSING_DEPS[*]}"
    fi

    log_info "Install them with:"
    echo "    $cmd"
    printf 'Run this now? [y/N] '
    local ans; IFS= read -r ans < /dev/tty || ans=""
    [[ "$ans" == [Yy]* ]] || log_error "Install the missing tools, then retry."

    eval "$cmd" || log_error "Install failed. Install the tools manually, then retry."
    _check_host_deps && { _require_secure_nspawn; log_success "All host dependencies present."; return 0; }
    log_error "Still missing: ${MISSING_DEPS[*]}. Install manually, then retry."
}

# --- Start: boot if needed, attach a shell ---
warn_unsafe_host_root() {
    echo -e "\e[1;31m[UNSAFE] Private-user isolation is OFF: container root is real host root.\e[0m"
    echo -e "\e[31m         A containment mistake can become full host compromise. This mode is for"
    echo -e "         unsupported live-media filesystems only and is never remembered."
    echo -e "         An unattended wake cannot cold-boot this mode after you stop it.\e[0m"
}

start_sandbox() {
    local want="${1:-}"        # optional target session (`waterbox start <name>`)
    # Reject a bad name (notably a mistyped flag: the global parser only consumes the
    # ones it knows, so `waterbox start --foo` arrives here as a session name) BEFORE
    # bootstrapping or booting — attach_session re-checks, but only at the very end.
    if [ -n "$want" ] && ! [[ "$want" =~ ^[A-Za-z0-9._][A-Za-z0-9._-]*$ ]]; then
        log_error "Invalid session name '$want' (letters, digits, . _ - only, not starting with '-'). See 'waterbox start --help'."
    fi
    require_host_deps
    bootstrap_sandbox
    ensure_host_privs    # immutable helper (narrow sudoers) + completion; no manual 'setup'
    if is_running; then
        local security_state
        security_state=$(run_priv security-state 2>/dev/null || echo legacy)
        case "$security_state" in
            secure)
                [ "$WATERBOX_UNSAFE_HOST_ROOT" != 1 ] \
                    || log_error "--unsafe-host-root was refused because the running box is securely user-namespaced."
                ;;
            unsafe-explicit)
                [ "$WATERBOX_UNSAFE_HOST_ROOT" = 1 ] \
                    || log_error "This box is running in explicit host-root mode. Rerun the same command with --unsafe-host-root to attach."
                ;;
            *)
                log_error "This running box lacks the private-user boundary and was not launched through the explicit unsafe mode. Stop it before continuing."
                ;;
        esac
    fi
    [ "$WATERBOX_UNSAFE_HOST_ROOT" = 1 ] && warn_unsafe_host_root

    # One-time pre-1.9 -> multi-agent profile move. Host-root maintenance of the
    # rootfs is allowed only while the box is down; "no tmux sessions" does not prove
    # a malicious/background process is gone.
    if _needs_agent_env_migration; then
        if ! is_running; then
            migrate_agent_env || log_warn "Account migration didn't complete; the old layout still works."
        else
            log_warn "Accounts still use the pre-1.9 layout. Run 'waterbox restart' to migrate safely."
        fi
    fi

    # Refresh managed files before boot, never by writing into a live,
    # box-controlled tree as host root. This closes symlink-swap races while keeping
    # ordinary cold starts self-updating.
    if ! is_running && ! _config_current; then
        log_info "Applying updated in-box config for this waterbox version..."
        refresh_config
    fi

    # `--here`: share the launch directory (unless it's $HOME or fails the security
    # policy) and steer attach into a fresh session opened inside it. Persist before
    # boot for a cold start; mount it immediately when the box was already running.
    local here_rp="" home_rp="" here_added=0 cover_sub="" box_was_running=0 existing=""
    is_running && box_was_running=1
    WB_HERE=0; WB_START_SUBDIR=""
    if [ "${WATERBOX_HERE:-0}" = 1 ]; then
        WB_HERE=1
        here_rp=$(realpath "$PWD" 2>/dev/null || echo "$PWD")
        home_rp=$(realpath "$HOME" 2>/dev/null || echo "$HOME")
        if [ "$here_rp" = "$home_rp" ]; then
            log_info "--here: you're in \$HOME — nothing to share; opening a new session."
        elif cover_sub=$(_covering_subdir "$here_rp"); then
            # Already reachable via an existing (possibly ancestor) share — reuse it,
            # don't add an overlapping one; just open the session at that subpath.
            WB_START_SUBDIR="$cover_sub"
            log_info "--here: '$here_rp' is already shared — opening in $CONTAINER_WORKSPACE/$cover_sub."
        elif _host_share_allowed "$here_rp"; then
            while IFS= read -r existing || [ -n "$existing" ]; do
                [ -n "$existing" ] || continue
                if [ "$(basename "$existing")" = "$(basename "$here_rp")" ]; then
                    log_warn "--here: '$existing' already uses $CONTAINER_WORKSPACE/$(basename "$here_rp"); opening without a new share."
                    existing="collision"
                    break
                fi
            done < "$SHARE_LIST"
            if [ "$existing" != collision ]; then
                mkdir -p "$CONFIG_DIR"
                echo "$here_rp" >> "$SHARE_LIST"
                WB_START_SUBDIR="$(basename "$here_rp")"; here_added=1
                log_info "--here: sharing '$here_rp' → $CONTAINER_WORKSPACE/$WB_START_SUBDIR."
            fi
        else
            log_warn "--here: can't share '$PWD' (only a dir inside your home, or one you own under /mnt, /media, /run/media). Opening a session without it."
        fi
    fi

    if is_running; then
        log_info "Sandbox already running, attaching..."
        [ "$WATERBOX_GUI" = "1" ] && [ ! -s "$GUI_BINDS_FILE" ] \
            && log_warn "GUI binds are set at boot — 'waterbox restart --gui' to enable them."
    else
        log_info "Booting sandbox as transient systemd unit '$MACHINE_NAME.service'..."

        # Detect the display server + write the GUI bind/env spec files as YOU
        # (needs your DISPLAY/XAUTHORITY). Clears them when --gui is absent.
        build_gui_bind_args

        # The root helper does the privileged boot: it validates the shares in
        # $SHARE_LIST and the GUI spec, binds the GPU when present, launches the
        # transient nspawn unit (KillMode=mixed so stop → clean poweroff), and
        # brings up the host network. No broad sudo, so a normal start is
        # passwordless once the helper is installed.
        local boot_args=(boot)
        [ "$WATERBOX_GUI" = "1" ] && boot_args+=(--gui)
        [ "$WATERBOX_NO_GPU" = "1" ] && boot_args+=(--no-gpu)
        [ "$WATERBOX_UNSAFE_HOST_ROOT" = "1" ] && boot_args+=(--unsafe-host-root)
        if ! run_priv "${boot_args[@]}" || ! is_running; then
            # A cold --here persists its new share before boot so the helper can
            # collect it. If that secure mount (or the boot) fails, do not leave a
            # poison entry that makes every later start fail too.
            if [ "$here_added" = 1 ]; then
                grep -vFx "$here_rp" "$SHARE_LIST" > "${SHARE_LIST}.tmp" || true
                mv "${SHARE_LIST}.tmp" "$SHARE_LIST"
            fi
            log_error "Sandbox failed to boot. Check: journalctl -u $MACHINE_NAME -e"
        fi
        log_success "Sandbox up. Host reachable inside as '$HOST_ALIAS' ($HOST_IP)."
    fi

    # Guarantee working DNS: the container's boot may leave /etc/resolv.conf pointing
    # at an unreachable stub (127.0.0.53). Feed the helper the host-derived servers +
    # public fallback; it only rewrites if the box currently can't resolve. Runs every
    # start, so a boot-time hijack is corrected before you attach.
    _container_nameservers | run_priv ensure-dns || true

    # A running rootfs is attacker-controlled, even if tmux has no visible sessions.
    # Never bridge it to host-root file writes; a cold start/restart refreshes safely.
    if ! _config_current; then
        log_warn "In-box config is out of date; run 'waterbox restart' to apply it safely."
    fi

    # Mount a NEWLY-added --here share only when the box was already up. A cold boot
    # mounted the collected list before returning, and stacking it again would hide
    # the first mount. On failure, roll back the persisted entry too.
    if [ "$WB_HERE" = 1 ] && [ "$here_added" = 1 ] && [ "$box_was_running" = 1 ]; then
        if ! run_priv bind-share "$here_rp"; then
            grep -vFx "$here_rp" "$SHARE_LIST" > "${SHARE_LIST}.tmp" || true
            mv "${SHARE_LIST}.tmp" "$SHARE_LIST"
            log_warn "Couldn't mount '$WB_START_SUBDIR' securely; the share was not added."
            WB_START_SUBDIR=""
        fi
    fi

    attach_session "$want"
}

restart_sandbox() {
    # Fail before taking a working box down if this host cannot boot the hardened
    # private-user configuration.
    require_host_deps
    stop_sandbox
    [ "$WB_CANCELLED" = 1 ] && { log_info "Restart cancelled."; return 0; }
    start_sandbox
}

# --- Stop ---
# Sets WB_CANCELLED=1 (and skips the poweroff) if the user declines the prompt that
# warns which live sessions + scheduled commands the stop would take down (req 10).
WB_CANCELLED=0
stop_sandbox() {
    WB_CANCELLED=0
    if is_running; then
        if ! _confirm_kill_sessions "stop"; then
            log_info "Stop cancelled."; WB_CANCELLED=1; return 0
        fi
        log_info "Powering off sandbox..."
        run_priv down \
            || log_error "Sandbox did not stop cleanly. It is still running; inspect: journalctl -u $MACHINE_NAME -e"
        # Do this after the verified stop. Besides avoiding writes against a live
        # rootfs, it also cleans schedules from a legacy pre-userns box without ever
        # entering that unsafe namespace as host root.
        _remove_all_schedules            # every session died → drop their schedules (req 14)
    else
        log_info "Sandbox not running."
        teardown_host_network            # clear any stray rules
    fi
    log_success "Sandbox stopped."
}

# --- Status ---
status_sandbox() {
    if is_running; then
        log_success "Sandbox is running."
        local status_args=()
        [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && status_args+=(--color)
        run_priv status "${status_args[@]}" 2>/dev/null || true
    else
        log_info "Sandbox is stopped."
    fi
}

# --- Reset ---
reset_sandbox() {
    # A reset becomes destructive only after this succeeds. In particular, do not
    # erase a legacy box on a host that cannot boot its private-user replacement.
    require_host_deps
    log_info "About to wipe the waterbox environment."
    if is_running && _print_session_impact > /dev/tty 2>&1; then
        log_warn "The live session(s) above will be ended."
    fi

    # Choose what survives the wipe (req 15). Pre-checked = keep by default. Host
    # setup (helper + completion) is always re-applied — it holds no custom data.
    local keep_home=0 keep_wake=0 keep_shares=0 c
    MULTI_PRECHECK=1
    choose_multi "Reset — keep which of these? (Space toggle · Enter confirm)" \
        "Home directory (agents accounts, chats, workspace)" \
        "Shared directories" \
        "wake-claude schedules"
    for c in "${MULTI_CHOICES[@]}"; do
        case "$c" in
            "Home directory"*)     keep_home=1 ;;
            "wake-claude"*)        keep_wake=1 ;;
            "Shared directories"*) keep_shares=1 ;;
        esac
    done

    read -p "Delete $JAIL_ROOT and rebuild from scratch? [y/N]: " -r confirmation
    if [[ ! "$confirmation" =~ ^[Yy]$ ]]; then
        log_info "Reset aborted."
        return 0
    fi
    if is_running; then
        # A destructive reset must fail closed: do not touch the rootfs until the
        # container is confirmed down. The helper waits and verifies; the legacy
        # fallback does the same before continuing.
        if _helper_current; then
            run_priv down \
                || log_error "Reset aborted: the sandbox did not stop cleanly; the rootfs was not touched."
        else
            sudo machinectl poweroff "$MACHINE_NAME" >/dev/null 2>&1 || true
            local _wait=120
            while [ "$_wait" -gt 0 ] && is_running; do sleep 0.25; _wait=$((_wait - 1)); done
            is_running \
                && log_error "Reset aborted: the sandbox is still running; the rootfs was not touched."
        fi
    fi
    teardown_host_network

    # Stash the WHOLE user home if keeping it. Move it to a sibling under CONFIG_DIR
    # instead of duplicating it into /tmp: this is atomic on the same filesystem,
    # needs no second copy's worth of free disk, and leaves a recoverable backup if
    # bootstrap fails. Never proceed to the wipe when preservation itself fails.
    local kept=""
    if [ "$keep_home" = 1 ] && [ -d "$JAIL_ROOT/home/$USER_NAME" ]; then
        kept=$(mktemp -d "$CONFIG_DIR/reset-home.XXXXXX")
        if ! sudo mv "$JAIL_ROOT/home/$USER_NAME" "$kept/home"; then
            sudo rmdir "$kept" 2>/dev/null || true
            log_error "Reset aborted: could not preserve the home directory; the original rootfs was not deleted."
        fi
        log_info "Preserved the home directory at $kept/home until the rebuild completes."
    fi

    sudo rm -rf "$JAIL_ROOT"
    bootstrap_sandbox

    # Restore the stashed home over the freshly-seeded one, then re-apply the
    # managed config on top so tweaks (prompt, tmux bar, switcher) still land.
    if [ -n "$kept" ] && [ -d "$kept/home" ]; then
        sudo rm -rf "$JAIL_ROOT/home/$USER_NAME"
        sudo mv "$kept/home" "$JAIL_ROOT/home/$USER_NAME" \
            || log_error "Rebuild completed but home restore failed. Your preserved home remains at $kept/home."
        sudo rmdir "$kept" 2>/dev/null || true
        configure_dotfiles
        write_agent_env_zsh
        write_task_helper
        write_statusline
        log_success "Restored the home directory (managed config refreshed)."
    fi

    if [ "$keep_wake" != 1 ]; then
        _remove_all_hostwakes
        log_info "Removed wake-claude schedules."
    fi

    if [ "$keep_shares" != 1 ]; then
        : > "$SHARE_LIST"
        log_info "Cleared the shared-directory list."
    else
        log_info "Kept the shared-directory list."
    fi

    ensure_host_privs        # host setup holds no custom data; always re-apply
    log_success "Rebuilt. Run 'waterbox' to boot and attach."
}

# Remove every host wake timer (req 15: when not keeping wake-claude schedules).
_remove_all_hostwakes() {
    local f n
    for f in "$HOSTWAKE_GLOB"*.timer; do
        [ -e "$f" ] || continue
        n=$(basename "$f" .timer); n="${n##*-}"
        case "$n" in ''|*[!0-9]*) continue ;; esac
        _helper_current && run_priv remove-host-wake "$n" >/dev/null 2>&1 || true
    done
}

# --- In-box config version -----------------------------------------------------
# Marker (rootfs, world-readable) tying the baked in-box config (dotfiles, tmux bar,
# agent-env switcher, waterbox-fire) to the exact waterbox script that wrote it — a
# checksum of this script. Lets 'start' notice a box built by an OLDER waterbox and
# auto-refresh it, so you never have to remember 'refresh-config' after an upgrade.
CONFIG_VERSION_FILE="$JAIL_ROOT/etc/waterbox/config-version"
_config_marker()  { cksum < "$SELF_PATH" 2>/dev/null | cut -d' ' -f1; }
_config_current() {
    [ -f "$JAIL_ROOT/.waterbox-ready" ] \
        && [ "$(cat "$CONFIG_VERSION_FILE" 2>/dev/null)" = "$(_config_marker)" ]
}
_write_config_version() {
    _in_jail "$CONFIG_VERSION_FILE" \
        || log_error "Refusing to create the config marker: it resolves outside $JAIL_ROOT. Run 'waterbox reset'."
    sudo mkdir -p "$JAIL_ROOT/etc/waterbox"
    _config_marker | wb_tee "$CONFIG_VERSION_FILE"
}

# --- Refresh in-box config (no wipe) ------------------------------------------
# Re-apply the config baked at bootstrap (dotfiles, prompt, agent-env switcher,
# welcome banner, the waterbox-fire helper) to an existing rootfs WITHOUT wiping
# it — so tweaks to these reach the box without losing Claude logins/history or
# profiles. Only rewrites managed files; profile dirs are never touched.
refresh_config() {
    [ -f "$JAIL_ROOT/.waterbox-ready" ] \
        || log_error "No built sandbox to refresh. Run 'waterbox start' first."
    is_running \
        && log_error "Refusing host-root config writes while the box is running. Use 'waterbox restart' to refresh safely."
    ensure_helper    # keep the root helper in lockstep with this script's verbs too
    log_info "Re-applying in-box config to $JAIL_ROOT ..."
    configure_dotfiles
    configure_hosts          # box→127.0.0.1 + host reachable by 'host' and its hostname
    write_agent_env_zsh
    write_task_helper
    write_statusline
    _write_config_version
    log_success "Config refreshed. It will be active on the next start."
}

# Enable `waterbox` Tab-completion in the invoking user's ~/.zshrc. The snippet is
# guarded: it runs completion via 'waterbox' on $PATH, else this script's recorded
# absolute path, else does nothing — so an uninstalled or off-$PATH waterbox never
# spews "command not found" at shell start. Idempotent + self-healing (rewrites the
# marked block if SELF_PATH changed); strips any older unguarded lines too.
enable_completion() {
    local rc="$HOME/.zshrc" cache="$CONFIG_DIR/completion.zsh"
    [ -f "$rc" ] || : > "$rc"
    # Cache the generated completion to a file, so every new shell just SOURCES it
    # instead of spawning the whole waterbox script (which made zsh startup slow).
    # Refresh the cache whenever this script is newer than it.
    if [ ! -f "$cache" ] || [ "$SELF_PATH" -nt "$cache" ]; then
        emit_completion zsh > "$cache" 2>/dev/null || : > "$cache"
    fi
    # Ensure ~/.zshrc sources the cache (guarded, self-healing — strips any older
    # block or unguarded lines). If waterbox later isn't on $PATH, Tab-completion of
    # live sessions just goes quiet; nothing errors at shell start.
    if ! grep -Fq "$cache" "$rc" 2>/dev/null; then
        sed -i '/# >>> waterbox completion >>>/,/# <<< waterbox completion <<</d; /waterbox completion zsh/d; /# waterbox shell completion/d' "$rc" 2>/dev/null || true
        {
            echo ""
            echo "# >>> waterbox completion >>>"
            echo "# Managed by waterbox: source the cached completion (fast; no subprocess)."
            echo "[[ -r \"$cache\" ]] && source \"$cache\""
            echo "# <<< waterbox completion <<<"
        } >> "$rc"
        log_success "Enabled 'waterbox' Tab-completion in $rc (open a new shell to use it)."
    fi
}

# --- Host privilege setup (auto-run by start/reset; no manual 'setup') ---------
# Every RUNTIME privileged op now routes through the immutable helper below, so
# there is NO broad credential cache anymore — a compromised uid-1000 can invoke
# the helper's fixed, charset-validated verbs but cannot run arbitrary sudo. The
# only interactive-sudo moments left are bootstrap and reset (you're present).

# Write + install the immutable root helper and its narrow NOPASSWD sudoers rule.
# The helper's privileged logic lives at a root-owned path uid-1000 can't modify,
# so a compromised uid-1000 can invoke its fixed verbs but not change what runs as
# root — and every arg is charset-validated so nothing can inject a systemd unit.
install_helper() {
    log_info "Installing the waterbox root helper (needs your password once)..."
    sudo install -d -m 0755 -o root -g root "$HELPER_DIR"
    # Marker = a checksum of THIS script (same one _config_current uses), not just the
    # version string: the immutable helper is then reinstalled whenever the script that
    # generates it changes at all — so it can never silently lag the caller's verbs
    # (a version bump isn't required, and two edits under one version still self-heal).
    local tmp hmark; tmp=$(mktemp); hmark=$(_config_marker)
    {
        cat <<EOF
#!/usr/bin/env bash
# waterbox root helper — root-owned, immutable to uid 1000. Generated by
# waterbox v$WATERBOX_VERSION. Do not edit. Runs privileged RUNTIME ops (fixed
# verbs) so sudo can be NOPASSWD for this file only.
set -e
WB_HELPER_VERSION="$hmark"
MACHINE_NAME="$MACHINE_NAME"
USER_NAME="$USER_NAME"
HOST_IP="$HOST_IP"
CONTAINER_IP="$CONTAINER_IP"
NET_CIDR="$NET_CIDR"
VE_IFACE="$VE_IFACE"
ALLOW_CONTAINER_TO_HOST_PORTS="$ALLOW_CONTAINER_TO_HOST_PORTS"
CONTAINER_WORKSPACE="$CONTAINER_WORKSPACE"
WATERBOX_MEMORY_HIGH="$WATERBOX_MEMORY_HIGH"
WATERBOX_MEMORY_MAX="$WATERBOX_MEMORY_MAX"
WATERBOX_SWAP_MAX_PERCENT="$WATERBOX_SWAP_MAX_PERCENT"
WATERBOX_TASKS_MAX="$WATERBOX_TASKS_MAX"
WATERBOX_CPU_WEIGHT="$WATERBOX_CPU_WEIGHT"
WATERBOX_IO_WEIGHT="$WATERBOX_IO_WEIGHT"
EOF
        cat <<'HELPER'
HW_ETC="/etc/systemd/system"
TASK_ETC="/etc/systemd/system"      # inside the rootfs ($JAIL_ROOT$TASK_ETC)
TASK_MSG_DIR="/etc/waterbox"        # inside the rootfs (schedule-command messages)

# Pull a trailing "--user <uid>" out of the args (a host root timer has no
# SUDO_UID, so it passes the target uid explicitly). Everything else is positional.
wb_uid=""
_args=()
while [ $# -gt 0 ]; do
    case "$1" in
        --user) wb_uid="$2"; shift 2 || exit 2 ;;
        *) _args+=("$1"); shift ;;
    esac
done
set -- "${_args[@]}"
verb="${1:-}"; shift || true

# SECURITY: when invoked via sudo by a user, ALWAYS act as that user — a supplied
# --user is ignored. Only the host root timers (run as root, no SUDO_UID) may set
# the target uid. This stops a compromised uid-1000 from passing "--user 0" (or any
# other uid) to make the helper read/write another user's home as root.
[ -n "${SUDO_UID:-}" ] && wb_uid="$SUDO_UID"
case "$wb_uid" in ''|*[!0-9]*) echo "helper: no valid target user"; exit 2 ;; esac
wb_home="$(getent passwd "$wb_uid" | cut -d: -f6)"
[ -n "$wb_home" ] && [ -d "$wb_home" ] || { echo "helper: no home for uid $wb_uid"; exit 2; }
JAIL_ROOT="$wb_home/.waterbox/root"
WB_CFG="$wb_home/.waterbox"

# Charset-limited AND never "." / ".." (so a name can't traverse out of its dir).
_valid_profile() { case "$1" in ''|.|..|*[!A-Za-z0-9._-]*) return 1 ;; *) return 0 ;; esac; }
_valid_id()      { case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }
_valid_time()    { [[ "$1" =~ ^([01]?[0-9]|2[0-3]):[0-5][0-9]$ ]]; }
# Leading '-' rejected too: such a name would reach tmux/grep/systemd as an option.
_valid_session() { case "$1" in ''|.|..|-*|*[!A-Za-z0-9._-]*) return 1 ;; *) return 0 ;; esac; }
_valid_schedid() { case "$1" in schd-com-*) _valid_id "${1#schd-com-}" ;; *) return 1 ;; esac; }

# Container root owns the rootfs, so it can point any file we write — or a parent
# directory of one — at a host path. We are root and NOT chrooted, so install/'>'
# would follow that symlink straight out of the box. realpath -m resolves the whole
# chain without needing the file to exist; refuse anything landing outside the jail.
_in_jail() { case "$(realpath -m "$1" 2>/dev/null)" in "$JAIL_ROOT"/*) return 0 ;; *) return 1 ;; esac; }

running() { machinectl show "$MACHINE_NAME" --property=State 2>/dev/null | grep -q "State=running"; }
secure_userns() {
    local leader start
    leader=$(machinectl show "$MACHINE_NAME" -p Leader --value 2>/dev/null)
    [ -n "$leader" ] && [ "$leader" != 0 ] || return 1
    read -r _ start _ < "/proc/$leader/uid_map" || return 1
    [ -n "$start" ] && [ "$start" != 0 ]
}
unsafe_unit() {
    local env
    env=$(systemctl show "$MACHINE_NAME.service" -p Environment --value 2>/dev/null) || return 1
    case " $env " in *" WATERBOX_UNSAFE_HOST_ROOT=1 "*) return 0 ;; *) return 1 ;; esac
}
approved_box() {
    secure_userns || unsafe_unit
}
require_unsafe_rootfs() {
    local detail
    if detail=$(systemd-nspawn -q \
            --private-users=pick --private-users-ownership=map \
            -D "$JAIL_ROOT" /usr/bin/true 2>&1); then
        echo "helper: refusing --unsafe-host-root because secure ID mapping works" >&2
        return 3
    fi
    if ! printf '%s\n' "$detail" | grep -qiE 'ID.?mapped mounts?.*(not available|not supported)'; then
        detail=$(printf '%s\n' "$detail" | tail -n 2 | tr '\n' ' ')
        echo "helper: refusing unsafe override for an unrelated nspawn failure: $detail" >&2
        return 3
    fi
}
run_in_approved_box() {
    local leader
    running && approved_box \
        || { echo "helper: refusing to enter an unapproved legacy host-root box" >&2; return 3; }
    leader=$(machinectl show "$MACHINE_NAME" -p Leader --value 2>/dev/null)
    [ -n "$leader" ] && [ "$leader" != 0 ] || return 3
    nsenter --target "$leader" --all --setuid 0 --setgid 0 "$@"
}

# systemd 249 (Ubuntu 22.04/Mint 21 era) accepts percentage MemoryHigh/Max
# values, but MemorySwapMax still requires bytes. Convert our policy percentage
# against actual configured swap so the same helper command works everywhere.
swap_limit_bytes() {
    case "$WATERBOX_SWAP_MAX_PERCENT" in
        ''|*[!0-9]*) echo 0; return ;;
    esac
    awk -v pct="$WATERBOX_SWAP_MAX_PERCENT" '
        $1 == "SwapTotal:" { printf "%.0f\n", $2 * 1024 * pct / 100; found=1; exit }
        END { if (!found) print 0 }
    ' /proc/meminfo
}

human_bytes() {
    awk -v bytes="$1" 'BEGIN {
        split("B KiB MiB GiB TiB", unit, " ")
        n = bytes + 0; i = 1
        while (n >= 1024 && i < 5) { n /= 1024; i++ }
        if (i == 1) printf "%d %s", n, unit[i]
        else printf "%.1f %s", n, unit[i]
    }'
}

unit_property() {
    systemctl show "$MACHINE_NAME.service" --property="$1" --value 2>/dev/null || true
}

resource_status() {
    local use_color="${1:-0}" current high maximum remaining tasks tasks_max
    local weight quota quota_pct ram_color task_color usage_pct
    local c_head="" c_label="" c_good="" c_warn="" c_bad="" c_dim="" c_off=""
    if [ "$use_color" = 1 ]; then
        c_head=$'\e[1;36m'
        c_label=$'\e[1;36m'
        c_good=$'\e[32m'
        c_warn=$'\e[33m'
        c_bad=$'\e[31m'
        c_dim=$'\e[2m'
        c_off=$'\e[0m'
    fi
    current=$(unit_property MemoryCurrent)
    high=$(unit_property MemoryHigh)
    maximum=$(unit_property MemoryMax)
    tasks=$(unit_property TasksCurrent)
    tasks_max=$(unit_property TasksMax)
    weight=$(unit_property CPUWeight)
    quota=$(unit_property CPUQuotaPerSecUSec)

    printf '%sResource limits:%s\n' "$c_head" "$c_off"
    if _valid_id "$current" && _valid_id "$high" && _valid_id "$maximum"; then
        remaining=$((maximum - current))
        [ "$remaining" -ge 0 ] || remaining=0
        if [ "$current" -ge "$high" ]; then
            ram_color="$c_bad"
        elif [ $((current * 10)) -ge $((high * 8)) ]; then
            ram_color="$c_warn"
        else
            ram_color="$c_good"
        fi
        printf '  %sRAM:%s %s%s%s / %s max %s(%s remaining; pressure at %s)%s\n' \
            "$c_label" "$c_off" "$ram_color" "$(human_bytes "$current")" "$c_off" \
            "$(human_bytes "$maximum")" "$c_dim" "$(human_bytes "$remaining")" \
            "$(human_bytes "$high")" "$c_off"
    else
        printf '  %sRAM:%s %saccounting unavailable%s\n' \
            "$c_label" "$c_off" "$c_bad" "$c_off"
    fi

    case "$weight" in ''|'[not set]'|*[!0-9]*) weight=default ;; esac
    case "$quota" in
        ''|infinity|'[not set]'|*[!0-9]*)
            printf '  %sCPU:%s %sno hard cap%s %s(weight %s; lower priority under contention)%s\n' \
                "$c_label" "$c_off" "$c_good" "$c_off" "$c_dim" "$weight" "$c_off" ;;
        *)
            quota_pct=$(awk -v usec="$quota" 'BEGIN { printf "%.0f", usec / 10000 }')
            printf '  %sCPU:%s %s%s%% maximum%s %s(weight %s)%s\n' \
                "$c_label" "$c_off" "$c_good" "$quota_pct" "$c_off" \
                "$c_dim" "$weight" "$c_off" ;;
    esac

    if _valid_id "$tasks" && _valid_id "$tasks_max" && [ "$tasks_max" -gt 0 ]; then
        usage_pct=$((tasks * 100 / tasks_max))
        if [ "$usage_pct" -ge 90 ]; then
            task_color="$c_bad"
        elif [ "$usage_pct" -ge 70 ]; then
            task_color="$c_warn"
        else
            task_color="$c_good"
        fi
        printf '  %sTasks:%s %s%s%s / %s %s(processes and threads)%s\n' \
            "$c_label" "$c_off" "$task_color" "$tasks" "$c_off" "$tasks_max" \
            "$c_dim" "$c_off"
    else
        printf '  %sTasks:%s %saccounting unavailable%s\n' \
            "$c_label" "$c_off" "$c_bad" "$c_off"
    fi
}

# Attach a host path to the running box without relying on machinectl bind (which
# rejects private-user containers) or nspawn's v256-only owneridmap parser.
#
# The small Python shim uses Linux's open_tree(2) + mount_setattr(MOUNT_ATTR_IDMAP)
# + move_mount(2) APIs directly. It clones the source while still in the host mount
# namespace, gives that detached clone one-ID mappings (container uid/gid 1000 ↔
# the source directory's host owner/group), then moves it into the box's mount namespace. Source
# and target are held by file descriptor across the namespace switch, eliminating
# symlink-swap and "source path isn't visible in the box" races. In the explicitly
# unsafe compatibility mode host/container IDs are already identical, so host_uid
# is "-" and the same code creates a raw bind while retaining nosuid,nodev.
mount_into_box() {
    local source="$1" target="$2" host_uid="${3:--}" leader
    running && approved_box \
        || { echo "helper: refusing to mount into an unapproved legacy box" >&2; return 3; }
    leader=$(machinectl show "$MACHINE_NAME" -p Leader --value 2>/dev/null)
    [ -n "$leader" ] && [ "$leader" != 0 ] || return 3
    python3 - "$leader" "$source" "$target" "$host_uid" "$CONTAINER_WORKSPACE" <<'PY'
import ctypes
import errno
import os
import stat
import sys

leader, source, target, host_uid_arg, workspace = sys.argv[1:]
if not leader.isdigit() or int(leader) <= 0:
    raise SystemExit("idmap mount: invalid container leader")
if not source.startswith("/") or not target.startswith("/") or target == "/":
    raise SystemExit("idmap mount: source and target must be absolute")
if ".." in target.split("/"):
    raise SystemExit("idmap mount: invalid target")
allowed_gui = {
    "/tmp/.waterbox-wayland",
    "/tmp/.waterbox-xauth",
}
if not (target.startswith(workspace + "/")
        or target in allowed_gui
        or target.startswith("/tmp/.X11-unix/X")):
    raise SystemExit("idmap mount: target is outside Waterbox mount locations")

libc = ctypes.CDLL(None, use_errno=True)
libc.unshare.argtypes = (ctypes.c_int,)
libc.unshare.restype = ctypes.c_int
libc.setns.argtypes = (ctypes.c_int, ctypes.c_int)
libc.setns.restype = ctypes.c_int
libc.syscall.restype = ctypes.c_long

# glibc gained wrappers for these mount APIs in 2.36. Ubuntu 22.04/Mint 21
# use 2.35, so fall back to their generic Linux syscall numbers there. Waterbox's
# Arch image is x86_64; aarch64 uses the same numbers for these new syscalls.
if os.uname().machine not in {"x86_64", "aarch64"}:
    raise SystemExit("idmap mount: unsupported host architecture")

def open_tree(dfd, path, flags):
    if hasattr(libc, "open_tree"):
        fn = libc.open_tree
        fn.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_uint)
        fn.restype = ctypes.c_int
        return fn(dfd, path, flags)
    return libc.syscall(428, dfd, path, flags)

def move_mount(from_dfd, from_path, to_dfd, to_path, flags):
    if hasattr(libc, "move_mount"):
        fn = libc.move_mount
        fn.argtypes = (
            ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p,
            ctypes.c_uint,
        )
        fn.restype = ctypes.c_int
        return fn(from_dfd, from_path, to_dfd, to_path, flags)
    return libc.syscall(429, from_dfd, from_path, to_dfd, to_path, flags)

def mount_setattr(dfd, path, flags, attr, size):
    if hasattr(libc, "mount_setattr"):
        fn = libc.mount_setattr
        fn.argtypes = (
            ctypes.c_int, ctypes.c_char_p, ctypes.c_uint,
            ctypes.c_void_p, ctypes.c_size_t,
        )
        fn.restype = ctypes.c_int
        return fn(dfd, path, flags, attr, size)
    return libc.syscall(442, dfd, path, flags, attr, size)

AT_FDCWD = -100
AT_EMPTY_PATH = 0x1000
AT_RECURSIVE = 0x8000
OPEN_TREE_CLONE = 1
OPEN_TREE_CLOEXEC = os.O_CLOEXEC
MOVE_MOUNT_F_EMPTY_PATH = 0x00000004
MOVE_MOUNT_T_EMPTY_PATH = 0x00000040
MOUNT_ATTR_IDMAP = 0x00100000
MOUNT_ATTR_NOSUID = 0x00000002
MOUNT_ATTR_NODEV = 0x00000004
CLONE_NEWNS = 0x00020000
CLONE_NEWUSER = 0x10000000

class MountAttr(ctypes.Structure):
    _fields_ = [
        ("attr_set", ctypes.c_uint64),
        ("attr_clr", ctypes.c_uint64),
        ("propagation", ctypes.c_uint64),
        ("userns_fd", ctypes.c_uint64),
    ]

def checked(result, operation):
    if result < 0:
        e = ctypes.get_errno()
        raise OSError(e, f"{operation}: {os.strerror(e)}")
    return result

def mapped_host_id(map_file, inner_id):
    with open(map_file, "r", encoding="ascii") as f:
        for line in f:
            inside, outside, length = (int(v) for v in line.split())
            if inside <= inner_id < inside + length:
                return outside + (inner_id - inside)
    raise OSError(errno.EINVAL, f"{inner_id} is not mapped by {map_file}")

def make_userns(source_uid, source_gid, target_uid, target_gid):
    ready_r, ready_w = os.pipe()
    hold_r, hold_w = os.pipe()
    pid = os.fork()
    if pid == 0:
        try:
            os.close(ready_r)
            os.close(hold_w)
            if libc.unshare(CLONE_NEWUSER) < 0:
                os.write(ready_w, f"E{ctypes.get_errno()}".encode())
                os._exit(1)
            os.write(ready_w, b"1")
            os.close(ready_w)
            os.read(hold_r, 1)
            os._exit(0)
        except BaseException:
            os._exit(1)

    os.close(ready_w)
    os.close(hold_r)
    status = os.read(ready_r, 64)
    os.close(ready_r)
    if status != b"1":
        os.close(hold_w)
        os.waitpid(pid, 0)
        code = status[1:].decode(errors="replace") if status.startswith(b"E") else "unknown"
        raise OSError(errno.EPERM, f"unshare(CLONE_NEWUSER) failed (errno {code})")
    try:
        try:
            with open(f"/proc/{pid}/setgroups", "w", encoding="ascii") as f:
                f.write("deny\n")
        except FileNotFoundError:
            pass
        with open(f"/proc/{pid}/uid_map", "w", encoding="ascii") as f:
            f.write(f"{source_uid} {target_uid} 1\n")
        with open(f"/proc/{pid}/gid_map", "w", encoding="ascii") as f:
            f.write(f"{source_gid} {target_gid} 1\n")
        nsfd = os.open(f"/proc/{pid}/ns/user", os.O_RDONLY | os.O_CLOEXEC)
    finally:
        os.close(hold_w)
        os.waitpid(pid, 0)
    return nsfd

fds = []
try:
    source_fd = os.open(
        source, os.O_PATH | os.O_CLOEXEC | os.O_NOFOLLOW,
    )
    fds.append(source_fd)
    source_stat = os.fstat(source_fd)
    if not (stat.S_ISDIR(source_stat.st_mode)
            or stat.S_ISREG(source_stat.st_mode)
            or stat.S_ISSOCK(source_stat.st_mode)):
        raise OSError(errno.EINVAL, "unsupported bind source type")
    actual = os.path.realpath(f"/proc/self/fd/{source_fd}")
    if actual != os.path.normpath(source):
        raise OSError(errno.ELOOP, "bind source changed or contains an unresolved symlink")

    map_ids = host_uid_arg != "-"
    if map_ids:
        if not host_uid_arg.isdigit():
            raise OSError(errno.EINVAL, "invalid host uid")
        host_uid = int(host_uid_arg)
        if source_stat.st_uid != host_uid:
            raise OSError(errno.EPERM, "bind source is not owned by the invoking user")

    recursive = AT_RECURSIVE if stat.S_ISDIR(source_stat.st_mode) else 0
    mount_fd = checked(
        open_tree(
            source_fd, b"",
            OPEN_TREE_CLONE | OPEN_TREE_CLOEXEC | AT_EMPTY_PATH | recursive,
        ),
        "open_tree",
    )
    fds.append(mount_fd)

    userns_fd = 0
    mount_attrs = MOUNT_ATTR_NOSUID | MOUNT_ATTR_NODEV
    if map_ids:
        # Match systemd's owner-to-target-owner map: the source inode owner is
        # mapped to the kernel-level IDs corresponding to uid/gid 1000 in the
        # container (normally picked_base + 1000). Reversing these two sides makes
        # the share appear as nobody and causes EOVERFLOW on file creation.
        target_uid = mapped_host_id(f"/proc/{leader}/uid_map", 1000)
        target_gid = mapped_host_id(f"/proc/{leader}/gid_map", 1000)
        userns_fd = make_userns(
            host_uid, source_stat.st_gid, target_uid, target_gid,
        )
        fds.append(userns_fd)
        mount_attrs |= MOUNT_ATTR_IDMAP

    # A shared project is data, not a device bridge or a host privilege carrier.
    # Apply these recursively to the detached clone without changing the host's
    # original mount. (They are harmless on the GUI's single socket/file mounts.)
    attr = MountAttr(mount_attrs, 0, 0, userns_fd)
    checked(
        mount_setattr(
            mount_fd, b"", AT_EMPTY_PATH | recursive,
            ctypes.byref(attr), ctypes.sizeof(attr),
        ),
        "mount_setattr(ID mapping/nosuid/nodev)",
    )

    mountns_fd = os.open(f"/proc/{leader}/ns/mnt", os.O_RDONLY | os.O_CLOEXEC)
    root_fd = os.open(
        f"/proc/{leader}/root",
        os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC,
    )
    fds.extend((mountns_fd, root_fd))
    checked(libc.setns(mountns_fd, CLONE_NEWNS), "setns(container mount namespace)")

    # Resolve every target component relative to the container root. Even absolute
    # symlinks planted by the box now remain inside that chroot.
    os.fchdir(root_fd)
    os.chroot(".")
    os.chdir("/")
    target_fd = os.open(
        target.lstrip("/"),
        os.O_PATH | os.O_CLOEXEC | os.O_NOFOLLOW,
    )
    fds.append(target_fd)
    target_stat = os.fstat(target_fd)
    if stat.S_ISLNK(target_stat.st_mode):
        raise OSError(errno.ELOOP, "bind target is a symlink")
    if stat.S_ISDIR(source_stat.st_mode) != stat.S_ISDIR(target_stat.st_mode):
        raise OSError(errno.EINVAL, "bind source/target type mismatch")

    checked(
        move_mount(
            mount_fd, b"", target_fd, b"",
            MOVE_MOUNT_F_EMPTY_PATH | MOVE_MOUNT_T_EMPTY_PATH,
        ),
        "move_mount",
    )
except OSError as e:
    print(f"idmap mount: {e}", file=sys.stderr)
    raise SystemExit(1)
finally:
    for fd in reversed(fds):
        try:
            os.close(fd)
        except OSError:
            pass
PY
}

# Probe --restrict-address-families once and cache the result. Older Debian-family
# nspawn builds do not have it, and distro backports can expose a mixed feature set.
_NSPAWN_RAF=""
_nspawn_supports_raf() {
    [ -n "$_NSPAWN_RAF" ] || \
        { systemd-nspawn --help 2>/dev/null | grep -q -- '--restrict-address-families' \
            && _NSPAWN_RAF=yes || _NSPAWN_RAF=no; }
    [ "$_NSPAWN_RAF" = yes ]
}

net_up() {
    local tries=30
    while [ $tries -gt 0 ] && ! ip link show "$VE_IFACE" >/dev/null 2>&1; do
        sleep 0.2; tries=$((tries - 1))
    done
    ip link show "$VE_IFACE" >/dev/null 2>&1 || return 1
    ip addr add "$HOST_IP/$NET_CIDR" dev "$VE_IFACE" 2>/dev/null || true
    ip link set "$VE_IFACE" up
    sysctl -wq net.ipv4.ip_forward=1
    sysctl -wq "net.ipv4.conf.$VE_IFACE.route_localnet=1" 2>/dev/null || true
    iptables -t nat -C PREROUTING -i "$VE_IFACE" -d "$HOST_IP" -j DNAT --to-destination 127.0.0.1 2>/dev/null \
        || iptables -t nat -A PREROUTING -i "$VE_IFACE" -d "$HOST_IP" -j DNAT --to-destination 127.0.0.1
    iptables -t nat -C POSTROUTING -s "$HOST_IP/$NET_CIDR" ! -o "$VE_IFACE" -j MASQUERADE 2>/dev/null \
        || iptables -t nat -A POSTROUTING -s "$HOST_IP/$NET_CIDR" ! -o "$VE_IFACE" -j MASQUERADE
    iptables -C FORWARD -i "$VE_IFACE" -j ACCEPT 2>/dev/null \
        || iptables -I FORWARD 1 -i "$VE_IFACE" -j ACCEPT
    iptables -C FORWARD -o "$VE_IFACE" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null \
        || iptables -I FORWARD 1 -o "$VE_IFACE" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
    if [ "$ALLOW_CONTAINER_TO_HOST_PORTS" = "true" ]; then
        iptables -C INPUT -i "$VE_IFACE" -s "$HOST_IP/$NET_CIDR" -j ACCEPT 2>/dev/null \
            || iptables -I INPUT 1 -i "$VE_IFACE" -s "$HOST_IP/$NET_CIDR" -j ACCEPT
    fi
}
net_down() {
    iptables -t nat -D PREROUTING -i "$VE_IFACE" -d "$HOST_IP" -j DNAT --to-destination 127.0.0.1 2>/dev/null || true
    iptables -t nat -D POSTROUTING -s "$HOST_IP/$NET_CIDR" ! -o "$VE_IFACE" -j MASQUERADE 2>/dev/null || true
    iptables -D FORWARD -i "$VE_IFACE" -j ACCEPT 2>/dev/null || true
    iptables -D FORWARD -o "$VE_IFACE" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
    iptables -D INPUT -i "$VE_IFACE" -s "$HOST_IP/$NET_CIDR" -j ACCEPT 2>/dev/null || true
}

# Minimal boot for an unattended wake: NO shares, NO GUI — just the base container
# + network, so a quota primer can reach Anthropic while you're away (box was off).
boot_min() {
    if running; then
        approved_box \
            || { echo "helper: refusing to use an unapproved legacy host-root box" >&2; return 3; }
        return 0
    fi
    [ -f "$JAIL_ROOT/.waterbox-ready" ] || { echo "helper: rootfs not built at $JAIL_ROOT"; exit 3; }
    local raf=() swap_max
    swap_max=$(swap_limit_bytes)
    _nspawn_supports_raf && raf=(--restrict-address-families="AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET")
    # Same device-cgroup lockdown as boot_full: private users are the primary
    # boundary, while the closed device policy remains defense in depth.
    systemd-run --unit="$MACHINE_NAME" --collect --service-type=notify \
        --description="Waterbox container ($MACHINE_NAME)" \
        --property=KillMode=mixed --property=TimeoutStopSec=30 --property=SuccessExitStatus=133 \
        --property=MemoryHigh="$WATERBOX_MEMORY_HIGH" \
        --property=MemoryMax="$WATERBOX_MEMORY_MAX" \
        --property=MemorySwapMax="$swap_max" \
        --property=TasksMax="$WATERBOX_TASKS_MAX" \
        --property=CPUWeight="$WATERBOX_CPU_WEIGHT" \
        --property=IOWeight="$WATERBOX_IO_WEIGHT" \
        --property=OOMPolicy=continue \
        --property=DevicePolicy=closed \
        --property=DeviceAllow="/dev/net/tun rwm" \
        --property=DeviceAllow="char-pts rw" \
        --property=DeviceAllow="/dev/fuse rwm" \
        systemd-nspawn --boot --quiet --keep-unit --notify-ready=yes \
            --directory="$JAIL_ROOT" --machine="$MACHINE_NAME" --network-veth \
            --private-users=pick --private-users-ownership=map \
            --resolv-conf=off --capability=CAP_NET_ADMIN,CAP_NET_RAW --bind=/dev/net/tun \
            "${raf[@]}" \
        >/dev/null 2>&1
    running || { echo "helper: boot failed"; exit 3; }
    net_up || true
    sleep 3   # let networkd bring host0 up inside before we hit the network
}
power_off() {
    running && machinectl poweroff "$MACHINE_NAME" >/dev/null 2>&1 || true
    local t=120; while [ "$t" -gt 0 ] && running; do sleep 0.25; t=$((t - 1)); done
    if running; then
        echo "helper: container is still running after 30 seconds; refusing to report a successful stop" >&2
        return 1
    fi
    net_down
}

# --- Full interactive boot (shares + GUI + GPU), all validated helper-side ------
# A share is safe to owner-map only when the invoking user owns its top directory.
# Our one-ID mount maps container uid 1000 to precisely that host owner and leaves
# container root unmapped. Allow owned paths inside the user's home (minus secret
# dirs), or owned dirs on removable/user mounts; reject everything else. This
# re-checks what `share add` enforces, in case $SHARE_LIST was hand-edited.
_share_allowed() {
    local rp="$1"
    case "$rp" in
        "$wb_home"|"$wb_home/.ssh"|"$wb_home/.ssh/"*|"$wb_home/.gnupg"|"$wb_home/.gnupg/"*|"$wb_home/.config"|"$wb_home/.config/"*|"$WB_CFG"|"$WB_CFG/"*) return 1 ;;
        "$wb_home/"*)
            [ "$(stat -c %u "$rp" 2>/dev/null)" = "$wb_uid" ] && return 0 || return 1 ;;
    esac
    case "$rp" in
        /mnt/*|/media/*|/run/media/*)
            [ "$(stat -c %u "$rp" 2>/dev/null)" = "$wb_uid" ] && return 0 || return 1 ;;
    esac
    return 1
}
collect_share_mounts() {
    local list="$WB_CFG/shared_paths" p rp base seen=" "
    SHARE_SOURCES=()
    [ -f "$list" ] || return 0
    while IFS= read -r p || [ -n "$p" ]; do
        [ -n "$p" ] || continue
        [ -d "$p" ] || continue
        rp=$(realpath "$p" 2>/dev/null) || continue
        _share_allowed "$rp" || { echo "helper: refusing to share unsafe path: $rp" >&2; continue; }
        base=$(basename "$rp")
        case "$base" in ''|.|..|*/*) continue ;; esac
        case "$seen" in
            *" $base "*)
                echo "helper: duplicate share destination '$CONTAINER_WORKSPACE/$base'; rename or detach one of the same-named host directories" >&2
                return 1 ;;
        esac
        seen="$seen$base "
        SHARE_SOURCES+=("$rp")
    done < "$list"
}
mount_one_share() {
    local rp="$1" base target map_uid="$wb_uid"
    base=$(basename "$rp")
    target="$CONTAINER_WORKSPACE/$base"
    # Create the target from inside the box's mount namespace. A malicious box may
    # redirect or replace it, but that can affect only paths inside the box.
    run_in_approved_box /bin/sh -c \
        'mkdir -p "$1" && chown 1000:1000 "$1"' sh "$target" \
        || { echo "helper: could not prepare share target $target" >&2; return 1; }
    # In explicit v1.8 compatibility mode uid 1000 already means host uid 1000.
    # Omitting only the ID map also lets overlayfs shares remain live; the mount
    # syscall path still applies nosuid,nodev recursively.
    unsafe_unit && map_uid="-"
    mount_into_box "$rp" "$target" "$map_uid"
}
mount_collected_shares() {
    local rp
    for rp in "${SHARE_SOURCES[@]}"; do
        mount_one_share "$rp" || return 1
    done
}
# GUI binds: only the display sockets + our own xauth file, to fixed in-container
# targets. Sockets must actually be sockets; the xauth must be exactly our file.
collect_gui_mounts() {
    local spec="$WB_CFG/gui_binds" line src dst map_uid
    GUI_SOURCES=(); GUI_TARGETS=(); GUI_MAP_UIDS=()
    [ -f "$spec" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        [ -n "$line" ] || continue
        case "$line" in *:*) src="${line%%:*}"; dst="${line#*:}" ;; *) src="$line"; dst="$line" ;; esac
        case "$dst" in
            /tmp/.X11-unix/X[0-9]|/tmp/.X11-unix/X[0-9][0-9]|/tmp/.waterbox-wayland)
                [ -S "$src" ] || continue ;;
            /tmp/.waterbox-xauth)
                { [ "$src" = "$WB_CFG/xauth" ] && [ -f "$src" ]; } || continue ;;
            *) continue ;;
        esac
        # Wayland + xauth are host-user-owned (usually mode 0600/0700): map target
        # uid 1000 to that user. X sockets are normally mode 0777 and may be root-
        # owned, so leave them unmapped; mapping them could map uid 1000 to host root.
        case "$dst" in
            /tmp/.X11-unix/*) map_uid="-" ;;
            *)
                [ "$(stat -c %u "$src" 2>/dev/null)" = "$wb_uid" ] \
                    || { echo "helper: refusing GUI file not owned by uid $wb_uid: $src" >&2; continue; }
                map_uid="$wb_uid" ;;
        esac
        GUI_SOURCES+=("$src"); GUI_TARGETS+=("$dst"); GUI_MAP_UIDS+=("$map_uid")
    done < "$spec"
}
mount_collected_gui() {
    local i src dst map_uid
    for i in "${!GUI_SOURCES[@]}"; do
        src="${GUI_SOURCES[$i]}"; dst="${GUI_TARGETS[$i]}"
        run_in_approved_box /bin/sh -c '
            mkdir -p "$(dirname "$1")"
            [ -e "$1" ] || : > "$1"
            chown -h 1000:1000 "$1"
        ' sh "$dst" \
            || { echo "helper: could not prepare GUI target $dst" >&2; return 1; }
        map_uid="${GUI_MAP_UIDS[$i]}"
        unsafe_unit && map_uid="-"
        mount_into_box "$src" "$dst" "$map_uid" || return 1
    done
}
# Copy the user's export-VAR gui-env into the rootfs (sourced by the login shell).
write_gui_env() {
    local target="$JAIL_ROOT/etc/waterbox/gui-env"
    _in_jail "$target" \
        || { echo "helper: refusing to write gui-env — it resolves outside the rootfs" >&2; return 0; }
    mkdir -p "$JAIL_ROOT/etc/waterbox"
    if [ -s "$WB_CFG/gui_env" ]; then
        install -m 0644 "$WB_CFG/gui_env" "$target"
    else
        rm -f "$target"
    fi
}
clear_gui_env() {
    local target="$JAIL_ROOT/etc/waterbox/gui-env"
    _in_jail "$target" \
        || { echo "helper: refusing to remove gui-env — it resolves outside the rootfs" >&2; return 1; }
    rm -f "$target"
}
boot_full() {
    local gui="$1" nogpu="$2" unsafe="$3"
    if running; then
        if [ "$unsafe" = 1 ]; then
            unsafe_unit \
                || { echo "helper: --unsafe-host-root does not match the running secure box" >&2; return 3; }
        else
            secure_userns \
                || { echo "helper: explicit --unsafe-host-root is required for this running box" >&2; return 3; }
        fi
        net_up || true
        return 0
    fi
    [ -f "$JAIL_ROOT/.waterbox-ready" ] || { echo "helper: rootfs not built at $JAIL_ROOT"; exit 3; }
    [ "$unsafe" != 1 ] || require_unsafe_rootfs
    collect_share_mounts
    if [ "$gui" = 1 ]; then collect_gui_mounts; write_gui_env; else clear_gui_env; fi
    # SECURITY: normally private users make container root an unprivileged host uid.
    # The explicit compatibility flag omits that primary boundary; every remaining
    # restriction below stays enabled as defense in depth in both modes.
    # With --keep-unit, nspawn runs inside THIS systemd-run scope and does NOT apply
    # its own device policy, so the scope must set it. Left unset, DevicePolicy=auto
    # allows every device whenever no DeviceAllow= is present (the --no-gpu path, or a
    # host with no /dev/dri). We mirror systemd's own systemd-nspawn@.service stanza
    # (closed + tun + pts + fuse), minus the loop/dm entries that are --image= only.
    # NOTE: not empirically verified here — this shell is itself inside a waterbox, so
    # the device controller isn't delegated to it; validated against systemd's unit.
    local gpu=() raf=() userns=(--private-users=pick --private-users-ownership=map)
    local unit_mode=() mode_label="" swap_max
    if [ "$unsafe" = 1 ]; then
        userns=(--private-users=no)
        unit_mode=(--property=Environment=WATERBOX_UNSAFE_HOST_ROOT=1)
        mode_label=" [UNSAFE host-root]"
    fi
    swap_max=$(swap_limit_bytes)
    local props=(--property=DevicePolicy=closed
                 --property=DeviceAllow="/dev/net/tun rwm"  # we --bind it below
                 --property=DeviceAllow="char-pts rw"       # ESSENTIAL: in-box ttys/tmux
                 --property=DeviceAllow="/dev/fuse rwm")    # fuse mounts stay in the box
    if [ "$nogpu" != 1 ] && [ -d /dev/dri ]; then
        gpu+=(--bind=/dev/dri); props+=(--property=DeviceAllow="char-drm rw")
    fi
    _nspawn_supports_raf && raf=(--restrict-address-families="AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET")
    # KillMode=mixed: on stop, SIGTERM reaches nspawn (clean container poweroff),
    # not the container PID 1 (where SIGTERM means reexec, hanging the host).
    systemd-run --unit="$MACHINE_NAME" --collect --service-type=notify \
        --description="Waterbox container ($MACHINE_NAME)$mode_label" \
        --property=KillMode=mixed --property=TimeoutStopSec=30 --property=SuccessExitStatus=133 \
        --property=MemoryHigh="$WATERBOX_MEMORY_HIGH" \
        --property=MemoryMax="$WATERBOX_MEMORY_MAX" \
        --property=MemorySwapMax="$swap_max" \
        --property=TasksMax="$WATERBOX_TASKS_MAX" \
        --property=CPUWeight="$WATERBOX_CPU_WEIGHT" \
        --property=IOWeight="$WATERBOX_IO_WEIGHT" \
        --property=OOMPolicy=continue \
        "${unit_mode[@]}" \
        "${props[@]}" \
        systemd-nspawn --boot --quiet --keep-unit --notify-ready=yes \
            --directory="$JAIL_ROOT" --machine="$MACHINE_NAME" --network-veth \
            "${userns[@]}" \
            --resolv-conf=off --capability=CAP_NET_ADMIN,CAP_NET_RAW --bind=/dev/net/tun \
            "${raf[@]}" \
            "${gpu[@]}"
    running || { echo "helper: boot failed"; exit 3; }
    if ! mount_collected_shares; then
        echo "helper: a configured share could not be mounted securely; stopping the box" >&2
        power_off || true
        return 3
    fi
    if [ "$gui" = 1 ] && ! mount_collected_gui; then
        echo "helper: GUI sockets could not be mounted securely; stopping the box" >&2
        power_off || true
        return 3
    fi
    net_up || true
}

# Run tmux inside the running container as uid 1000 (leader-PID + nsenter). The
# args run at the container's uid-1000 level — the same as an attached shell — so
# this grants the host user nothing beyond what `attach` already does.
#
# SECURITY: --all, not just --mount. Entering ONLY the mount namespace runs the
# box's /usr/bin/tmux (which container root can replace) while the process keeps the
# HOST's pid/net/ipc namespaces — enough to ptrace host processes or reach host
# abstract sockets (e.g. @/tmp/.X11-unix/X0, bypassing --no-gui). --all puts it fully
# inside all of the box namespaces. In the explicit host-root mode this cannot add
# isolation that the user deliberately disabled, but it still avoids mixing a
# container-controlled binary with host PID/network/IPC namespaces.
run_tmux() {
    running && approved_box || return 3
    local leader
    leader=$(machinectl show "$MACHINE_NAME" -p Leader --value 2>/dev/null)
    [ -n "$leader" ] && [ "$leader" != 0 ] || return 3
    nsenter --target "$leader" --all --setuid 1000 --setgid 1000 \
        env TMUX_TMPDIR=/tmp HOME="/home/$USER_NAME" /usr/bin/tmux "$@"
}

# schedule-command timers live in the container's OWN systemd (run as the water
# user), so a sandboxed agent can't ride one to escape. The helper only writes the
# root-owned unit files + reloads; it FIXES User= and the ExecStart shape, so the
# caller can't smuggle a different command or user in.
_sched_install() {
    local id="$1" sess="$2" time="$3" mode="$4" base="waterbox-$1"
    local hh=${time%:*} mm=${time#*:} cal ts msg="$TASK_MSG_DIR/${1}.msg"
    running && approved_box \
        || { echo "helper: refusing to schedule in an unapproved legacy box" >&2; return 3; }
    if [ "$mode" = daily ]; then
        cal="*-*-* ${hh}:${mm}:00"
    else
        ts=$(date -d "today ${time}" +%s) || return 1
        [ "$ts" -le "$(date +%s)" ] && ts=$(date -d "tomorrow ${time}" +%s)
        cal=$(date -d "@$ts" '+%Y-%m-%d %H:%M:00')
    fi
    printf '%s\n' \
        "[Unit]" "Description=Waterbox scheduled command (-> $sess @ $time $mode)" "" \
        "[Service]" "Type=oneshot" "User=$USER_NAME" \
        "Environment=HOME=/home/$USER_NAME" \
        "Environment=PATH=/usr/local/bin:/usr/bin:/home/$USER_NAME/.local/bin" \
        "Environment=TMUX_TMPDIR=/tmp" \
        "ExecStart=/usr/local/bin/waterbox-fire send $sess $msg" \
        | run_in_approved_box /bin/sh -c 'umask 022; cat > "$1"' sh "$TASK_ETC/$base.service"
    printf '%s\n' \
        "[Unit]" "Description=Waterbox scheduled command (-> $sess @ $time $mode)" \
        "# waterbox: $sess @ $time $mode" "" \
        "[Timer]" "OnCalendar=$cal" "AccuracySec=30sec" "" \
        "[Install]" "WantedBy=timers.target" \
        | run_in_approved_box /bin/sh -c 'umask 022; cat > "$1"' sh "$TASK_ETC/$base.timer"
    run_in_approved_box /bin/mkdir -p "$TASK_ETC/timers.target.wants"
    run_in_approved_box /bin/ln -sf "../$base.timer" "$TASK_ETC/timers.target.wants/$base.timer"
    systemctl -M "$MACHINE_NAME" daemon-reload 2>/dev/null \
        || { echo "helper: container systemd could not reload $base" >&2; return 1; }
    systemctl -M "$MACHINE_NAME" start "$base.timer" 2>/dev/null \
        || { echo "helper: container systemd could not start $base.timer" >&2; return 1; }
}
_sched_remove() {
    local id="$1" base="waterbox-$1"
    if running; then
        approved_box \
            || { echo "helper: refusing to alter schedules in an unapproved legacy box" >&2; return 3; }
        systemctl -M "$MACHINE_NAME" stop "$base.timer" 2>/dev/null || true
        systemctl -M "$MACHINE_NAME" disable "$base.timer" 2>/dev/null || true
        run_in_approved_box /bin/rm -f \
            "$TASK_ETC/$base.timer" "$TASK_ETC/$base.service" \
            "$TASK_ETC/timers.target.wants/$base.timer" "$TASK_MSG_DIR/${id}.msg"
        systemctl -M "$MACHINE_NAME" daemon-reload 2>/dev/null || true
        return 0
    fi
    _in_jail "$JAIL_ROOT$TASK_ETC/$base.timer" \
        && _in_jail "$JAIL_ROOT$TASK_ETC/$base.service" \
        && _in_jail "$JAIL_ROOT$TASK_ETC/timers.target.wants/$base.timer" \
        && _in_jail "$JAIL_ROOT$TASK_MSG_DIR/${id}.msg" \
        || { echo "helper: refusing to remove schedule paths outside the rootfs" >&2; return 3; }
    rm -f "$JAIL_ROOT$TASK_ETC/$base.timer" "$JAIL_ROOT$TASK_ETC/$base.service" \
          "$JAIL_ROOT$TASK_ETC/timers.target.wants/$base.timer" \
          "$JAIL_ROOT$TASK_MSG_DIR/${id}.msg"
}

# Compute an OnCalendar from HH:MM + once|daily (helper-side so the caller never
# hands us a free-form calendar string that could smuggle unit directives).
_oncalendar() {
    local time="$1" mode="$2" hh mm ts
    hh=${time%:*}; mm=${time#*:}
    if [ "$mode" = daily ]; then
        echo "*-*-* ${hh}:${mm}:00"
    else
        ts=$(date -d "today ${time}" +%s) || return 1
        [ "$ts" -le "$(date +%s)" ] && ts=$(date -d "tomorrow ${time}" +%s)
        date -d "@$ts" '+%Y-%m-%d %H:%M:00'
    fi
}

# Next free host-wake id (max existing +1).
_next_hostwake_id() {
    local f n max=0
    for f in "$HW_ETC"/waterbox-hostwake-*.timer; do
        [ -e "$f" ] || continue
        n=$(basename "$f" .timer); n="${n##*-}"
        case "$n" in ''|*[!0-9]*) continue ;; esac
        [ "$n" -gt "$max" ] && max="$n"
    done
    echo $((max + 1))
}

# Write + enable a host wake timer. <id> <profile> <OnCalendar> <label>. Callers
# pass only validated pieces; OnCalendar is computed here or a concrete datetime.
_write_host_wake() {
    local id="$1" prof="$2" cal="$3" label="$4" base="waterbox-hostwake-$1"
    printf '%s\n' \
        "[Unit]" "Description=Waterbox quota wake ($label)" "" \
        "[Service]" "Type=oneshot" \
        "ExecStart=$0 wake $prof --user $wb_uid" \
        > "$HW_ETC/$base.service"
    printf '%s\n' \
        "[Unit]" "Description=Waterbox quota wake ($label)" \
        "# waterbox: $label" "" \
        "[Timer]" "OnCalendar=$cal" "AccuracySec=30sec" "" \
        "[Install]" "WantedBy=timers.target" \
        > "$HW_ETC/$base.timer"
    systemctl daemon-reload
    systemctl enable --now "$base.timer" >/dev/null 2>&1 || true
}

# req 11: if the wake's output says the quota is capped ("… resets 9:10am
# (Asia/Bangkok)"), schedule a ONE-SHOT retry at that reset time + 10 minutes.
# Parses the time and its timezone, converts to an absolute host-local datetime.
_reschedule_on_limit() {
    local prof="$1" out="$2" line after t tz e now target cal id
    printf '%s' "$out" | grep -qiE 'resets ' || return 0
    line=$(printf '%s' "$out" | grep -iE 'resets ' | head -1)
    after=$(printf '%s' "$line" | sed -n 's/.*[Rr]esets[[:space:]]*//p')
    t=$(printf '%s' "$after" | grep -oiE '^[0-9]{1,2}(:[0-9]{2})?[[:space:]]*(am|pm)?' | head -1)
    [ -n "$t" ] || return 0
    tz=$(printf '%s' "$line" | grep -oE '\([A-Za-z]+/[A-Za-z_]+\)' | head -1 | tr -d '()')
    e=$(TZ="$tz" date -d "$t" +%s 2>/dev/null) || return 0
    [ -n "$e" ] || return 0
    now=$(date +%s)
    [ "$e" -le "$now" ] && e=$(TZ="$tz" date -d "tomorrow $t" +%s 2>/dev/null)
    [ -n "$e" ] || return 0
    target=$((e + 600))
    cal=$(date -d "@$target" '+%Y-%m-%d %H:%M:00' 2>/dev/null) || return 0
    id=$(_next_hostwake_id)
    _write_host_wake "$id" "$prof" "$cal" "$prof (auto-retry after quota reset)"
    logger -t waterbox "wake: $prof quota-capped; retry scheduled $cal" 2>/dev/null || true
}

case "$verb" in
    up)    boot_min ;;
    down)  power_off ;;
    state) running && echo running || echo stopped ;;
    security-state)
        running || { echo stopped; exit 0; }
        if secure_userns; then
            echo secure
        elif unsafe_unit; then
            echo unsafe-explicit
        else
            echo legacy
        fi
        ;;
    net-down) net_down ;;
    boot)
        gui=0; nogpu=0; unsafe=0
        for a in "$@"; do
            case "$a" in
                --gui) gui=1 ;;
                --no-gpu) nogpu=1 ;;
                --unsafe-host-root) unsafe=1 ;;
                *) echo "helper: unknown boot option '$a'" >&2; exit 2 ;;
            esac
        done
        boot_full "$gui" "$nogpu" "$unsafe"
        ;;
    status)
        status_color=0
        [ "${1:-}" = "--color" ] && status_color=1
        if unsafe_unit; then
            if [ "$status_color" = 1 ]; then
                printf '\033[1;31mUNSAFE: private-user isolation is OFF; container root is host root.\033[0m\n\n'
            else
                echo "UNSAFE: private-user isolation is OFF; container root is host root."
                echo
            fi
        elif ! secure_userns; then
            if [ "$status_color" = 1 ]; then
                printf '\033[1;31mUNAPPROVED LEGACY BOX: host-root mode was not explicitly authorized.\033[0m\n\n'
            else
                echo "UNAPPROVED LEGACY BOX: host-root mode was not explicitly authorized."
                echo
            fi
        fi
        machinectl status "$MACHINE_NAME" --no-pager 2>/dev/null | head -n 12 || true
        echo
        resource_status "$status_color"
        ;;
    ensure-dns)
        # Guarantee the box can resolve names. Some hosts (or the container's own
        # systemd-resolved) leave /etc/resolv.conf pointing at an unreachable stub
        # (127.0.0.53). Read the desired resolv.conf on stdin (validated), test the
        # box, and only rewrite if it currently can't resolve — so a working host
        # split-DNS setup is left untouched. The rewrite removes any symlink first,
        # so a container resolver can't keep hijacking the file.
        running || exit 0
        _rtmp=$(mktemp)
        while IFS= read -r line; do
            case "$line" in
                "nameserver "*) ip="${line#nameserver }"
                    case "$ip" in ''|*[!0-9a-fA-F:.]*) continue ;; esac
                    echo "nameserver $ip" >> "$_rtmp" ;;
                "options "*) opt="${line#options }"
                    case "$opt" in *[!a-z0-9:\ ]*) continue ;; esac
                    echo "options $opt" >> "$_rtmp" ;;
            esac
        done
        if systemd-run -M "$MACHINE_NAME" -q --wait --pipe getent ahostsv4 example.com >/dev/null 2>&1; then
            rm -f "$_rtmp"; exit 0
        fi
        [ -s "$_rtmp" ] || { rm -f "$_rtmp"; exit 0; }
        # Write from inside the approved box's mount namespace. This removes the
        # check-then-open race a malicious box could otherwise win by swapping an
        # /etc symlink between a host-side realpath() check and a root write.
        run_in_approved_box /bin/sh -c \
            'rm -f /etc/resolv.conf && umask 022 && cat > /etc/resolv.conf' \
            < "$_rtmp" || { rm -f "$_rtmp"; exit 2; }
        rm -f "$_rtmp"
        systemd-run -M "$MACHINE_NAME" -q --wait --pipe getent ahostsv4 example.com >/dev/null 2>&1 \
            && echo "helper: repaired container DNS" || echo "helper: DNS still failing after resolv.conf rewrite"
        ;;
    tmux)  run_tmux "$@" ;;
    shell)
        running && approved_box \
            || { echo "helper: refusing a shell in an unapproved legacy host-root box" >&2; exit 3; }
        sess="${1:-}"; key="${2:-}"; sub="${3:-}"
        _valid_session "$sess" || { echo "helper: bad session"; exit 2; }
        # Optional start dir: a path UNDER the workspace — a single share basename, or
        # a nested path when a PARENT dir is the actual share (`--here` in a subdir of a
        # shared folder). Forbid absolute + any '.'/'..'/empty segment, so it can only
        # ever resolve within $CONTAINER_WORKSPACE. Ignored when the session already
        # exists (new-session -A just re-attaches).
        startdir="$CONTAINER_WORKSPACE"
        if [ -n "$sub" ]; then
            case "$sub" in /*) echo "helper: bad subdir"; exit 2 ;; esac
            _rest="$sub"
            while [ -n "$_rest" ]; do
                _seg="${_rest%%/*}"
                case "$_seg" in ''|.|..) echo "helper: bad subdir"; exit 2 ;; esac
                if [ "$_rest" = "$_seg" ]; then _rest=""; else _rest="${_rest#*/}"; fi
            done
            startdir="$CONTAINER_WORKSPACE/$sub"
        fi
        env_args=()
        [ -n "$key" ] && env_args=(-E "ANTHROPIC_API_KEY=$key")
        exec machinectl shell "${env_args[@]}" "$USER_NAME@$MACHINE_NAME" \
            /usr/bin/tmux new-session -A -s "$sess" -c "$startdir"
        ;;
    sched-install)
        id="$1"; sess="$2"; time="$3"; mode="$4"
        _valid_schedid "$id"   || { echo "helper: bad id"; exit 2; }
        _valid_session "$sess" || { echo "helper: bad session"; exit 2; }
        _valid_time "$time"    || { echo "helper: bad time"; exit 2; }
        [ "$mode" = once ] || [ "$mode" = daily ] || { echo "helper: bad mode"; exit 2; }
        _sched_install "$id" "$sess" "$time" "$mode"
        ;;
    sched-msg)
        id="$1"; _valid_schedid "$id" || { echo "helper: bad id"; exit 2; }
        # Command text is data only. Write it from inside the box namespace so
        # box-controlled symlinks can resolve only within the box.
        run_in_approved_box /bin/sh -c \
            'mkdir -p "$1"; umask 077; cat > "$1/$2.msg"' sh "$TASK_MSG_DIR" "$id"
        ;;
    sched-remove)
        id="$1"; _valid_schedid "$id" || { echo "helper: bad id"; exit 2; }
        _sched_remove "$id"
        ;;
    sched-rename)
        # Repoint every schedule-command timer aimed at session <old> to <new> by
        # rewriting it in place (same id keeps its .msg command). Time-of-day + mode
        # are pulled from the timer's own "# waterbox:" line; _sched_install re-fixes
        # User= and the ExecStart shape, so nothing new can be smuggled in.
        old="$1"; new="$2"
        _valid_session "$old" || { echo "helper: bad session"; exit 2; }
        _valid_session "$new" || { echo "helper: bad session"; exit 2; }
        for f in "$JAIL_ROOT$TASK_ETC"/waterbox-schd-com-*.timer; do
            [ -e "$f" ] || continue
            info=$(grep -m1 '^# waterbox:' "$f" 2>/dev/null | sed 's/^# waterbox: //')
            [ "${info%% @ *}" = "$old" ] || continue
            rest="${info#* @ }"                     # "<time> <mode>"
            time="${rest%% *}"; mode="${rest##* }"
            _valid_time "$time" || continue
            [ "$mode" = once ] || [ "$mode" = daily ] || continue
            base=$(basename "$f" .timer); id="${base#waterbox-}"
            # The id comes from a filename the box can create, so validate it like
            # every other id we take, rather than trusting the glob alone.
            _valid_schedid "$id" || continue
            _sched_install "$id" "$new" "$time" "$mode"
        done
        ;;
    unshare)
        name="$1"
        case "$name" in ''|.|..|*/*) echo "helper: bad name"; exit 2 ;; esac
        target="$CONTAINER_WORKSPACE/$name"
        if running; then
            run_in_approved_box /bin/sh -c \
                'umount -l "$1" 2>/dev/null || true; rmdir "$1" 2>/dev/null || true' \
                sh "$target"
        else
            _in_jail "$JAIL_ROOT$target" \
                && rmdir "$JAIL_ROOT$target" 2>/dev/null || true
        fi
        ;;
    wake)
        prof="${1:-}"
        _valid_profile "$prof" || { echo "helper: bad profile"; exit 2; }
        # No such account (either layout: new tree, or pre-1.9 flat one): no-op.
        [ -d "$JAIL_ROOT/home/$USER_NAME/.agent-env/claude/$prof" ] \
            || [ -d "$JAIL_ROOT/home/$USER_NAME/.claude-env/$prof" ] || exit 0
        started=0
        if running; then
            approved_box \
                || { echo "helper: refusing to wake an unapproved legacy host-root box" >&2; exit 3; }
        else
            boot_min
            started=1
        fi
        out=$(systemd-run -M "$MACHINE_NAME" --quiet --wait --pipe \
            -p User="$USER_NAME" \
            -p Environment=HOME="/home/$USER_NAME" \
            -p Environment=PATH="/usr/local/bin:/usr/bin:/home/$USER_NAME/.local/bin" \
            -p Environment=TMUX_TMPDIR=/tmp \
            /usr/local/bin/waterbox-fire wake "$prof" 2>/dev/null || true)
        [ "$started" = 1 ] && power_off
        _reschedule_on_limit "$prof" "$out"
        ;;
    install-host-wake)
        # <id> <profile> <HH:MM> <once|daily>
        id="$1"; prof="$2"; time="$3"; mode="$4"
        _valid_id "$id"       || { echo "helper: bad id"; exit 2; }
        _valid_profile "$prof"|| { echo "helper: bad profile"; exit 2; }
        _valid_time "$time"   || { echo "helper: bad time"; exit 2; }
        [ "$mode" = once ] || [ "$mode" = daily ] || { echo "helper: bad mode"; exit 2; }
        cal="$(_oncalendar "$time" "$mode")" || { echo "helper: bad time"; exit 2; }
        _write_host_wake "$id" "$prof" "$cal" "$prof @ $time $mode"
        ;;
    remove-host-wake)
        id="$1"; _valid_id "$id" || { echo "helper: bad id"; exit 2; }
        base="waterbox-hostwake-$id"
        systemctl disable --now "$base.timer" >/dev/null 2>&1 || true
        rm -f "$HW_ETC/$base.timer" "$HW_ETC/$base.service"
        systemctl daemon-reload
        ;;
    bind-share)
        # Live sharing uses the same one-ID mount as cold boot. Never fall back to
        # machinectl bind/noidmap: those either reject private users or expose the
        # share with unusable/unsafe ownership.
        requested="${1:-}"
        [ -d "$requested" ] || { echo "helper: share source is not a directory" >&2; exit 2; }
        requested=$(realpath "$requested" 2>/dev/null) \
            || { echo "helper: could not resolve share source" >&2; exit 2; }
        collect_share_mounts
        found=0
        for src in "${SHARE_SOURCES[@]}"; do
            [ "$src" = "$requested" ] && { found=1; break; }
        done
        [ "$found" = 1 ] \
            || { echo "helper: share is not present in the validated share list" >&2; exit 2; }
        mount_one_share "$requested"
        ;;
    share-users)
        # List processes INSIDE the box still using the share at ~/workspace/<name>
        # (cwd, root, or an open file under it) as "PID COMM" lines. Enters ALL the
        # container's namespaces (--all) and reads its own /proc — no in-box tools
        # needed. --all matters here: this runs as root, and with only --mount the
        # box's /bin/sh (which container root owns) would execute in the HOST's
        # pid/net namespaces — a straight escape. Inside the box it's just root in
        # the box, which is what it already is.
        # Used to warn before a detach, whose lazy-unmount would strand those processes
        # on a stale, disconnected copy of the mount. Never fatal (best-effort).
        name="$1"
        case "$name" in ''|.|..|*/*) echo "helper: bad name"; exit 2 ;; esac
        running || exit 0
        approved_box \
            || { echo "helper: refusing to enter an unapproved legacy host-root box" >&2; exit 3; }
        leader=$(machinectl show "$MACHINE_NAME" -p Leader --value 2>/dev/null)
        [ -n "$leader" ] && [ "$leader" != 0 ] || exit 0
        target="$CONTAINER_WORKSPACE/$name"
        nsenter --target "$leader" --all -- /bin/sh -c '
            cd / 2>/dev/null || true
            t=$1
            for p in /proc/[0-9]*; do
                hit=""
                for l in "$p/cwd" "$p/root"; do
                    d=$(readlink "$l" 2>/dev/null) || continue
                    case "$d" in "$t"|"$t"/*) hit=1; break ;; esac
                done
                if [ -z "$hit" ] && [ -d "$p/fd" ]; then
                    for f in "$p"/fd/*; do
                        d=$(readlink "$f" 2>/dev/null) || continue
                        case "$d" in "$t"|"$t"/*) hit=1; break ;; esac
                    done
                fi
                [ -n "$hit" ] || continue
                printf "%s %s\n" "${p#/proc/}" "$(cat "$p/comm" 2>/dev/null || echo ?)"
            done
        ' sh "$target" 2>/dev/null || true
        ;;
    *) echo "helper: unknown verb '$verb'"; exit 2 ;;
esac
HELPER
    } > "$tmp"
    sudo install -m 0755 -o root -g root "$tmp" "$HELPER_PATH"
    rm -f "$tmp"

    local sd; sd=$(mktemp)
    printf '%s\n' \
        "# waterbox: allow only the immutable helper, passwordless. No other command" \
        "# is passwordless, and the helper takes fixed, charset-validated verbs." \
        "$RUN_USER ALL=(root) NOPASSWD: $HELPER_PATH" > "$sd"
    if ! sudo visudo -cf "$sd" >/dev/null; then rm -f "$sd"; log_error "Helper sudoers failed validation."; fi
    sudo install -m 0440 -o root -g root "$sd" "$HELPER_SUDOERS"
    rm -f "$sd"
    # Remove the old broad credential cache from pre-1.3 installs: with every runtime
    # op behind the helper, no general passwordless/never-expiring sudo is needed.
    sudo rm -f /etc/sudoers.d/waterbox 2>/dev/null || true
    log_success "Root helper installed at $HELPER_PATH (passwordless via $HELPER_SUDOERS)."
}

# True unless an up-to-date helper is already installed (version marker matches).
_helper_current() {
    [ -x "$HELPER_PATH" ] && grep -q "^WB_HELPER_VERSION=\"$(_config_marker)\"\$" "$HELPER_PATH" 2>/dev/null
}
ensure_helper() { _helper_current || install_helper; }
run_priv() { sudo "$HELPER_PATH" "$@"; }

# Idempotently ensure the host-side privileges start/reset rely on: the immutable
# helper (+ its narrow sudoers) and shell completion. No broad sudo cache anymore.
ensure_host_privs() {
    ensure_helper
    enable_completion
}

# --- Shares (req 7 safety: refuse paths a sandboxed root could use to escape) --
# Same policy the helper enforces at boot: allow user-owned paths inside the home
# (minus secret dirs) or user-owned dirs on removable/user mounts. The helper's
# one-ID mount then maps container uid 1000 to that owner without mapping root.
_host_share_allowed() {
    local rp="$1" home_real; home_real=$(realpath "$HOME" 2>/dev/null || echo "$HOME")
    case "$rp" in
        "$home_real"|"$home_real/.ssh"|"$home_real/.ssh/"*|"$home_real/.gnupg"|"$home_real/.gnupg/"*|"$home_real/.config"|"$home_real/.config/"*|"$CONFIG_DIR"|"$CONFIG_DIR/"*) return 1 ;;
        "$home_real/"*)
            [ "$(stat -c %u "$rp" 2>/dev/null)" = "$(id -u)" ] && return 0 || return 1 ;;
    esac
    case "$rp" in
        /mnt/*|/media/*|/run/media/*)
            [ "$(stat -c %u "$rp" 2>/dev/null)" = "$(id -u)" ] && return 0 || return 1 ;;
    esac
    return 1
}
manage_share() {
    local action="$1"
    local target_path="$2"
    [ -z "$target_path" ] && log_error "Missing path. Usage: waterbox share [add <path> | detach <path> | list]"

    # Expand a leading ~ or ~/… to $HOME (the value often comes from the TUI, where
    # the shell never got to do tilde expansion).
    case "$target_path" in
        '~')   target_path="$HOME" ;;
        '~/'*) target_path="$HOME/${target_path#\~/}" ;;
    esac

    local absolute_path
    absolute_path=$(realpath "$target_path" 2>/dev/null || echo "$target_path")
    local folder_name
    folder_name=$(basename "$absolute_path")
    local mount_target="$CONTAINER_WORKSPACE/$folder_name"

    case "$action" in
        add)
            [ -d "$absolute_path" ] || log_error "Directory does not exist on host: $absolute_path"

            # Only user-owned top directories can be owner-mapped. This ensures the
            # one mapped identity is the invoking host user, never host root.
            if ! _host_share_allowed "$absolute_path"; then
                log_error "Refusing to share '$absolute_path': share a directory you own inside your home, /mnt, /media or /run/media."
            fi

            if grep -Fxq "$absolute_path" "$SHARE_LIST"; then
                log_info "'$absolute_path' is already shared."
                return 0
            fi
            # Destinations are basename-based. Never allow two different host paths
            # to claim the same in-box path: live mounting used to silently leave the
            # first one active, making edits land in the wrong project.
            local existing
            while IFS= read -r existing || [ -n "$existing" ]; do
                [ -n "$existing" ] || continue
                if [ "$(basename "$existing")" = "$folder_name" ]; then
                    log_error "Cannot share '$absolute_path': '$existing' already uses $mount_target. Rename one directory first."
                fi
            done < "$SHARE_LIST"
            echo "$absolute_path" >> "$SHARE_LIST"
            if is_running; then
                if ! run_priv bind-share "$absolute_path"; then
                    # A filesystem may not support ID-mapped mounts. Do not leave a
                    # broken persistent entry that would make the next boot fail too.
                    grep -vFx "$absolute_path" "$SHARE_LIST" > "${SHARE_LIST}.tmp" || true
                    mv "${SHARE_LIST}.tmp" "$SHARE_LIST"
                    log_error "Could not mount '$absolute_path' securely. The share was not added (the source filesystem may not support ID-mapped mounts)."
                fi
                log_success "Added '$absolute_path' and mounted it live at $mount_target."
            else
                log_success "Added '$absolute_path' (will mount at $mount_target on next start)."
            fi
            ;;
        del|detach)
            if ! grep -Fxq "$absolute_path" "$SHARE_LIST"; then
                log_error "Path '$absolute_path' is not currently shared."
            fi
            # Warn (and confirm) if the box is still using it — a lazy-unmount would
            # strand those processes. Only prompts when actually in use, so a clean
            # detach stays non-interactive/scriptable.
            if _print_share_in_use "$folder_name"; then
                printf "Detach anyway? [y/N] " > /dev/tty
                local ans=""; IFS= read -r ans < /dev/tty || true
                [[ "$ans" == [Yy]* ]] || { log_info "Kept '$absolute_path' shared."; return 0; }
            fi
            # grep -v exits 1 when it removes the *last* line (zero output), so
            # don't gate the mv on it — otherwise detaching the only share no-ops.
            grep -vFx "$absolute_path" "$SHARE_LIST" > "${SHARE_LIST}.tmp" || true
            mv "${SHARE_LIST}.tmp" "$SHARE_LIST"

            # Live lazy-unmount in the container's mount namespace + drop the empty
            # mountpoint, all inside the helper (no broad sudo).
            _helper_current && run_priv unshare "$folder_name" 2>/dev/null || true
            log_success "Detached '$absolute_path' (unmounted; no files deleted)."
            ;;
    esac
}

list_shares() {
    log_info "Paths exposed to waterbox:"
    if [ ! -s "$SHARE_LIST" ]; then
        echo "  (none)"
    else
        while IFS= read -r line; do
            [ -z "$line" ] && continue
            echo "  -> $line  (inside: $CONTAINER_WORKSPACE/$(basename "$line"))"
        done < "$SHARE_LIST"
    fi
}

# --- Scheduled tasks: wake-claude (quota primer) + schedule-command -----------
# Both are systemd timers *inside the container's own systemd*, run as the water
# user — so they need NO host sudo/password when they fire (the container's PID 1
# runs them). Keeping them in-container, not a host root timer executing this
# mutable script, means a sandboxed agent can never ride one to escape.
TASK_ETC="/etc/systemd/system"     # inside the rootfs
TASK_MSG_DIR="/etc/waterbox"       # inside the rootfs (schedule-command messages)

# The in-container helper. `wake <profile>` sends a tiny Haiku 'hi' to start the
# account's 5-hour window then deletes the throwaway transcript; `send <session>
# <msgfile>` types the message + Enter into an existing tmux session.
# --- Default Claude statusline ------------------------------------------------
# ONE statusline for every account, in the place Claude Code already expects it.
# Every account's settings.json points at this single file, so all of them show the
# same line and there is only one thing to edit.
#
# ~/.claude/statusline-command.sh is deliberate, not arbitrary: `/statusline` writes
# its script into ~/.claude/ and the agent behind it can only Read and Edit, never
# create — so, finding settings already pointed here, it rewrites THIS file. Ask any
# account for a new statusline and every account gets it. Hand-editing works the same.
#
# So the file is yours the moment you touch it: waterbox reseeds it only while it is
# still byte-for-byte what waterbox wrote (see _statusline_untouched). Once changed,
# updates leave it alone forever. Delete it to get the default back.
#
# To drop the statusline on ONE account, set "statusLine": null in that account's
# settings.json — the key is only ever ADDED when missing, never overwritten.
STATUSLINE_PATH="/home/$USER_NAME/.claude/statusline-command.sh"
STATUSLINE_CMD="~/.claude/statusline-command.sh"   # as written into settings.json
STATUSLINE_OLD="/usr/local/bin/waterbox-statusline" # pre-1.9.1 location, cleaned up

# The script body. Kept in its own function so the version marker can be a checksum
# of it: edit the line below and every box self-heals on the next 'start', with no
# WATERBOX_VERSION bump needed.
_statusline_body() { cat <<'SL'
# waterbox's default Claude Code statusline. Renders one line:
#
#   [claude-opus-5 (high) · mylinux (master*) · ctx 17% · q5h 69% (49min) · $1.87]
#
# Claude Code's own footer badges ("bypass permissions on", "for agents") render on
# their own row underneath and can't be merged into this one — that row is built in.
#
# Edit this file freely, or ask any account's Claude for a new one with /statusline:
# every account reads this same script, and waterbox stops reseeding it the moment it
# stops matching what waterbox wrote. Delete it to get this default back.

# Claude Code sends one JSON object on stdin. Read it with python3 (guaranteed: it's
# in PKGS) and pull the fields defensively — most are absent early in a session,
# rate_limits only exists for Pro/Max accounts after the first API response, and
# effort only for models that take a reasoning-effort parameter.
_wb_fields=$(python3 -c '
import json, sys, time
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
def g(*ks):
    cur = d
    for k in ks:
        if not isinstance(cur, dict): return None
        cur = cur.get(k)
    return cur
ctx  = g("context_window", "used_percentage")
five = g("rate_limits", "five_hour", "used_percentage")
cost = g("cost", "total_cost_usd")
# Time to the quota reset. Formatted here rather than in the shell: python already
# has the epoch maths, and "2h05" needs zero padding that sh would need a fork for.
end  = g("rate_limits", "five_hour", "resets_at")
left = ""
if isinstance(end, (int, float)) and not isinstance(end, bool):
    mins = -int(-(end - time.time()) // 60)   # round UP: 30s left is still "1min"
    if mins > 0:
        left = "%dh%02d" % (mins // 60, mins % 60) if mins >= 60 else "%dmin" % mins
    else:
        # The window that percentage was measured in has ended. Claude Code only
        # refreshes rate_limits on an API response, so the cached number can sit at
        # 69% long after the reset — but the clock it shipped with says otherwise.
        # Trust the clock: show 0 until a real response replaces both.
        # (No apostrophes in here: the whole block is inside a '...' shell quote.)
        five = 0
print(g("workspace", "current_dir") or g("cwd") or "")
print(g("model", "display_name") or "-")
print(g("effort", "level") or "")
print("" if ctx  is None else int(ctx))
print("" if five is None else int(five))
print(left)
print("" if not cost else "%.2f" % cost)
')
_wb_cwd=$(printf   '%s\n' "$_wb_fields" | sed -n 1p)
_wb_model=$(printf '%s\n' "$_wb_fields" | sed -n 2p)
_wb_eff=$(printf   '%s\n' "$_wb_fields" | sed -n 3p)
_wb_ctx=$(printf   '%s\n' "$_wb_fields" | sed -n 4p)
_wb_five=$(printf  '%s\n' "$_wb_fields" | sed -n 5p)
_wb_left=$(printf  '%s\n' "$_wb_fields" | sed -n 6p)
_wb_cost=$(printf  '%s\n' "$_wb_fields" | sed -n 7p)

# Just the leaf directory: the branch next to it usually says which project it is,
# and a short line is the whole point. ${x##*/} to avoid forking basename.
_wb_dir=${_wb_cwd##*/}
[ "$_wb_cwd" = "$HOME" ] && _wb_dir='~'
[ "$_wb_cwd" = "/" ]     && _wb_dir='/'

# --no-optional-locks: never write to .git just to paint a status line. The -d guard
# matters: with an empty cwd, `git -C ""` would silently report OUR directory's branch.
_wb_branch=""
[ -n "$_wb_cwd" ] && [ -d "$_wb_cwd" ] && \
    _wb_branch=$(git --no-optional-locks -C "$_wb_cwd" rev-parse --abbrev-ref HEAD 2>/dev/null)
if [ -n "$_wb_branch" ]; then
    git --no-optional-locks -C "$_wb_cwd" diff --quiet HEAD 2>/dev/null || _wb_branch="$_wb_branch*"
fi

# Context and quota both fill up silently, so colour them the same way:
# green -> yellow at 50% -> red at 80%. Sets _wb_cc (no subshell, no fork).
_wb_pct_colour() {
    _wb_cc='\033[32m'
    if [ -n "$1" ]; then
        [ "$1" -ge 50 ] 2>/dev/null && _wb_cc='\033[33m'
        [ "$1" -ge 80 ] 2>/dev/null && _wb_cc='\033[31m'
    fi
    return 0
}
_wb_pct_colour "$_wb_ctx";  _wb_ctx_c="$_wb_cc"
_wb_pct_colour "$_wb_five"; _wb_five_c="$_wb_cc"

# Assembled as a plain string with literal escapes, emitted once with %b. Every
# segment is optional — early in a session this is just [model · dir].
_wb_out="\033[90m[\033[0m\033[35m$_wb_model\033[0m"
[ -n "$_wb_eff" ]    && _wb_out="$_wb_out \033[90m($_wb_eff)\033[0m"
[ -n "$_wb_dir" ]    && _wb_out="$_wb_out \033[90m·\033[0m \033[36m$_wb_dir\033[0m"
[ -n "$_wb_branch" ] && _wb_out="$_wb_out \033[33m($_wb_branch)\033[0m"
[ -n "$_wb_ctx" ]    && _wb_out="$_wb_out \033[90m· ctx\033[0m $_wb_ctx_c$_wb_ctx%\033[0m"
[ -n "$_wb_five" ]   && _wb_out="$_wb_out \033[90m· q5h\033[0m $_wb_five_c$_wb_five%\033[0m"
[ -n "$_wb_five" ] && [ -n "$_wb_left" ] \
                     && _wb_out="$_wb_out \033[90m($_wb_left)\033[0m"
[ -n "$_wb_cost" ]   && _wb_out="$_wb_out \033[90m·\033[0m \$$_wb_cost"
_wb_out="$_wb_out\033[90m]\033[0m"
printf '%b\n' "$_wb_out"
SL
}

# Checksum of the body, stamped into the file. Edit the body above and every box
# picks it up on the next 'start' — no WATERBOX_VERSION bump needed.
_statusline_marker() { _statusline_body | cksum | tr -d ' '; }

# True when the installed file is still EXACTLY what some waterbox wrote: the stamp
# on line 2 is the checksum of everything below it, so any edit — by you, by a
# /statusline rewrite, by a future waterbox — is self-evident. This is what makes
# "reseed until touched, then hands off" safe without tracking state anywhere else.
_statusline_untouched() {
    local f="$JAIL_ROOT$STATUSLINE_PATH" stamp body
    [ -f "$f" ] || return 1
    stamp=$(sed -n '2s/^# WB_STATUSLINE_MARK=//p' "$f")
    [ -n "$stamp" ] || return 1
    body=$(tail -n +3 "$f" | cksum | tr -d ' ')
    [ "$stamp" = "$body" ]
}

write_statusline() {
    local f="$JAIL_ROOT$STATUSLINE_PATH"
    # Same as above: a symlinked parent dir would point the unlink at a host file.
    _in_jail "$JAIL_ROOT$STATUSLINE_OLD" \
        && sudo rm -f "$JAIL_ROOT$STATUSLINE_OLD" || true   # pre-1.9.1 copy, now unused
    if [ -e "$f" ] && ! _statusline_untouched; then
        return 0                                    # yours now — never clobber it
    fi
    _in_jail "$f" \
        || log_error "Refusing to create the statusline: it resolves outside $JAIL_ROOT. Run 'waterbox reset'."
    sudo mkdir -p "$(dirname "$f")"
    { printf '#!/bin/sh\n# WB_STATUSLINE_MARK=%s\n' "$(_statusline_marker)"
      _statusline_body
    } | wb_tee "$f"
    sudo chmod 0755 "$f"
    sudo chown 1000:1000 "$f"
}

# True when there is nothing for write_statusline to do — either the file is already
# the current default, or you've made it your own.
_statusline_current() {
    local f="$JAIL_ROOT$STATUSLINE_PATH"
    [ -f "$f" ] || return 1
    [ -e "$JAIL_ROOT$STATUSLINE_OLD" ] && return 1   # stale copy still to remove
    _statusline_untouched || return 0
    grep -q "^# WB_STATUSLINE_MARK=$(_statusline_marker)\$" "$f" 2>/dev/null
}

write_task_helper() {
    # A version marker (checked by _fire_current) lets 'start' self-heal a stale copy
    # without a full refresh; the body is a quoted heredoc, so nothing expands in it.
    { printf '#!/bin/sh\n# WB_FIRE_VERSION=%s\n' "$WATERBOX_VERSION"; cat <<'FIRE'
kind="$1"; shift
case "$kind" in
    wake)
        # Claude-only by design: opening a fresh 5-hour quota window with a throwaway
        # ping is a Claude-plan concern, so this stays on Claude's slot rather than
        # looping over the agent registry.
        prof="${1:?profile}"
        # New layout first, pre-1.9 flat one as a fallback: a host wake can fire on a
        # box that hasn't been started (and so migrated) since the upgrade.
        CLAUDE_CONFIG_DIR="$HOME/.agent-env/claude/$prof"
        [ -d "$CLAUDE_CONFIG_DIR" ] || CLAUDE_CONFIG_DIR="$HOME/.claude-env/$prof"
        export CLAUDE_CONFIG_DIR
        [ -d "$CLAUDE_CONFIG_DIR" ] || exit 0
        d="/tmp/waterbox-fire-$$"
        mkdir -p "$d" && cd "$d" || exit 0
        out=$(claude -p "hi" --model haiku 2>&1 || true)
        cd /
        # claude names a project dir after its cwd with '/' -> '-'; drop it so the
        # wake leaves no chat history (and no tmux session) behind.
        rm -rf "$d" "$CLAUDE_CONFIG_DIR/projects/-tmp-waterbox-fire-$$" 2>/dev/null || true
        # Surface a quota-limit line (if any) on stdout so the host helper can
        # schedule a retry (req 11). Normal 'hi' replies are ignored/discarded.
        printf '%s\n' "$out" | grep -iE 'session limit|resets ' | head -1 || true
        ;;
    send)
        sess="$1"; msgfile="$2"
        [ -n "$sess" ] && [ -f "$msgfile" ] || exit 0
        export TMUX_TMPDIR=/tmp
        # Only type into a session whose name matches EXACTLY, so a command for a
        # since-gone 'box' never lands in 'box-2'. grep -Fx is a whole-line exact
        # match that works on every tmux version — send-keys does NOT accept the '='
        # exact-target prefix, so we must not rely on it here.
        if ! tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -qxF "$sess"; then
            logger -t waterbox-fire "send: no live session '$sess' — skipped" 2>/dev/null || true
            exit 0
        fi
        msg=$(cat "$msgfile")
        [ -n "$msg" ] && tmux send-keys -t "$sess" -l -- "$msg"   # empty command → just Enter
        sleep 0.3
        tmux send-keys -t "$sess" Enter
        logger -t waterbox-fire "send: delivered to '$sess' [${msg:-<enter>}]" 2>/dev/null || true
        ;;
    cleanup-session)
        # Remove schedule-commands that targeted a now-closed session (req 14).
        # Fired from the tmux 'session-closed' hook; needs root for the units.
        name="$1"
        [ -n "$name" ] || exit 0
        removed=0
        for f in /etc/systemd/system/waterbox-schd-com-*.timer; do
            [ -e "$f" ] || continue
            info=$(grep -m1 '^# waterbox:' "$f" 2>/dev/null | sed 's/^# waterbox: //')
            [ "${info%% @ *}" = "$name" ] || continue
            base=$(basename "$f" .timer); id=${base#waterbox-}
            sudo systemctl disable --now "$base.timer" >/dev/null 2>&1 || true
            sudo rm -f "/etc/systemd/system/$base.timer" \
                       "/etc/systemd/system/$base.service" \
                       "/etc/waterbox/${id}.msg" 2>/dev/null || true
            removed=1
        done
        [ "$removed" = 1 ] && sudo systemctl daemon-reload >/dev/null 2>&1 || true
        ;;
    rename-session)
        # Fired from the tmux 'session-renamed' hook with the NEW name. @wb_name holds
        # the previous name (seeded at creation / updated here), so we can repoint every
        # schedule-command timer old -> new. Needs root for the units (box gives sudo).
        new="$1"
        [ -n "$new" ] || exit 0
        # NB: show-/set-option don't take the '=' exact prefix — but $new is an exact,
        # unique session name, so plain -t resolves it (exact match wins over prefix).
        old=$(tmux show-options -qv -t "$new" @wb_name 2>/dev/null)
        tmux set-option -t "$new" @wb_name "$new" 2>/dev/null || true
        [ -n "$old" ] && [ "$old" != "$new" ] || exit 0
        # Only repoint between names allowed in units (this also guards the seds).
        case "$old" in ''|*[!A-Za-z0-9._-]*) exit 0 ;; esac
        case "$new" in ''|*[!A-Za-z0-9._-]*) exit 0 ;; esac
        changed=0
        for f in /etc/systemd/system/waterbox-schd-com-*.timer; do
            [ -e "$f" ] || continue
            info=$(grep -m1 '^# waterbox:' "$f" 2>/dev/null | sed 's/^# waterbox: //')
            [ "${info%% @ *}" = "$old" ] || continue
            base=$(basename "$f" .timer)
            sudo sed -i "s|^# waterbox: $old @|# waterbox: $new @|" "$f" 2>/dev/null || true
            sudo sed -i "s|waterbox-fire send $old |waterbox-fire send $new |" \
                "/etc/systemd/system/$base.service" 2>/dev/null || true
            changed=1
        done
        [ "$changed" = 1 ] && sudo systemctl daemon-reload >/dev/null 2>&1 || true
        ;;
esac
FIRE
    } | wb_tee "$JAIL_ROOT/usr/local/bin/waterbox-fire"
    sudo chmod 0755 "$JAIL_ROOT/usr/local/bin/waterbox-fire"
}

# True when the installed in-box fire helper matches this waterbox version.
_fire_current() {
    [ -x "$JAIL_ROOT/usr/local/bin/waterbox-fire" ] \
        && grep -q "^# WB_FIRE_VERSION=$WATERBOX_VERSION\$" \
            "$JAIL_ROOT/usr/local/bin/waterbox-fire" 2>/dev/null
}

# Next free integer suffix for tasks whose unit base starts with <glob-prefix>
# (e.g. "waterbox-schd-com-"). Ids are simple sequential handles for 'del' — the
# 'list' output carries the human detail (who, time, mode, command).
_next_task_id() {
    local f n max=0
    for f in "$JAIL_ROOT$TASK_ETC/$1"*.timer; do
        [ -e "$f" ] || continue
        n=$(basename "$f" .timer); n="${n##*-}"
        case "$n" in ''|*[!0-9]*) continue ;; esac
        [ "$n" -gt "$max" ] && max="$n"
    done
    echo $((max + 1))
}

# schedule-command timers are written/removed by the root helper (it fixes User=
# and the ExecStart shape). These wrappers take the bare id (e.g. "schd-com-3").
_sched_remove() {
    _helper_current && run_priv sched-remove "$1" >/dev/null 2>&1 || true
}

# Scan timers whose unit name starts with <glob-prefix> into parallel arrays
# TL_IDS (delete handles) and TL_ROWS ("<who @ time mode>[   ->  cmd][   [left]]").
# One-shots whose time has already elapsed (systemd-analyze => "never") are
# garbage-collected here and not returned. $1 = glob prefix   $2 = 1 if a per-id
# message file ($TASK_MSG_DIR/<id>.msg) holds the command to show and clean up.
TL_IDS=(); TL_ROWS=()
_timer_collect() {
    local prefix="$1" hasmsg="$2" f b id info expr cmd msg now shown
    local -a t_ids=() t_rows=() t_keys=()
    now=$(date +%s)
    TL_IDS=(); TL_ROWS=()
    for f in "$JAIL_ROOT$TASK_ETC/${prefix}"*.timer; do
        [ -e "$f" ] || continue
        b=$(basename "$f" .timer); id="${b#waterbox-}"
        info=$(grep -m1 '^# waterbox:' "$f" 2>/dev/null | sed 's/^# waterbox: //')
        expr=$(grep -m1 '^OnCalendar=' "$f" 2>/dev/null | sed 's/^OnCalendar=//')
        msg="$JAIL_ROOT$TASK_MSG_DIR/${id}.msg"
        _timer_next "tc-$id" "$expr" "$now"
        [ "$_TIMER_GC" = 1 ] && { _sched_remove "$id"; continue; }   # elapsed one-shot
        cmd=""; shown=""
        if [ "$hasmsg" = 1 ] && [ -f "$msg" ]; then
            cmd=$(cat "$msg")
            [ -n "$cmd" ] && shown="$cmd" || shown="<enter>"   # empty command = just Enter
        fi
        t_ids+=("$id")
        t_rows+=("${info}${shown:+   ->  $shown}${_TIMER_LEFT:+   [$_TIMER_LEFT]}")
        # key = <session>\t<epoch>\t<index>; session is the 1st token of the info line.
        # Index is plain %d (a zero-padded "0008" would be misread as octal).
        t_keys+=("$(printf '%s\t%011d\t%d' "${info%% @ *}" "${_TIMER_EPOCH:-99999999999}" "$(( ${#t_ids[@]} - 1 ))")")
    done
    [ "${#t_ids[@]}" -eq 0 ] && return 0
    # Sort by SESSION then time-left (each session's commands grouped, soonest first).
    local idx
    while IFS=$'\t' read -r _ _ idx; do
        [ -n "$idx" ] || continue
        TL_IDS+=("${t_ids[$idx]}"); TL_ROWS+=("${t_rows[$idx]}")
    done < <(printf '%s\n' "${t_keys[@]}" | sort -t $'\t' -k1,1 -k2,2n)
}

# Print the collected timers as a bulleted "  - <id>   <detail>" list.
_timer_list() {
    _timer_collect "$1" "$2"
    local i
    if [ "${#TL_IDS[@]}" -eq 0 ]; then
        echo "  (none)"
    else
        for i in "${!TL_IDS[@]}"; do
            echo "  - ${TL_IDS[$i]}   ${TL_ROWS[$i]}"
        done
    fi
    is_running || echo "  Note: tasks fire only while the box is running."
}

# `wake-claude` — start a profile's fresh 5-hour quota window (default daily).
# Backed by HOST root systemd timers (installed via the helper) that call
# `waterbox-helper wake <profile>`, so a wake fires unattended even while the box is
# powered off — the helper boots the box, primes, and powers it back off.
HOSTWAKE_GLOB="/etc/systemd/system/waterbox-hostwake-"

# Next free integer id across the host wake timers (readable without sudo; 0644).
_hostwake_next_id() {
    local f n max=0
    for f in "$HOSTWAKE_GLOB"*.timer; do
        [ -e "$f" ] || continue
        n=$(basename "$f" .timer); n="${n##*-}"
        case "$n" in ''|*[!0-9]*) continue ;; esac
        [ "$n" -gt "$max" ] && max="$n"
    done
    echo $((max + 1))
}

# Human "time left" from a second count. Seconds are only shown in the final 10
# minutes (< 600s) — that's when a live screen visibly ticks each second; above
# that it's minute-granular (a held countdown doesn't flicker every second).
_fmt_left() {
    local s=$1
    [ "$s" -lt 0 ] && s=0
    local d=$(( s / 86400 )) h=$(( (s % 86400) / 3600 )) m=$(( (s % 3600) / 60 )) sec=$(( s % 60 ))
    if   [ "$s" -lt 600 ]; then
        if [ "$m" -gt 0 ]; then printf '%dm %02ds' "$m" "$sec"
        else                    printf '%ds' "$sec"; fi
    elif [ "$d" -gt 0 ]; then printf '%dd %dh %02dm' "$d" "$h" "$m"
    elif [ "$h" -gt 0 ]; then printf '%dh %02dm' "$h" "$m"
    else                      printf '%dm' "$m"; fi
}

# Shared next-elapse resolver for the live timer screens (wake-claude + schedule-
# command show "time left" identically through this). Given a cache key $1, an
# OnCalendar expression $2, and now=$3 (epoch), it sets:
#   _TIMER_EPOCH  next-elapse epoch ("" if none / unresolvable)
#   _TIMER_LEFT   human "time left" via _fmt_left ("" when there's no epoch)
#   _TIMER_GC     1 when the calendar will never fire again (caller garbage-collects)
# The epoch is cached under $1 in _NEXT_EPOCH so the 1s live refresh doesn't re-spawn
# systemd-analyze every tick — only when the cached elapse has already passed.
declare -A _NEXT_EPOCH
_TIMER_EPOCH=""; _TIMER_LEFT=""; _TIMER_GC=0
_timer_next() {
    local key="$1" expr="$2" now="$3" next nutc epoch
    _TIMER_EPOCH=""; _TIMER_LEFT=""; _TIMER_GC=0
    epoch="${_NEXT_EPOCH[$key]:-}"
    if [ -z "$epoch" ] || [ "$now" -ge "$epoch" ]; then
        epoch=""
        if command -v systemd-analyze >/dev/null 2>&1 && [ -n "$expr" ]; then
            next=$(systemd-analyze calendar "$expr" 2>/dev/null || true)
            if printf '%s' "$next" | grep -q 'Next elapse: *never'; then
                unset "_NEXT_EPOCH[$key]"; _TIMER_GC=1; return 0
            fi
            nutc=$(printf '%s' "$next" | sed -n 's/.*(in UTC): *//p' | head -n1)
            nutc="${nutc#* }"                       # drop the leading weekday word
            [ -n "$nutc" ] && epoch=$(date -d "$nutc" +%s 2>/dev/null || true)
        fi
        [ -n "$epoch" ] && _NEXT_EPOCH[$key]="$epoch"
    fi
    _TIMER_EPOCH="$epoch"
    [ -n "$epoch" ] && _TIMER_LEFT=$(_fmt_left $(( epoch - now )))
    return 0
}

# Fill HW_IDS ("wake-N") + HW_ROWS ("<profile @ time mode>[  [time-left]]") from the
# host wake timers, sorted by PROFILE then time-left (each profile's wakes grouped,
# soonest first). Garbage-collects elapsed one-shots (needs the helper present). The
# next-elapse epoch + "time left" come from _timer_next (cached, second-granular).
HW_IDS=(); HW_ROWS=()
_hostwake_collect() {
    local now f n info expr
    local -a t_ids=() t_rows=() t_keys=()
    now=$(date +%s)
    HW_IDS=(); HW_ROWS=()
    for f in "$HOSTWAKE_GLOB"*.timer; do
        [ -e "$f" ] || continue
        n=$(basename "$f" .timer); n="${n##*-}"
        case "$n" in ''|*[!0-9]*) continue ;; esac
        info=$(grep -m1 '^# waterbox:' "$f" 2>/dev/null | sed 's/^# waterbox: //')
        expr=$(grep -m1 '^OnCalendar=' "$f" 2>/dev/null | sed 's/^OnCalendar=//')
        _timer_next "hw-$n" "$expr" "$now"
        if [ "$_TIMER_GC" = 1 ]; then           # elapsed one-shot: garbage-collect
            _helper_current && run_priv remove-host-wake "$n" >/dev/null 2>&1 || true
            continue
        fi
        t_ids+=("wake-$n")
        t_rows+=("${info}${_TIMER_LEFT:+   [$_TIMER_LEFT]}")
        # key = <profile>\t<epoch>\t<index-into-t_ids>; profile is the 1st token of
        # "<profile> @ <time> <mode>". Missing epoch sorts last within the profile.
        # Index is plain %d (no zero-pad — a padded "0008" would be read as octal).
        t_keys+=("$(printf '%s\t%011d\t%d' "${info%% @ *}" "${_TIMER_EPOCH:-99999999999}" "$(( ${#t_ids[@]} - 1 ))")")
    done
    [ "${#t_ids[@]}" -eq 0 ] && return 0
    local idx
    while IFS=$'\t' read -r _ _ idx; do
        [ -n "$idx" ] || continue
        HW_IDS+=("${t_ids[$idx]}"); HW_ROWS+=("${t_rows[$idx]}")
    done < <(printf '%s\n' "${t_keys[@]}" | sort -t $'\t' -k1,1 -k2,2n)
}

manage_wake_claude() {
    local action="$1"; shift || true
    case "$action" in
        add)
            local profile="$1" time="$2" mode="${3:-daily}"
            [ -n "$profile" ] && [ -n "$time" ] \
                || log_error "Usage: waterbox wake-claude <profile> <HH:MM> [once|daily]"
            [[ "$profile" =~ ^[A-Za-z0-9._-]+$ ]] || log_error "Invalid profile name: '$profile'."
            [[ "$time" =~ ^([01]?[0-9]|2[0-3]):[0-5][0-9]$ ]] \
                || log_error "Time must be HH:MM (24-hour), got '$time'."
            time=$(printf '%02d:%s' "$((10#${time%%:*}))" "${time#*:}")   # 9:30 -> 09:30
            [ "$mode" = once ] || [ "$mode" = daily ] \
                || log_error "Mode must be 'once' or 'daily', got '$mode'."
            [ -d "$(_claude_profiles_root)/$profile" ] \
                || log_error "No such account: '$profile'. Create it with 'agent-env' inside the box."
            ensure_helper
            local n; n=$(_hostwake_next_id)
            run_priv install-host-wake "$n" "$profile" "$time" "$mode"
            log_success "wake-claude 'wake-$n' set: $mode at $time for '$profile' — fires unattended even while the box is powered off."
            ;;
        del|rm)
            local id="$1" n
            [ -n "$id" ] || log_error "Usage: waterbox wake-claude del <id>  (see 'wake-claude list')."
            [[ "$id" == wake-* ]] || log_error "Not a wake id: '$id' (see 'wake-claude list')."
            n="${id#wake-}"
            [[ "$n" =~ ^[0-9]+$ ]] && [ -f "${HOSTWAKE_GLOB}${n}.timer" ] \
                || log_error "No such wake: '$id'."
            ensure_helper
            run_priv remove-host-wake "$n"
            log_success "Removed wake-claude '$id'."
            ;;
        list|"")
            log_info "Scheduled quota wakes (wake-claude):"
            _hostwake_collect
            if [ "${#HW_IDS[@]}" -eq 0 ]; then
                echo "  (none)"
            else
                local i
                for i in "${!HW_IDS[@]}"; do echo "  - ${HW_IDS[$i]}   ${HW_ROWS[$i]}"; done
            fi
            ;;
        *) log_error "Usage: waterbox wake-claude <profile> <HH:MM> [once|daily] | list | del <id>" ;;
    esac
}

# `schedule-command` — type a command + Enter into an existing session (default once).
manage_schedule() {
    local action="$1"; shift || true
    case "$action" in
        add)
            # The command may be an explicit "" — that means "just send Enter". Use the
            # arg COUNT (not -n) to tell an empty command apart from a missing one.
            local nargs=$# session="$1" time="$2" mode command have_cmd=0
            if [ "$3" = once ] || [ "$3" = daily ]; then
                mode="$3"; command="$4"; [ "$nargs" -ge 4 ] && have_cmd=1
            else
                mode="once"; command="$3"; [ "$nargs" -ge 3 ] && have_cmd=1
            fi
            [ -n "$session" ] && [ -n "$time" ] && [ "$have_cmd" = 1 ] \
                || log_error "Usage: waterbox schedule-command <session> <HH:MM> [once|daily] \"<command>\"  (\"\" sends just Enter)"
            [[ "$session" =~ ^[A-Za-z0-9._-]+$ ]] || log_error "Invalid session name: '$session'."
            [[ "$time" =~ ^([01]?[0-9]|2[0-3]):[0-5][0-9]$ ]] \
                || log_error "Time must be HH:MM (24-hour), got '$time'."
            time=$(printf '%02d:%s' "$((10#${time%%:*}))" "${time#*:}")   # 9:30 -> 09:30
            [ "$mode" = once ] || [ "$mode" = daily ] \
                || log_error "Mode must be 'once' or 'daily', got '$mode'."
            is_running || log_error "The box must be running to schedule into a live session ('waterbox start' first)."
            container_tmux has-session -t "=$session" 2>/dev/null \
                || log_error "No live session '$session'. Start it and check 'waterbox status'."
            local id
            id="schd-com-$(_next_task_id waterbox-schd-com-)"
            # The helper writes the message file + the (User-fixed, ExecStart-shaped)
            # timer units into the rootfs and starts them.
            printf '%s' "$command" | run_priv sched-msg "$id"
            run_priv sched-install "$id" "$session" "$time" "$mode"
            log_success "schedule-command '$id' set: '${command:-<enter>}' $mode at $time into session '$session'."
            ;;
        del|rm)
            local id="$1"
            [ -n "$id" ] || log_error "Usage: waterbox schedule-command del <id>  (see 'schedule-command list')."
            [[ "$id" == schd-com-* ]] || log_error "Not a schedule-command id: '$id' (see 'schedule-command list')."
            [ -f "$JAIL_ROOT$TASK_ETC/waterbox-${id}.timer" ] || log_error "No such scheduled command: '$id'."
            _sched_remove "$id"
            log_success "Removed schedule-command '$id'."
            ;;
        list|"")
            log_info "Scheduled commands (schedule-command):"
            _timer_list "waterbox-schd-com-" 1
            ;;
        *) log_error "Usage: waterbox schedule-command <session> <HH:MM> [once|daily] \"<cmd>\" | list | del <id>" ;;
    esac
}

# --- TUI managers (item 7): live add/delete screens over the CLI verbs ---------
# `wake-claude` / `schedule-command` / `share` with no args open a task_manager
# screen; the classic CLI forms below are the "advanced" path (see <cmd> --help).

# Where Claude's per-account slots live: the multi-agent tree, or the pre-1.9 flat
# layout on a box that hasn't been migrated yet. (After migration ~/.claude-env is a
# symlink to the former, so either branch resolves to the same place.)
_claude_profiles_root() {
    local h="$JAIL_ROOT/home/$USER_NAME"
    if [ -d "$h/.agent-env/claude" ]; then printf '%s' "$h/.agent-env/claude"
    else printf '%s' "$h/.claude-env"; fi
}

# Claude accounts, read straight from the host-visible rootfs (no sudo).
_list_profiles() {
    local d
    for d in "$(_claude_profiles_root)"/*/; do
        [ -d "$d" ] || continue
        basename "$d"
    done
}

# Shared wizard step: typed HH:MM (validated) + once/daily menu.
# Sets AW_TIME / AW_MODE in the caller's scope; returns 1 on cancel.
_wizard_when() {
    prompt_field "Time (HH:MM): " '([01]?[0-9]|2[0-3]):[0-5][0-9]' \
        "use 24-hour HH:MM, e.g. 07:00 (or 7:00)" || return 1
    AW_TIME="$FIELD"
    MENU_CANCEL=1
    choose_menu "When:" once daily
    [ "$MENU_CANCELLED" = 1 ] && return 1
    [ "$MENU_CHOICE" -eq 0 ] && AW_MODE=once || AW_MODE=daily
    return 0
}

wake_load() {
    _hostwake_collect
    local i
    for i in "${!HW_IDS[@]}"; do
        M_IDS+=("${HW_IDS[$i]}"); M_ROWS+=("${HW_IDS[$i]}   ${HW_ROWS[$i]}")
    done
}
wake_add() {
    local profile="${1:-}" profiles=() p AW_TIME AW_MODE
    if [ -n "$profile" ]; then
        # Pre-seeded from the CLI (`waterbox wake-claude <profile>`): skip the picker
        # and jump straight to asking time + when.
        [ -d "$(_claude_profiles_root)/$profile" ] \
            || log_error "No such account: '$profile'. Create it with 'agent-env' inside the box."
    else
        while IFS= read -r p; do [ -n "$p" ] && profiles+=("$p"); done < <(_list_profiles)
        [ "${#profiles[@]}" -gt 0 ] \
            || { log_warn "No accounts yet — create one with 'agent-env' inside the box."; return 0; }
        MENU_CANCEL=1
        choose_menu "Profile to wake:" "${profiles[@]}"
        [ "$MENU_CANCELLED" = 1 ] && { log_info "Cancelled."; return 0; }
        profile="${profiles[$MENU_CHOICE]}"   # capture before _wizard_when reuses MENU_CHOICE
    fi
    _wizard_when || { log_info "Cancelled."; return 0; }
    manage_wake_claude add "$profile" "$AW_TIME" "$AW_MODE"
}
wake_del() { manage_wake_claude del "$1"; }
wake_manager() { task_manager "Quota wakes (wake-claude)" wake_load wake_add wake_del delete 1; }

sched_load() {
    _timer_collect "waterbox-schd-com-" 1
    local i
    for i in "${!TL_IDS[@]}"; do
        M_IDS+=("${TL_IDS[$i]}"); M_ROWS+=("${TL_IDS[$i]}   ${TL_ROWS[$i]}")
    done
}
sched_add() {
    is_running || { log_warn "The box must be running to schedule into a live session."; return 0; }
    local session="${1:-}" sessions=() s AW_TIME AW_MODE command
    if [ -n "$session" ]; then
        # Pre-seeded from the CLI (`waterbox schedule-command <session>`): skip the
        # picker and jump straight to time + when + command.
        container_tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -qxF "$session" \
            || log_error "No live session '$session'. Start it and check 'waterbox status'."
    else
        while IFS= read -r s; do [ -n "$s" ] && sessions+=("$s"); done \
            < <(container_tmux list-sessions -F '#{session_name}' 2>/dev/null | sort)
        [ "${#sessions[@]}" -gt 0 ] \
            || { log_warn "No live sessions — start one first ('waterbox' → new session)."; return 0; }
        MENU_CANCEL=1
        choose_menu "Target session:" "${sessions[@]}"
        [ "$MENU_CANCELLED" = 1 ] && { log_info "Cancelled."; return 0; }
        session="${sessions[$MENU_CHOICE]}"
    fi
    _wizard_when || { log_info "Cancelled."; return 0; }
    # allow_empty=1: an empty command means "just send Enter" (Ctrl-C to cancel).
    prompt_field "Command to send (empty = just Enter): " "" "" 1 \
        || { log_info "Cancelled."; return 0; }
    command="$FIELD"
    manage_schedule add "$session" "$AW_TIME" "$AW_MODE" "$command"
}
sched_del() { manage_schedule del "$1"; }
schedule_manager() { task_manager "Scheduled commands (schedule-command)" sched_load sched_add sched_del delete 1; }

share_load() {
    local line
    [ -s "$SHARE_LIST" ] || return 0
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        M_IDS+=("$line")
        M_ROWS+=("$line  →  $CONTAINER_WORKSPACE/$(basename "$line")")
    done < "$SHARE_LIST"
}
share_add() {
    prompt_field "Host path to share: " || { log_info "Cancelled."; return 0; }
    manage_share add "$FIELD"
}
share_del() { manage_share del "$1"; }
# Warn (to the terminal) when processes inside the box are still using the share at
# ~/workspace/<folder>. Detach lazy-unmounts it, so anything cd'd in (or holding a
# file open) is stranded on a stale, disconnected copy — it can't cd out and new
# writes stay in the box instead of reaching the host. Returns 0 iff it warned.
_print_share_in_use() {
    local folder="$1" users pid cmd
    is_running || return 1
    _helper_current || return 1
    users="$(run_priv share-users "$folder" 2>/dev/null)" || return 1
    [ -n "$users" ] || return 1
    printf '\e[33m[WARN]\e[0m Still in use inside the box (~/workspace/%s):\n' "$folder" > /dev/tty
    printf '%s\n' "$users" | while IFS=' ' read -r pid cmd; do
        [ -n "$pid" ] && printf '         • %s (pid %s)\n' "${cmd:-?}" "$pid" > /dev/tty
    done
    return 0
}
# TUI pre-detach hook (task_manager warn_fn): $1 is the selected share's host path.
share_warn() { _print_share_in_use "$(basename "$1")"; }
# "detach" (not "delete"): removing a share only unmounts it — no files are deleted.
share_manager() { task_manager "Shared folders (share)" share_load share_add share_del detach 0 share_warn; }

# --- Shell completion ---------------------------------------------------------
# Print a zsh completion script to stdout. Enable it with:
#   eval "$(waterbox completion zsh)"     (add that line to ~/.zshrc)
# Completes subcommands, share/history actions, profiles and del-ids (from the
# host-readable rootfs, no sudo), and — best-effort — live session names via the
# hidden `waterbox _sessions` (empty unless the box is up and sudo is cached).
emit_completion() {
    local shell="${1:-zsh}"
    [ "$shell" = zsh ] || log_error "Only 'zsh' completion is supported (got '$shell')."
    cat <<'COMPLETION'
#compdef waterbox
# waterbox zsh completion — enable with: eval "$(waterbox completion zsh)"
# Time slot: show the HH:MM hint and offer "now + 1 min" as a ready-to-edit value.
_waterbox_time() {
    local now1; now1=$(date -d '+1 minute' +%H:%M 2>/dev/null)
    compadd -X "time · 24-hour HH:MM (e.g. 07:00) · Tab = now+1min" -- "${now1:-07:00}"
}
_waterbox() {
    local root="$HOME/.waterbox/root"
    local -a cmds items
    cmds=(start stop restart status reset share
          wake-claude schedule-command version help)

    if (( CURRENT == 2 )); then
        _describe -t commands 'waterbox command' cmds
        return
    fi

    case "${words[2]}" in
        start)
            # `waterbox start <session>` boots (if needed) and attaches that session
            # directly — complete existing live session names, plus the flags.
            items=(--here --gui --no-gui --x11 --no-gpu ${(f)"$(command waterbox _sessions 2>/dev/null)"})
            compadd -a items ;;
        share)
            if (( CURRENT == 3 )); then items=(add detach list); compadd -a items
            else _files -/; fi ;;
        wake-claude)
            if (( CURRENT == 3 )); then
                # Multi-agent layout, or the pre-1.9 flat one on an unmigrated box.
                local croot="$root/home/water/.agent-env/claude"
                [[ -d $croot ]] || croot="$root/home/water/.claude-env"
                items=(list del ${croot}/*(N/:t)); compadd -a items
            elif [[ "${words[3]}" == (del|rm) ]]; then
                items=(/etc/systemd/system/waterbox-hostwake-*.timer(N:t:r))
                items=(wake-${items#waterbox-hostwake-}); compadd -a items
            elif (( CURRENT == 4 )); then
                _waterbox_time                          # <profile> <HH:MM>
            elif (( CURRENT == 5 )); then
                items=(once daily); compadd -a items    # [once|daily]
            fi ;;
        schedule-command)
            if (( CURRENT == 3 )); then
                items=(list del ${(f)"$(command waterbox _sessions 2>/dev/null)"})
                compadd -a items
            elif [[ "${words[3]}" == (del|rm) ]]; then
                items=("$root"/etc/systemd/system/waterbox-schd-com-*.timer(N:t:r))
                items=(${items#waterbox-}); compadd -a items
            elif (( CURRENT == 4 )); then
                _waterbox_time                          # <session> <HH:MM>
            elif (( CURRENT == 5 )); then
                items=(once daily); compadd -a items    # [once|daily]
            elif (( CURRENT == 6 )); then
                _message -e command 'command to send — e.g. "continue"'
            fi ;;
        completion)
            (( CURRENT == 3 )) && { items=(zsh); compadd -a items; } ;;
    esac
}
compdef _waterbox waterbox
# Render group descriptions/hints (e.g. the "command to send" message and the time
# hint) for waterbox completions only — scoped so other commands are untouched.
zstyle ':completion:*:waterbox:*' format '%d'
COMPLETION
}

# --- Argument parsing ---------------------------------------------------------
# Pull out the global flags anywhere on the command line; the rest is positional.
POSITIONAL=()
while [ $# -gt 0 ]; do
    case "$1" in
        --gui)    WATERBOX_GUI=1; shift ;;
        --no-gui) WATERBOX_GUI=0; shift ;;
        --x11)    WATERBOX_GUI=1; WATERBOX_X11=1; shift ;;
        --no-gpu) WATERBOX_NO_GPU=1; shift ;;
        --here)   WATERBOX_HERE=1; shift ;;
        --unsafe-host-root) WATERBOX_UNSAFE_HOST_ROOT=1; shift ;;
        *)        POSITIONAL+=("$1"); shift ;;
    esac
done
set -- "${POSITIONAL[@]}"

# `waterbox <command> --help` — route to that command's detail help BEFORE anything
# runs. Without this, --help falls through as a positional (e.g. `start --help` used
# it as a session name and booted the box), and commands that ignore $2 would just
# do the thing you asked to read about.
case "${2:-}" in
    -h|--help)
        case "${1:-}" in
            start)            help_start ;;
            share)            help_share ;;
            wake-claude)      help_wake ;;
            schedule-command) help_schedule ;;
            *)                show_help ;;   # stop/restart/status/reset/update/…
        esac
        exit 0 ;;
esac

# Resolve GUI=auto now that flags are parsed: on only when a Wayland socket is live.
if [ "$WATERBOX_GUI" = auto ]; then
    _wl="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/${WAYLAND_DISPLAY:-}"
    if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$_wl" ]; then
        WATERBOX_GUI=1
    else
        WATERBOX_GUI=0
    fi
fi

case "${1:-start}" in
    start|"") start_sandbox "$2" ;;
    stop)     stop_sandbox ;;
    restart)  restart_sandbox ;;
    status)   status_sandbox ;;
    reset)    reset_sandbox ;;
    setup)    ensure_host_privs ;;         # normally automatic on start/reset
    refresh-config) refresh_config ;;      # internal; not shown in help
    completion)     emit_completion "$2" ;; # internal; installed automatically
    _helper)        run_priv "${@:2}" ;;   # hidden: manual helper passthrough (debug)
    _sessions)      list_sessions_quiet ;;   # hidden: used by shell completion
    share)
        case "$2" in
            "")           share_manager ;;
            add)          manage_share add "$3" ;;
            del|detach)   manage_share detach "$3" ;;
            list)         list_shares ;;
            *)            log_error "Usage: waterbox share [add|detach|list] [path]  (bare 'share' opens the manager; 'share --help' for details)" ;;
        esac
        ;;
    wake-claude)
        case "$2" in
            "")        wake_manager ;;
            list)      manage_wake_claude list ;;
            del|rm)    manage_wake_claude del "$3" ;;
            # Just a profile (no time yet) → open the wizard on time + when for it.
            *)         if [ -z "$3" ]; then wake_add "$2"
                       else manage_wake_claude add "${@:2}"; fi ;;
        esac
        ;;
    schedule-command)
        case "$2" in
            "")        schedule_manager ;;
            list)      manage_schedule list ;;
            del|rm)    manage_schedule del "$3" ;;
            # Just a session (no time yet) → open the wizard on time + when + command.
            *)         if [ -z "$3" ]; then sched_add "$2"
                       else manage_schedule add "${@:2}"; fi ;;
        esac
        ;;
    update)   self_update ;;
    version|--version|-v) echo "waterbox v$WATERBOX_VERSION" ;;
    help|--help|-h) show_help ;;
    *) log_error "Unknown command '$1'. See 'waterbox --help'." ;;
esac
