write_client_conf() {  # write_client_conf <name> <ipv4>
    local name=$1 ip=$2 conf
    conf="$CLIENTDIR/$name.conf"

    {
        printf '# %s — generated %s\n'  "$name" "$(date -u '+%Y-%m-%d %H:%M UTC')"
        printf '[Interface]\n'
        printf 'PrivateKey = %s\n'      "$(cat "$KEYDIR/$name.key")"
        printf 'Address    = %s/32, %s/128\n' "$ip" "$(v6_for "$ip")"
        if [ -n "$CLIENT_DNS" ]; then printf 'DNS        = %s\n' "$CLIENT_DNS"; fi
        printf '\n[Peer]\n'
        printf 'PublicKey  = %s\n'      "$(cat "$KEYDIR/server.pub")"
        printf 'Endpoint   = %s:%s\n'   "$ENDPOINT" "$PORT"
        printf 'AllowedIPs = 0.0.0.0/0, ::/0\n'
        printf 'PersistentKeepalive = 25\n'
        if [ -n "$ALT_PORTS" ]; then
            printf '\n# If udp/%s is blocked on the network you are on, edit the\n' "$PORT"
            printf '# Endpoint line above to one of these — same server, same keys:\n'
            local ap
            for ap in ${ALT_PORTS//,/ }; do
                printf '#   Endpoint = %s:%s\n' "$ENDPOINT" "$ap"
            done
        fi
    } > "$conf"

    chmod 600 "$conf"
    printf '%s' "$conf"
}

# The QR encodes a minimal version of the config: comments, the alignment spaces
# around "=", and the spaces after commas are all dropped. The file on disk keeps
# them. Only the FIRST "=" on a line is collapsed — base64 keys end in "=".
#
# This is about as small as a WireGuard QR gets, and it is worth knowing why:
#   * 257 bytes fits QR version 10 (57x57 modules). Version 9 would be 53x53 but
#     caps at 230 bytes, so it is 27 bytes out of reach — and 88 of those 257 are
#     the two base64 keys, which cannot be shortened.
#     Even sacrificing IPv6 entirely only reaches 232 bytes — still version 10.
#
# So the module count is fixed at 59 (57 + a 1-module quiet zone) and the only
# remaining lever is how many modules are packed into one terminal character.
# A cell is ~2x taller than wide, so packing NxM modules gives a module aspect
# of M:2N, and the QR comes out cols=ceil(59/N) x rows=ceil(59/M):
#
#   half-block 1x2  59 x 29   modules 1:1   square, but wide
#   sextant    2x3  30 x 20   modules 3:4   33% too tall
#   octant     2x4  30 x 15   modules 1:1   square AND smallest  <- optimal
#
# Octants are the mathematical floor: square modules, half the width, half the
# height. The catch is purely font coverage — they are Unicode 16 (2024) and
# the table also needs a few glyphs from the Legacy Computing Supplement block,
# so a font without them renders tofu. Sextants (Unicode 13, 2020) are the
# safer default. QR_STYLE=octant | sextant | square picks explicitly.
qr_payload() {
    grep -vE '^[[:space:]]*(#|$)' "$1" \
        | sed -e 's/[[:space:]]*=[[:space:]]*/=/' -e 's/, /,/g'
}

# Re-renders qrencode's ASCII grid, packing 2 modules per column and CH per row.
# Self-calibrating so it does not depend on qrencode's output style: module
# width comes from line-length/row-count, and polarity from the top-left finder
# corner, which is always dark. Sub-cell k of row i carries weight 2^(2i+k),
# which is exactly Unicode's BLOCK SEXTANT-n / BLOCK OCTANT-n position order.
QR_PACK_AWK='
function raw(rr, cc,   ch) {
    ch = substr(rows[rr], (cc - 1) * hs + 1, 1)
    return (ch != " " && ch != "") ? 1 : 0
}
function bit(rr, cc) {
    if (rr < 1 || cc < 1 || rr > n || cc > w) return 0
    return (raw(rr, cc) != inv) ? 1 : 0
}
BEGIN {
    nn = split(GLYPHS, t, "|"); for (i = 1; i <= nn; i++) g[i-1] = t[i]
    p[0] = 1; for (i = 1; i < 8; i++) p[i] = p[i-1] * 2
}
{ rows[NR] = $0 }
END {
    n  = NR
    hs = int(length(rows[1]) / n); if (hs < 1) hs = 1
    w  = int(length(rows[1]) / hs)
    inv = raw(mg + 1, mg + 1) ? 0 : 1
    for (r = 1; r <= n; r += CH) {
        line = ""
        for (c = 1; c <= w; c += 2) {
            v = 0
            for (i = 0; i < CH; i++)
                v += bit(r + i, c) * p[2 * i] + bit(r + i, c + 1) * p[2 * i + 1]
            line = line g[v]
        }
        printf "%s%s%s\n", pre, line, post
    }
}'

QR_SEXTANTS=' |🬀|🬁|🬂|🬃|🬄|🬅|🬆|🬇|🬈|🬉|🬊|🬋|🬌|🬍|🬎|🬏|🬐|🬑|🬒|🬓|▌|🬔|🬕|🬖|🬗|🬘|🬙|🬚|🬛|🬜|🬝|🬞|🬟|🬠|🬡|🬢|🬣|🬤|🬥|🬦|🬧|▐|🬨|🬩|🬪|🬫|🬬|🬭|🬮|🬯|🬰|🬱|🬲|🬳|🬴|🬵|🬶|🬷|🬸|🬹|🬺|🬻|█'
QR_OCTANTS=' |𜺨|𜺫|🮂|𜴀|▘|𜴁|𜴂|𜴃|𜴄|▝|𜴅|𜴆|𜴇|𜴈|▀|𜴉|𜴊|𜴋|𜴌|🯦|𜴍|𜴎|𜴏|𜴐|𜴑|𜴒|𜴓|𜴔|𜴕|𜴖|𜴗|𜴘|𜴙|𜴚|𜴛|𜴜|𜴝|𜴞|𜴟|🯧|𜴠|𜴡|𜴢|𜴣|𜴤|𜴥|𜴦|𜴧|𜴨|𜴩|𜴪|𜴫|𜴬|𜴭|𜴮|𜴯|𜴰|𜴱|𜴲|𜴳|𜴴|𜴵|🮅|𜺣|𜴶|𜴷|𜴸|𜴹|𜴺|𜴻|𜴼|𜴽|𜴾|𜴿|𜵀|𜵁|𜵂|𜵃|𜵄|▖|𜵅|𜵆|𜵇|𜵈|▌|𜵉|𜵊|𜵋|𜵌|▞|𜵍|𜵎|𜵏|𜵐|▛|𜵑|𜵒|𜵓|𜵔|𜵕|𜵖|𜵗|𜵘|𜵙|𜵚|𜵛|𜵜|𜵝|𜵞|𜵟|𜵠|𜵡|𜵢|𜵣|𜵤|𜵥|𜵦|𜵧|𜵨|𜵩|𜵪|𜵫|𜵬|𜵭|𜵮|𜵯|𜵰|𜺠|𜵱|𜵲|𜵳|𜵴|𜵵|𜵶|𜵷|𜵸|𜵹|𜵺|𜵻|𜵼|𜵽|𜵾|𜵿|𜶀|𜶁|𜶂|𜶃|𜶄|𜶅|𜶆|𜶇|𜶈|𜶉|𜶊|𜶋|𜶌|𜶍|𜶎|𜶏|▗|𜶐|𜶑|𜶒|𜶓|▚|𜶔|𜶕|𜶖|𜶗|▐|𜶘|𜶙|𜶚|𜶛|▜|𜶜|𜶝|𜶞|𜶟|𜶠|𜶡|𜶢|𜶣|𜶤|𜶥|𜶦|𜶧|𜶨|𜶩|𜶪|𜶫|▂|𜶬|𜶭|𜶮|𜶯|𜶰|𜶱|𜶲|𜶳|𜶴|𜶵|𜶶|𜶷|𜶸|𜶹|𜶺|𜶻|𜶼|𜶽|𜶾|𜶿|𜷀|𜷁|𜷂|𜷃|𜷄|𜷅|𜷆|𜷇|𜷈|𜷉|𜷊|𜷋|𜷌|𜷍|𜷎|𜷏|𜷐|𜷑|𜷒|𜷓|𜷔|𜷕|𜷖|𜷗|𜷘|𜷙|𜷚|▄|𜷛|𜷜|𜷝|𜷞|▙|𜷟|𜷠|𜷡|𜷢|▟|𜷣|▆|𜷤|𜷥|█'

qr_pack() {  # qr_pack <modules-per-cell-row> <glyph-table>
    qrencode -t ASCII -m 1 \
        | awk -v mg=1 -v CH="$1" -v GLYPHS="$2" \
              -v pre=$'\033[30;47m' -v post=$'\033[0m' "$QR_PACK_AWK"
}

qr_render() {
    local style=${QR_STYLE:-sextant}
    [ "${QR_WIDE:-0}" = 1 ] && style=square
    case $style in
        square|wide) qrencode -t ansiutf8 -m 1 ;;
        octant)      qr_pack 4 "$QR_OCTANTS"   ;;
        *)           qr_pack 3 "$QR_SEXTANTS"  ;;
    esac
}

show_client() {  # show_client <name>
    local name=$1 conf tname
    valid_name "$name"
    conf="$CLIENTDIR/$name.conf"
    [ -f "$conf" ] || die "no client config at $conf"
    tname=$(suggest_tunnel_name "$name")
    head1 "Scan this with the WireGuard app on '$name'"
    qr_payload "$conf" | qr_render
    printf '\n  The app will ask for a name. Use:   %s\n' "$tname"
    printf '  (Android accepts only A-Z a-z 0-9 _ = + . - and 15 chars, so no "@";\n'
    printf '   iOS and the desktop apps are laxer, but this name works everywhere)\n'
    printf '\nconfig file : %s\n' "$conf"
    printf 'linux client: menu option 4 prints a paste-and-run block for this device\n'
    printf 'qr size     : QR_STYLE=octant  30x15, square  (needs a Unicode 16 font)\n'
    printf '              QR_STYLE=square  59x29, square  (works with any font)\n'
    if [ -n "$ALT_PORTS" ]; then
        printf 'fallback    : if udp/%s is blocked, change Endpoint to udp/%s\n' \
            "$PORT" "${ALT_PORTS//,/ or udp\/}"
    fi
}

# Everything a Linux client needs as ONE block to paste. The block installs
# wireguard-tools if missing, writes the config, registers it with
# NetworkManager when NetworkManager is actually running, and finally prints
# the how-to-connect summary itself — so the user reads the instructions on the
# machine they just set up, not mixed into this server's output.
#
# Emission note: the parts below are quoted heredocs (<<'PART') so $WG_NAME and
# friends survive to be expanded on the CLIENT. Only the three assignment lines
# are substituted here, on the server.
# Reads one key out of a client config. Anchored and non-global, so the "=" in
# base64 key material survives.
conf_get() { sed -n "s/^$2[[:space:]]*=[[:space:]]*//p" "$1" | head -1; }

# Stable UUID derived from the profile name, so regenerating this block targets
# the same NetworkManager profile instead of creating a second one.
stable_uuid() {
    local h
    h=$(printf '%s' "$1" | sha1sum | cut -c1-32)
    printf '%s-%s-5%s-a%s-%s' "${h:0:8}" "${h:8:4}" "${h:13:3}" "${h:17:3}" "${h:20:12}"
}

# A NetworkManager keyfile for this client, with autoconnect=false baked in.
# Written straight to disk rather than going through `nmcli connection import`:
# an imported profile is born with autoconnect=yes and WireGuard supplies its
# own virtual device, so NM activates it instantly and the desktop shows
# "activated" then "deactivated" as we turn it back off. Creating the file
# already disabled means NM never activates it and stays quiet.
nm_keyfile() {  # nm_keyfile <conf> <id> <iface> <uuid>
    local conf=$1 id=$2 iface=$3 uuid=$4 addr v4 v6 dns aips

    addr=$(conf_get "$conf" Address)
    v4=${addr%%,*}; v4=${v4// /}
    v6=""; case $addr in *,*) v6=${addr#*,}; v6=${v6// /} ;; esac
    dns=$(conf_get "$conf" DNS)
    aips=$(conf_get "$conf" AllowedIPs | tr -d ' ' | tr ',' ';')

    printf '[connection]\nid=%s\nuuid=%s\ntype=wireguard\ninterface-name=%s\nautoconnect=false\n\n' \
        "$id" "$uuid" "$iface"
    printf '[wireguard]\nprivate-key=%s\n\n' "$(conf_get "$conf" PrivateKey)"
    printf '[wireguard-peer.%s]\nendpoint=%s\nallowed-ips=%s;\n' \
        "$(conf_get "$conf" PublicKey)" "$(conf_get "$conf" Endpoint)" "$aips"
    local ka; ka=$(conf_get "$conf" PersistentKeepalive)
    [ -n "$ka" ] && printf 'persistent-keepalive=%s\n' "$ka"
    printf '\n[ipv4]\nmethod=manual\naddress1=%s\n' "$v4"
    # negative priority = this connection's DNS wins while the tunnel is up
    [ -n "$dns" ] && printf 'dns=%s;\ndns-priority=-50\n' "$dns"
    printf '\n[ipv6]\n'
    if [ -n "$v6" ]; then printf 'method=manual\naddress1=%s\n' "$v6"
    else                  printf 'method=ignore\n'; fi
    printf 'addr-gen-mode=default\n'
    return 0
}

show_linux() {  # show_linux <name>
    local name=$1 conf tun nmid uuid keyfile
    valid_name "$name"
    conf="$CLIENTDIR/$name.conf"
    [ -f "$conf" ] || die "no client config at $conf"
    tun=$(suggest_tunnel_name "$name")   # same name the QR screen suggests
    nmid="$name@$SERVER_HOST"
    uuid=$(stable_uuid "$nmid")
    keyfile=$(nm_keyfile "$conf" "$nmid" "$tun" "$uuid")

    head1 "Linux setup for '$name'"
    printf '\nCopy the whole block and paste it into the client terminal. It will\n'
    printf 'install what is missing, write the config, register it with\n'
    printf 'NetworkManager if present, then print how to connect.\n\n'

    printf '#--------------------- copy from here ---------------------\n'
    printf 'WG_NAME=%s\n'   "$tun"
    printf "NM_NAME='%s'\n" "$nmid"
    printf 'WG_UUID=%s\n'   "$uuid"
    printf "SRV_IP='%s'\n\n" "$ENDPOINT"
    cat <<'PART'
if ! command -v wg >/dev/null 2>&1; then
  if   command -v apt-get >/dev/null 2>&1; then sudo apt-get update -qq && sudo apt-get install -y wireguard-tools
  elif command -v pacman  >/dev/null 2>&1; then sudo pacman -S --needed --noconfirm wireguard-tools
  elif command -v dnf     >/dev/null 2>&1; then sudo dnf install -y wireguard-tools
  elif command -v zypper  >/dev/null 2>&1; then sudo zypper install -y wireguard-tools
  else echo "!! install wireguard-tools yourself, then paste this again"; fi
fi

sudo install -d -m 700 /etc/wireguard
sudo tee "/etc/wireguard/$WG_NAME.conf" >/dev/null <<'WGEOF'
PART
    cat "$conf"
    cat <<'PART'
WGEOF
sudo chmod 600 "/etc/wireguard/$WG_NAME.conf"

NM=no
NM_OLD=0
if command -v nmcli >/dev/null 2>&1 && systemctl is-active --quiet NetworkManager 2>/dev/null; then
  # Drop stray profiles for this tunnel left by earlier runs — match either of
  # our names or the interface it binds (catches a hand-renamed profile). Our
  # own profile is skipped by UUID: its file is simply overwritten below.
  for u in $(sudo nmcli -t -f UUID,TYPE connection show 2>/dev/null \
             | awk -F: '$2 == "wireguard" { print $1 }'); do
    if [ "$u" = "$WG_UUID" ]; then continue; fi
    cid=$(sudo nmcli -g connection.id             connection show "$u" 2>/dev/null)
    cif=$(sudo nmcli -g connection.interface-name connection show "$u" 2>/dev/null)
    if [ "$cid" = "$NM_NAME" ] || [ "$cid" = "$WG_NAME" ] || [ "$cif" = "$WG_NAME" ]; then
      sudo nmcli connection delete uuid "$u" >/dev/null 2>&1 && NM_OLD=$((NM_OLD + 1))
    fi
  done

  # Write the profile with autoconnect=false already set, so NM never activates
  # it and the desktop stays silent. (`nmcli connection import` would create it
  # with autoconnect=yes, activate it at once, and pop up activated/deactivated
  # notifications when we turned it back off.)
  # Create the file 0600 *before* writing it: this one carries the private key,
  # and unlike /etc/wireguard its directory is world-traversable, so a
  # tee-then-chmod would leave the key readable to every local user in between.
  sudo mkdir -p /etc/NetworkManager/system-connections
  sudo install -m 600 /dev/null "/etc/NetworkManager/system-connections/$WG_NAME.nmconnection"
  sudo tee "/etc/NetworkManager/system-connections/$WG_NAME.nmconnection" >/dev/null <<'NMEOF'
PART
    printf '%s\n' "$keyfile"
    cat <<'PART'
NMEOF
  sudo nmcli connection reload >/dev/null 2>&1
  if sudo nmcli -g connection.id connection show "$WG_UUID" >/dev/null 2>&1; then
    NM=yes
  else
    # Keyfile not accepted (older NM, unexpected schema): fall back to import so
    # a profile still ends up registered. This path does flash a notification.
    echo "!! keyfile not accepted, falling back to nmcli import"
    sudo nmcli connection import type wireguard file "/etc/wireguard/$WG_NAME.conf" >/dev/null 2>&1 \
      && sudo nmcli connection modify "$WG_NAME" connection.id "$NM_NAME" connection.autoconnect no >/dev/null 2>&1
    sudo nmcli connection down "$NM_NAME" >/dev/null 2>&1
    if sudo nmcli -g connection.id connection show "$NM_NAME" >/dev/null 2>&1; then NM=yes; fi
  fi
fi

printf '\n'
printf '  +--------------------------------------------------------------+\n'
printf '  |  VPN ready                                                   |\n'
printf '  +--------------------------------------------------------------+\n'
printf '\n     name: %s\n\n' "$NM_NAME"
if [ "$NM" = yes ]; then
  printf '   1) Desktop     click "%s" in the network menu to connect\n' "$NM_NAME"
  printf '                  or from a terminal:\n'
  printf '                     nmcli con up   "%s"\n' "$NM_NAME"
  printf '                     nmcli con down "%s"\n' "$NM_NAME"
  if [ "$NM_OLD" -gt 0 ]; then
    printf '                  (replaced %d older profile(s) for this tunnel; if one\n' "$NM_OLD"
    printf '                   was connected, connect again)\n'
  fi
else
  printf '   1) Desktop     NetworkManager is not running here, so nothing\n'
  printf '                  was registered. Use option 2.\n'
fi
printf '\n   2) Terminal    sudo wg-quick up   %s\n' "$WG_NAME"
printf '                  sudo wg-quick down %s\n' "$WG_NAME"
printf '\n   Check         sudo wg show          (expect a recent handshake)\n'
printf '                 curl -4 ifconfig.me   (should print %s)\n' "$SRV_IP"
printf '\n   Use one or the other, not both at the same time.\n\n'
PART
    printf '#---------------------- to here ---------------------------\n'
}

do_add() {
    head1 "Add a device"
    local name ip def want cur reach=no proxy=''

    name=$(ask "Device name (letters, digits, - and _)")
    valid_name "$name"
    if peer_exists "$name"; then die "a device named '$name' already exists"; fi

    def=$(next_ip)
    if [ "$PREFIX" -eq 24 ]; then
        want=$(ask "Address (last octet, or full IP)" "${def##*.}")
        if [[ $want =~ ^[0-9]{1,3}$ ]]; then want="${NET_ADDR%.*}.$want"; fi
    else
        want=$(ask "Address" "$def")
    fi
    valid_ipv4 "$want" || die "invalid address: $want"
    ip=$want

    cur=$(ip2int "$ip")
    [ "$cur" -gt "$(ip2int "$SERVER_IP")" ] && [ "$cur" -le "$MAX_HOST" ] \
        || die "$ip is outside the usable range of $SUBNET"
    if used_ips | grep -qxF -- "$ip"; then die "$ip is already assigned"; fi

    printf '\n  Every device is on the same tunnel subnet, so by default it can\n'
    printf '  reach the others (file shares, SSH, dev servers on 0.0.0.0...).\n'
    printf "  Answer 'n' for a device you do not fully trust — a phone you lend\n"
    printf '  out, a machine someone else uses. Your other devices can still\n'
    printf '  reach IN to it, and it still gets internet through this server.\n'
    confirm_yes "  Let '$name' reach the other devices?" && reach=yes

    printf '\n  Its web traffic (tcp/80 and tcp/443) can be diverted to an\n'
    printf '  intercepting proxy running on another device on this VPN — Burp\n'
    printf "  Suite with 'invisible proxying' enabled, or mitmproxy. The device\n"
    printf '  needs no proxy settings, so apps that ignore them are caught too.\n'
    if confirm "  Send '$name' web traffic through a proxy?"; then
        proxy=$(resolve_proxy "$(ask "  Proxy (device name, or ip[:port])" "")")
        [ "${proxy%%:*}" != "$ip" ] || die "a device cannot be its own proxy"
        info "proxying tcp/80 and tcp/443 to $proxy; udp/443 (QUIC) rejected"
    fi

    wg genkey > "$KEYDIR/$name.key"
    chmod 600 "$KEYDIR/$name.key"
    wg pubkey < "$KEYDIR/$name.key" > "$KEYDIR/$name.pub"
    chmod 644 "$KEYDIR/$name.pub"

    cat >> "$WG_CONF" <<EOF

### BEGIN peer $name
[Peer]
# $name
# reach-peers = $reach${proxy:+
# proxy = $proxy}
PublicKey  = $(cat "$KEYDIR/$name.pub")
AllowedIPs = $ip/32, $(v6_for "$ip")/128
### END peer $name
EOF

    reload_wg
    apply_rules add          # picks up this device's isolation rules, if any
    write_client_conf "$name" "$ip" >/dev/null
    info "added '$name' at $ip$([ "$reach" = no ] && printf ', cannot open connections to the other devices' || true)"
    show_client "$name"
}

do_remove() {
    head1 "Remove a device"
    list_peers
    local name
    name=$(ask "Device to remove")
    [ -n "$name" ] || return 0
    valid_name "$name"
    peer_exists "$name" || die "no such device: $name"
    confirm "Really remove '$name' and delete its keys?" || { info "aborted"; return 0; }

    # The rule set is derived from the peer list, so tear it down while this
    # device is still in the file — otherwise its isolation rules would be
    # orphaned in the chain — then rebuild from the trimmed one.
    apply_rules del

    awk -v w="$name" '
        $0 == "### BEGIN peer " w { skip=1 }
        !skip { print }
        $0 == "### END peer " w   { skip=0 }
    ' "$WG_CONF" > "$WG_CONF.new"
    mv "$WG_CONF.new" "$WG_CONF"
    chmod 600 "$WG_CONF"

    rm -f "$KEYDIR/$name.key" "$KEYDIR/$name.pub" "$CLIENTDIR/$name.conf"
    apply_rules add
    reload_wg
    info "removed '$name'"
}

do_isolate() {
    head1 "Device isolation"
    list_peers
    local name cur new=no
    name=$(ask "Device")
    [ -n "$name" ] || return 0
    valid_name "$name"
    peer_exists "$name" || die "no such device: $name"

    if peer_isolated "$name"; then cur=no; else cur=yes; fi
    if [ "$cur" = yes ]; then
        info "currently: '$name' can reach the other devices"
    else
        info "currently: '$name' cannot open connections to the other devices"
        info "           (they can still reach in to it)"
    fi

    # Default follows the current setting, so a stray Enter changes nothing.
    if [ "$cur" = yes ]; then
        confirm_yes "Let '$name' reach the other devices?" && new=yes
    else
        confirm     "Let '$name' reach the other devices?" && new=yes
    fi
    [ "$new" != "$cur" ] || { info "unchanged"; return 0; }

    apply_rules del          # built from the old marker; see do_remove
    # Always writes the marker, so devices added before this option existed —
    # which carry none at all — get one rather than staying unmanaged.
    awk -v w="$name" -v val="$new" '
        $0 == "### BEGIN peer " w    { f=1 }
        f && /^# reach-peers = /     { next }
        f && $0 == "### END peer " w { print "# reach-peers = " val; f=0 }
        { print }
    ' "$WG_CONF" > "$WG_CONF.new"
    mv "$WG_CONF.new" "$WG_CONF"
    chmod 600 "$WG_CONF"
    apply_rules add

    if [ "$new" = yes ]; then
        info "'$name' can now reach the other devices"
    else
        info "'$name' can no longer open connections to the other devices"
        [ -n "$(peer_proxy "$name")" ] && info "its proxy stays reachable, on the proxy port only"
    fi
    info "existing connections keep their old path until they are re-established"
}

# Toggling the proxy is the thing you do constantly while testing, so it has to
# work without regenerating the device's keys and re-pairing it.
do_proxy() {
    head1 "Proxy for a device"
    list_peers
    local name cur new=''
    name=$(ask "Device")
    [ -n "$name" ] || return 0
    valid_name "$name"
    peer_exists "$name" || die "no such device: $name"

    cur=$(peer_proxy "$name")
    info "currently: ${cur:-no proxy}"
    if [ -n "$cur" ]; then
        confirm_yes "Keep proxying '$name'?" && new=$(resolve_proxy "$(ask "Proxy (device name, or ip[:port])" "$cur")")
    else
        confirm "Send '$name' web traffic through a proxy?" \
            && new=$(resolve_proxy "$(ask "Proxy (device name, or ip[:port])" "")")
    fi
    [ "${new%%:*}" != "$(peer_ip "$name")" ] || die "a device cannot be its own proxy"
    [ "$new" != "$cur" ] || { info "unchanged"; return 0; }

    apply_rules del          # built from the old marker; see do_remove
    awk -v w="$name" -v px="$new" '
        $0 == "### BEGIN peer " w    { f=1 }
        f && /^# proxy = /           { next }
        f && $0 == "### END peer " w { if (px != "") print "# proxy = " px; f=0 }
        { print }
    ' "$WG_CONF" > "$WG_CONF.new"
    mv "$WG_CONF.new" "$WG_CONF"
    chmod 600 "$WG_CONF"
    apply_rules add

    if [ -n "$new" ]; then
        info "'$name' now proxied to $new (tcp/80, tcp/443; udp/443 rejected)"
        info "the proxy must listen on $new and have invisible/transparent mode on"
    else
        info "'$name' is no longer proxied"
    fi
    info "existing connections keep their old path until they are re-established"
}

# DNS lives in the CLIENT config, so this only changes what the .conf files on
# this server say. A device that already holds its config keeps the old resolver
# until it is re-imported — there is no way to push it from here.
do_dns() {
    head1 "DNS pushed to clients"
    info "current: ${CLIENT_DNS:-none}"
    printf '\n  This is the resolver written into each client config. Changing it\n'
    printf '  rebuilds the .conf files here, but a device that is already paired\n'
    printf '  keeps its old resolver until you re-import it (option 3 for the QR,\n'
    printf '  option 4 for the Linux block).\n\n'

    local dns n=0 name ip
    dns=$(ask "DNS pushed to clients (or 'none')" "${CLIENT_DNS:-none}")
    if [ "$dns" = "none" ]; then dns=""; fi
    [ -z "$dns" ] || [[ $dns =~ ^[0-9a-fA-F.:,\ ]+$ ]] || die "DNS must be IP addresses: $dns"
    [ "$dns" != "$CLIENT_DNS" ] || { info "unchanged"; return 0; }

    CLIENT_DNS=$dns
    write_state

    while read -r name; do
        [ -n "$name" ] || continue
        if [ ! -f "$KEYDIR/$name.key" ]; then
            info "skipped '$name' — its private key is gone, cannot rebuild its config"
            continue
        fi
        ip=$(peer_ip "$name")
        write_client_conf "$name" "$ip" >/dev/null
        n=$((n+1))
    done < <(peer_names)

    info "DNS is now ${CLIENT_DNS:-none}; rebuilt $n client config(s)"
    if [ "$n" -gt 0 ]; then
        info "re-import each device (option 3 or 4) before it takes effect there"
    fi
}

do_uninstall() {
    head1 "Uninstall"
    printf 'This removes the %s interface, the simplewire iptables rules and every key.\n' "$WG_IF"
    local ans
    ans=$(ask "Type UNINSTALL to confirm")
    [ "$ans" = "UNINSTALL" ] || { info "aborted"; return 0; }

    systemctl disable -q --now "wg-quick@$WG_IF" 2>/dev/null || true
    ip link del "$WG_IF" 2>/dev/null || true
    apply_rules del
    rm -f "$SYSCTL_FILE"
    sysctl -q --system
    rm -rf "$WGDIR"
    info "removed $WGDIR, iptables rules and $SYSCTL_FILE"

    local pm
    if pm=$(detect_pm) && confirm "Also remove the wireguard-tools and qrencode packages?"; then
        case $pm in
            apt-get) DEBIAN_FRONTEND=noninteractive apt-get purge -y -qq wireguard-tools qrencode ;;
            pacman)  pacman -Rns --noconfirm wireguard-tools qrencode ;;
            dnf)     dnf remove -y -q wireguard-tools qrencode ;;
            zypper)  zypper --non-interactive --quiet remove wireguard-tools qrencode ;;
        esac
    fi
    info "done"
}

do_status() {
    head1 "Status"
    systemctl is-active --quiet "wg-quick@$WG_IF" \
        && info "wg-quick@$WG_IF: active" || info "wg-quick@$WG_IF: INACTIVE"
    printf '\n'
    wg show "$WG_IF" 2>/dev/null || info "(interface is down)"
    printf '\nDevices:\n'
    list_peers
    printf '\nFirewall rules tagged "%s":\n' "$TAG"
    { iptables-save; ip6tables-save 2>/dev/null || true; } \
        | grep -- "$TAG" | sed 's/^/  /' || info "  (none)"
}

# -------------------------------------------------------------------- menu ---

menu_installed() {
    while true; do
        load_state
        head1 "WireGuard on $ENDPOINT:$PORT — $SUBNET"
        list_peers
        printf '\n  1) Add a device\n  2) Remove a device\n'
        printf '  3) Show QR for a device        (phones, any QR-capable client)\n'
        printf '  4) Show paste-and-run setup    (Linux)\n'
        printf '  5) Device isolation            (reach other devices?)\n'
        printf '  6) Proxy for a device          (Burp / mitmproxy)\n'
        printf '  7) DNS pushed to clients\n'
        printf '  8) Status\n  9) Uninstall server\n  q) Quit\n\n'
        local choice
        choice=$(ask "Choice" "q")
        case $choice in
            1) do_add ;;
            2) do_remove ;;
            3) local n; n=$(ask "Device name"); if [ -n "$n" ]; then show_client "$n"; fi ;;
            4) local m; m=$(ask "Device name"); if [ -n "$m" ]; then show_linux  "$m"; fi ;;
            5) do_isolate ;;
            6) do_proxy ;;
            7) do_dns ;;
            8) do_status ;;
            9) do_uninstall; return 0 ;;
            q|Q) return 0 ;;
            *) info "no such option" ;;
        esac
    done
}

main() {
    need_root

    # Non-interactive mode, called from wg0.conf's PostUp. Handled before the
    # tty check below because at boot there is no terminal, and kept minimal so
    # a failure here cannot stop the tunnel from coming up.
    if [ "${1-}" = --apply-rules ]; then
        is_installed || die "not installed — no $STATE"
        load_state
        apply_rules add
        return 0
    fi

    # Every prompt below reads stdin. Piped into bash (curl … | sudo bash) stdin
    # is the script itself, so `read` would silently eat its own source lines.
    [ -t 0 ] || die "run this from a terminal — download the script first, do not pipe it into bash"
    command -v ip >/dev/null || die "iproute2 is missing"
    require_platform

    if is_installed; then
        menu_installed
    else
        head1 "No WireGuard server configured on this host"
        printf '\n  1) Install WireGuard server\n  q) Quit\n\n'
        local choice
        choice=$(ask "Choice" "1")
        case $choice in
            1) do_install; load_state; menu_installed ;;
            *) return 0 ;;
        esac
    fi
}

main "$@"
