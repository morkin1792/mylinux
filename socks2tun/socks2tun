#!/usr/bin/env bash
#
# socks2tun — SOCKS5 proxy (dante) whose outgoing traffic leaves through a VPN
# interface, so single apps can use the VPN while the rest of the box does not.
#
#   socks2tun.sh [-p port] [-b bind] [iface]   start (defaults: 1080, 0.0.0.0, tun0)
#   socks2tun.sh stop                          stop and remove the routing rules
#
# It listens on every interface by default, and with socksmethod none anyone who
# can reach the port gets a free ride into the VPN — restrict it with
# -b 127.0.0.1 (this machine only) or -b <lan ip> when you don't trust the network.
#
set -euo pipefail

PORT=1080
BIND=0.0.0.0
TABLE=100
CONF=/etc/danted.conf

die() { echo "socks2tun: $*" >&2; exit 1; }

usage() {
    echo "usage: $0 [-p port] [-b bind_addr] [iface]" >&2
    echo "       $0 stop" >&2
    exit 1
}

stop() {
    sudo systemctl stop danted || true
    # one rule deleted per call, so loop until there are none left
    while sudo ip rule del table "$TABLE" 2>/dev/null; do :; done
    sudo ip route flush table "$TABLE" 2>/dev/null || true
    sudo ip route flush cache
    echo "socks2tun: stopped"
}

install_dante() {
    if [ -x /usr/sbin/danted ] || command -v danted >/dev/null; then
        return 0
    fi
    command -v apt-get >/dev/null || die "dante-server not installed and no apt-get here — install it, then rerun"
    sudo apt-get install -y dante-server
    sudo systemctl disable danted || true   # started on demand by this script
}

if [ "${1:-}" = stop ]; then
    stop
    exit 0
fi

while getopts ':p:b:h' opt; do
    case $opt in
        p) PORT=$OPTARG ;;
        b) BIND=$OPTARG ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))
IFACE=${1:-tun0}

ip link show dev "$IFACE" >/dev/null 2>&1 || die "no interface '$IFACE' — connect to the VPN first"
IFACE_IP=$(ip -4 -o addr show dev "$IFACE" scope global | awk 'NR==1 {print $4}' | cut -d/ -f1)
[ -n "$IFACE_IP" ] || die "'$IFACE' has no IPv4 address — is the VPN up?"

install_dante

sudo tee "$CONF" >/dev/null <<EOF
# generated by socks2tun.sh — edits are overwritten
logoutput: /var/log/danted.log

internal: $BIND port = $PORT
external: $IFACE

user.privileged: root
user.unprivileged: nobody

socksmethod: none
clientmethod: none

client pass {
    from: 0.0.0.0/0 to: 0.0.0.0/0
    log: error connect disconnect
}

socks pass {
    from: 0.0.0.0/0 to: 0.0.0.0/0
    log: error connect disconnect
}
EOF

# send anything sourced from the tunnel IP out of the tunnel, whatever the main
# routing table says
sudo ip route replace default dev "$IFACE" table "$TABLE"
sudo ip rule list | grep -q "from $IFACE_IP lookup $TABLE" ||
    sudo ip rule add from "$IFACE_IP" table "$TABLE"
sudo ip route flush cache

sudo systemctl restart danted
sudo systemctl is-active --quiet danted || die "danted failed to start — journalctl -u danted"

echo "socks2tun: socks5://$BIND:$PORT -> $IFACE ($IFACE_IP)"
TEST_HOST=$BIND
if [ "$BIND" = 0.0.0.0 ]; then
    TEST_HOST=127.0.0.1
    echo "NOTICE: reachable from the whole LAN with no authentication."
    echo "         Restrict it with -b 127.0.0.1 (this machine only) or -b <lan ip>."
fi
echo
echo "Use this command to test it:"
echo "  curl --socks5-hostname $TEST_HOST:$PORT https://ifconfig.me"
echo "It should print the VPN's public IP, not yours."
