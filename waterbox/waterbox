#!/usr/bin/env bash

# simple sandbox for running CLI AI agents

set -e

WATERBOX_VERSION="1.9"

# Absolute path to this script, recorded so the shell-completion snippet can fall
# back to it when 'waterbox' isn't on $PATH (e.g. run by ./waterbox, or moved).
SELF_PATH="$(readlink -f "${BASH_SOURCE[0]:-$0}" 2>/dev/null || echo "$0")"

# --- Configuration ---
JAIL_ROOT="$HOME/.waterbox/root"
CONFIG_DIR="$HOME/.waterbox"
SHARE_LIST="$CONFIG_DIR/shared_paths"
GUI_ENV_FILE="$CONFIG_DIR/gui_env"       # export VAR="val" lines; helper copies into the rootfs
GUI_BINDS_FILE="$CONFIG_DIR/gui_binds"   # --bind spec lines the helper validates at boot
USER_NAME="water"               # user inside the container (uid 1000 == host user)
RUN_USER="$(id -un)"            # the host user invoking this script
MACHINE_NAME="waterbox"         # external name: systemd unit, machinectl, ve-* iface
INSIDE_HOSTNAME="box"           # hostname shown inside the container
TMUX_SESSION="box"              # tmux session that wraps the interactive shell
CONTAINER_WORKSPACE="/home/$USER_NAME/workspace"

# --- Self-update ---------------------------------------------------------------
# Canonical release of this script. The session picker refreshes UPDATE_CHECK_FILE
# in the background (throttled) and shows a one-line WARN when upstream is newer;
# `waterbox update` fetches this and overwrites SELF_PATH.
UPDATE_URL="https://raw.githubusercontent.com/morkin1792/mylinux/master/waterbox/waterbox"
PROJECT_URL="https://github.com/morkin1792/mylinux"
UPDATE_CHECK_FILE="$CONFIG_DIR/latest_version"   # cached upstream version (bg-refreshed)
UPDATE_CHECK_INTERVAL=86400                       # seconds between background checks (24h)
UPDATE_CHECK_ERROR="download-error"

# Root helper (req: safe privilege model). All privileged RUNTIME ops go through
# this root-owned, uid-1000-immutable binary so the sudoers rule can be NOPASSWD
# for THIS one file only (fixed verbs, no argument-injection path). bootstrap/reset
# stay on interactive sudo (inherently broad; you're present for them).
HELPER_DIR="/usr/local/lib/waterbox"
HELPER_PATH="$HELPER_DIR/waterbox-helper"
HELPER_SUDOERS="/etc/sudoers.d/waterbox-helper"

# --- Network parameters ---
HOST_IP="10.20.30.1"
CONTAINER_IP="10.20.30.2"
NET_CIDR="24"
HOST_ALIAS="host"               # name resolved to $HOST_IP inside the container
VE_IFACE="ve-$MACHINE_NAME"     # systemd-nspawn names the host side ve-<machine>

# If true, the container (10.20.30.0/24) is allowed to reach ANY port the host
# listens on. Combined with the DNAT rule below, this lets the container hit
# host loopback services (MCP servers, dev servers, etc.) as `host:PORT` even
# when the host has a restrictive INPUT policy (ufw, firewalld, etc.).
ALLOW_CONTAINER_TO_HOST_PORTS=true

# DNS servers used inside the container. A VPN client inside is free to replace
# /etc/resolv.conf at runtime.
DNS_SERVERS=("8.8.8.8" "1.1.1.1")

# --- Arch bootstrap image (req 6: no host pacstrap, works on any distro) ------
# We fetch the official signed Arch bootstrap tarball and install packages
# *inside* it with the container's own pacman, so the host only needs
# systemd-nspawn + iptables + curl + gpg/pacman-key + zstd/tar (all on Mint via
# apt). The big tarball comes from a fast geo mirror, but the signature comes
# from archlinux.org (an independent canonical origin) and is verified against a
# pinned key — so a malicious mirror can't slip in a forged image.
ARCH_MIRROR="https://geo.mirror.pkgbuild.com/iso/latest"
ARCH_SIG_ORIGIN="https://archlinux.org/iso/latest"
ARCH_BOOTSTRAP_TARBALL="archlinux-bootstrap-x86_64.tar.zst"
# Verified live (2026-06): the bootstrap image is signed by Pierre Schmitz.
# Update from https://archlinux.org/ (master keys) over HTTPS if Arch rotates it.
ARCH_BOOTSTRAP_KEY="3E80CA1A8B89F69CBA57D98A76A5EF9054449A5C"

PKGS=(
    base base-devel bash git nodejs npm sudo coreutils
    iproute2 iputils dbus
    zsh powerline powerline-fonts grml-zsh-config
    zsh-autosuggestions zsh-completions
    zsh-history-substring-search zsh-syntax-highlighting
    ripgrep tmux bind vim less
    openssh nano openbsd-netcat curl
    python           # JSON for the statusline (powerline pulls it in anyway; explicit here)
    openai-codex     # Codex CLI. In [extra], so pacman -Syu keeps it current
)

# --- Agent registry -----------------------------------------------------------
# The CLI agents the box knows about. Everything else here is agent-agnostic:
# teaching waterbox a new agent should be adding a row, not editing logic.
#
# Fields, '|' separated:
#   1 key        short id; also the directory name under ~/.agent-env/
#   2 label      human name (help text, banners, menus)
#   3 binary     the command you type inside the box
#   4 home var   env var that relocates the agent's ENTIRE config dir, credentials
#                included. This is the one thing an agent must have for us to give
#                it per-account profiles at all — no var, no profiles.
#   5 settings   file inside that dir holding our bypass defaults
#   6 home dir   the agent's own dir under $HOME, used when no profile is active
#                and as the template we seed new profiles from
#   7 history    paths inside a profile that hold chat history; these get symlinked
#                into the agent's shared store so history follows you across
#                accounts ('/' suffix = directory, otherwise a file)
AGENTS=(
    'claude|Claude Code|claude|CLAUDE_CONFIG_DIR|settings.json|.claude|projects/ todos/'
    'codex|Codex|codex|CODEX_HOME|config.toml|.codex|sessions/ history.jsonl'
)
_agent_keys() { local row; for row in "${AGENTS[@]}"; do printf '%s\n' "${row%%|*}"; done; }
_agent_field() {   # $1 = agent key, $2 = field number (1-7)
    local row; local -a f
    for row in "${AGENTS[@]}"; do
        [ "${row%%|*}" = "$1" ] || continue
        IFS='|' read -r -a f <<< "$row"
        printf '%s' "${f[$(($2 - 1))]}"; return 0
    done
    return 1
}

# The bypass defaults seeded into every profile of an agent. The box IS the
# sandbox, so each agent is told to stop policing itself — that's the whole point
# of running them in here.
_agent_settings_template() {   # $1 = agent key; writes the settings file body
    case "$1" in
        claude)
            cat <<'EOF'
{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "effortLevel": "high",
  "autoMemoryEnabled": true,
  "tui": "fullscreen",
  "viewMode": "focus",
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh",
    "refreshInterval": 30
  }
}
EOF
            ;;
        codex)
            cat <<'EOF'
# waterbox defaults for Codex.
#
# Both keys are needed. approval_policy decides whether Codex ASKS; sandbox_mode
# decides what it is technically ALLOWED to do. Setting only the policy to "never"
# on a read-only sandbox gets you an agent that never asks and still can't write.
#
# danger-full-access is the honest setting here: the nspawn container is the real
# security boundary, and Codex's own landlock/seccomp sandbox is both redundant
# inside it and liable to fail or fight the container's mounts.
approval_policy = "never"
sandbox_mode = "danger-full-access"
EOF
            ;;
    esac
}

# GUI: display forwarding. Default "auto" = Wayland-only on a Wayland host, OFF on
# X11. Wayland isolates clients (a box app sees only its own surfaces and gets input
# only while focused). X11 has no client isolation at all: any client can keylog
# every other window, screenshot the full screen, read the clipboard and inject
# input — so forwarding X hands the sandboxed agent the whole desktop and defeats
# the point of the box. Force with --gui / --no-gui, or WATERBOX_GUI=1/0.
# GPU (/dev/dri) is shared, not exclusive, so it's bound by default; --no-gpu off.
WATERBOX_GUI="${WATERBOX_GUI:-auto}"
WATERBOX_NO_GPU="${WATERBOX_NO_GPU:-0}"
WATERBOX_HERE="${WATERBOX_HERE:-0}"   # `start --here`: share cwd + open a session in it
WATERBOX_X11="${WATERBOX_X11:-0}"     # explicit opt-in to X11/Xwayland on a Wayland host
# Deliberately NOT configurable through the environment or a saved config file.
# Only the hidden, explicit CLI flag may enable this for the current invocation.
WATERBOX_UNSAFE_HOST_ROOT=0

# Runtime resource guardrails. The box may use idle host capacity, but it must not
# be able to OOM/fork-bomb the host. CPU/IO weights preserve burst performance while
# making host work win under contention; memory/tasks are hard ceilings.
WATERBOX_MEMORY_HIGH="60%"
WATERBOX_MEMORY_MAX="70%"
# Kept as a percentage in Waterbox, then converted to bytes before systemd-run.
# systemd 249 accepts percentage RAM limits but only an absolute MemorySwapMax.
WATERBOX_SWAP_MAX_PERCENT="10"
WATERBOX_TASKS_MAX="2048"
WATERBOX_CPU_WEIGHT="50"
WATERBOX_IO_WEIGHT="50"

mkdir -p "$CONFIG_DIR"
touch "$SHARE_LIST"

# --- Logging ---
log_info()    { echo -e "\e[34m[INFO]\e[0m $1"; }
log_success() { echo -e "\e[32m[ OK ]\e[0m $1"; }
log_warn()    { echo -e "\e[33m[WARN]\e[0m $1"; }
log_error()   { echo -e "\e[31m[ERR ]\e[0m $1"; exit 1; }

# --- Symlink-safe writes into the rootfs ---------------------------------------
# Container root owns everything under $JAIL_ROOT, so it can point any managed file
# — or a parent directory of one — at a host path. `sudo tee` / `>` / install follow
# symlinks and are NOT chrooted, so that would let the box overwrite host files as
# root (e.g. /etc/passwd, /etc/sudoers.d/*) the next time we refresh the in-box
# config. realpath -m resolves the whole chain (no existence required); anything that
# lands outside the rootfs means the box tampered with it, so refuse rather than
# write. No temp file and no rm: nothing to leak, nothing to delete by accident.
_in_jail() {   # $1 = intended destination path under $JAIL_ROOT
    local rp; rp=$(realpath -m "$1" 2>/dev/null) || return 1
    case "$rp" in "$JAIL_ROOT"/*) return 0 ;; *) return 1 ;; esac
}
wb_tee() {     # usage: … | wb_tee <dest>   (root-owned write, symlink-safe)
    _in_jail "$1" \
        || log_error "Refusing to write '$1': it resolves outside $JAIL_ROOT, so the box has tampered with that path. Run 'waterbox reset' to rebuild the rootfs."
    sudo tee "$1" > /dev/null
}

# Ctrl-C anywhere: restore the terminal cursor (menus hide it) and exit cleanly with
# no error code or stack — the user asked that interrupting a menu not look like a
# crash. Menus also offer an in-list 'quit' + 'q' to back out without leaving.
_on_interrupt() { printf '\e[?25h\n' > /dev/tty 2>/dev/null || true; exit 0; }
trap _on_interrupt INT

# Help palette. Left empty when stdout isn't a terminal (so `waterbox --help | grep`
# or a redirect to a file stays clean) or when NO_COLOR is set.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_HEAD=$'\e[1;36m'   # section headings
    C_CMD=$'\e[36m'      # commands and anything else you type
    C_DIM=$'\e[2m'       # asides and hints
    C_OFF=$'\e[0m'
else
    C_HEAD=''; C_CMD=''; C_DIM=''; C_OFF=''
fi

