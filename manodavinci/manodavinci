# -------------------------------------------------------------------- colour --
# Just enough colour that someone skimming a wall of text still catches the
# parts that matter: section titles, commands to type, the codec to pick.
# Off when piped to a file, on a dumb terminal, or when NO_COLOR is set.
def palette(color=None):
    if color is None:
        color = (sys.stdout.isatty() and os.environ.get("TERM") != "dumb"
                 and not os.environ.get("NO_COLOR"))
    if not color:
        return dict(H="", G="", C="", Y="", D="", Z="")
    return dict(H="\033[1m",       # section headings
                G="\033[1;32m",    # the part to read if you read nothing else
                C="\033[1;36m",    # a command to type
                Y="\033[1;33m",    # a setting to pick / the default
                D="\033[2m",       # side notes
                Z="\033[0m")


def paint(text, color=None, **kw):
    return text.format(v=VERSION, **dict(palette(color), **kw))

