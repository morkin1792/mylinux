# =============================================================== small helpers ==
def have(cmd):
    return any(os.access(os.path.join(p, cmd), os.X_OK)
               for p in os.environ.get("PATH", "").split(os.pathsep) if p)


def die(msg):
    red = "\033[1;31m" if sys.stderr.isatty() and not os.environ.get("NO_COLOR") else ""
    off = "\033[0m" if red else ""
    sys.stderr.write("%serror:%s %s\n" % (red, off, msg))
    sys.exit(1)


