# Everything a Linux client needs as ONE block to paste. The block installs
# wireguard-tools if missing, writes the config, registers it with
# NetworkManager when NetworkManager is actually running, and finally prints
# the how-to-connect summary itself — so the user reads the instructions on the
# machine they just set up, not mixed into this server's output.
#
# Emission note: the parts below are quoted heredocs (<<'PART') so $WG_NAME and
# friends survive to be expanded on the CLIENT. Only the three assignment lines
# are substituted here, on the server.
# Reads one key out of a client config. Anchored and non-global, so the "=" in
# base64 key material survives.
conf_get() { sed -n "s/^$2[[:space:]]*=[[:space:]]*//p" "$1" | head -1; }

# Stable UUID derived from the profile name, so regenerating this block targets
# the same NetworkManager profile instead of creating a second one.
stable_uuid() {
    local h
    h=$(printf '%s' "$1" | sha1sum | cut -c1-32)
    printf '%s-%s-5%s-a%s-%s' "${h:0:8}" "${h:8:4}" "${h:13:3}" "${h:17:3}" "${h:20:12}"
}

# A NetworkManager keyfile for this client, with autoconnect=false baked in.
# Written straight to disk rather than going through `nmcli connection import`:
# an imported profile is born with autoconnect=yes and WireGuard supplies its
# own virtual device, so NM activates it instantly and the desktop shows
# "activated" then "deactivated" as we turn it back off. Creating the file
# already disabled means NM never activates it and stays quiet.
nm_keyfile() {  # nm_keyfile <conf> <id> <iface> <uuid>
    local conf=$1 id=$2 iface=$3 uuid=$4 addr v4 v6 dns aips

    addr=$(conf_get "$conf" Address)
    v4=${addr%%,*}; v4=${v4// /}
    v6=""; case $addr in *,*) v6=${addr#*,}; v6=${v6// /} ;; esac
    dns=$(conf_get "$conf" DNS)
    aips=$(conf_get "$conf" AllowedIPs | tr -d ' ' | tr ',' ';')

    printf '[connection]\nid=%s\nuuid=%s\ntype=wireguard\ninterface-name=%s\nautoconnect=false\n\n' \
        "$id" "$uuid" "$iface"
    printf '[wireguard]\nprivate-key=%s\n\n' "$(conf_get "$conf" PrivateKey)"
    printf '[wireguard-peer.%s]\nendpoint=%s\nallowed-ips=%s;\n' \
        "$(conf_get "$conf" PublicKey)" "$(conf_get "$conf" Endpoint)" "$aips"
    local ka; ka=$(conf_get "$conf" PersistentKeepalive)
    [ -n "$ka" ] && printf 'persistent-keepalive=%s\n' "$ka"
    printf '\n[ipv4]\nmethod=manual\naddress1=%s\n' "$v4"
    # negative priority = this connection's DNS wins while the tunnel is up
    [ -n "$dns" ] && printf 'dns=%s;\ndns-priority=-50\n' "$dns"
    printf '\n[ipv6]\n'
    if [ -n "$v6" ]; then printf 'method=manual\naddress1=%s\n' "$v6"
    else                  printf 'method=ignore\n'; fi
    printf 'addr-gen-mode=default\n'
    return 0
}

show_linux() {  # show_linux <name>
    local name=$1 conf tun nmid uuid keyfile
    valid_name "$name"
    conf="$CLIENTDIR/$name.conf"
    [ -f "$conf" ] || die "no client config at $conf"
    tun=$(suggest_tunnel_name "$name")   # same name the QR screen suggests
    nmid="$name@$SERVER_HOST"
    uuid=$(stable_uuid "$nmid")
    keyfile=$(nm_keyfile "$conf" "$nmid" "$tun" "$uuid")

    head1 "Linux setup for '$name'"
    printf '\nCopy the whole block and paste it into the client terminal. It will\n'
    printf 'install what is missing, write the config, register it with\n'
    printf 'NetworkManager if present, then print how to connect.\n\n'

    printf '#--------------------- copy from here ---------------------\n'
    printf 'WG_NAME=%s\n'   "$tun"
    printf "NM_NAME='%s'\n" "$nmid"
    printf 'WG_UUID=%s\n'   "$uuid"
    printf "SRV_IP='%s'\n"  "$ENDPOINT"
    printf 'WG_FULL=%s\n'   "$(peer_full_tunnel "$name" && echo yes || echo no)"
    printf "WG_NET='%s'\n"  "$SUBNET"
    printf "WG_GW='%s'\n\n" "$SERVER_IP"
    cat <<'PART'
if ! command -v wg >/dev/null 2>&1; then
  if   command -v apt-get >/dev/null 2>&1; then sudo apt-get update -qq && sudo apt-get install -y wireguard-tools
  elif command -v pacman  >/dev/null 2>&1; then sudo pacman -S --needed --noconfirm wireguard-tools
  elif command -v dnf     >/dev/null 2>&1; then sudo dnf install -y wireguard-tools
  elif command -v zypper  >/dev/null 2>&1; then sudo zypper install -y wireguard-tools
  else echo "!! install wireguard-tools yourself, then paste this again"; fi
fi

sudo install -d -m 700 /etc/wireguard
sudo tee "/etc/wireguard/$WG_NAME.conf" >/dev/null <<'WGEOF'
PART
    cat "$conf"
    cat <<'PART'
WGEOF
sudo chmod 600 "/etc/wireguard/$WG_NAME.conf"

NM=no
NM_OLD=0
if command -v nmcli >/dev/null 2>&1 && systemctl is-active --quiet NetworkManager 2>/dev/null; then
  # Drop stray profiles for this tunnel left by earlier runs — match either of
  # our names or the interface it binds (catches a hand-renamed profile). Our
  # own profile is skipped by UUID: its file is simply overwritten below.
  for u in $(sudo nmcli -t -f UUID,TYPE connection show 2>/dev/null \
             | awk -F: '$2 == "wireguard" { print $1 }'); do
    if [ "$u" = "$WG_UUID" ]; then continue; fi
    cid=$(sudo nmcli -g connection.id             connection show "$u" 2>/dev/null)
    cif=$(sudo nmcli -g connection.interface-name connection show "$u" 2>/dev/null)
    if [ "$cid" = "$NM_NAME" ] || [ "$cid" = "$WG_NAME" ] || [ "$cif" = "$WG_NAME" ]; then
      sudo nmcli connection delete uuid "$u" >/dev/null 2>&1 && NM_OLD=$((NM_OLD + 1))
    fi
  done

  # Write the profile with autoconnect=false already set, so NM never activates
  # it and the desktop stays silent. (`nmcli connection import` would create it
  # with autoconnect=yes, activate it at once, and pop up activated/deactivated
  # notifications when we turned it back off.)
  # Create the file 0600 *before* writing it: this one carries the private key,
  # and unlike /etc/wireguard its directory is world-traversable, so a
  # tee-then-chmod would leave the key readable to every local user in between.
  sudo mkdir -p /etc/NetworkManager/system-connections
  sudo install -m 600 /dev/null "/etc/NetworkManager/system-connections/$WG_NAME.nmconnection"
  sudo tee "/etc/NetworkManager/system-connections/$WG_NAME.nmconnection" >/dev/null <<'NMEOF'
PART
    printf '%s\n' "$keyfile"
    cat <<'PART'
NMEOF
  sudo nmcli connection reload >/dev/null 2>&1
  if sudo nmcli -g connection.id connection show "$WG_UUID" >/dev/null 2>&1; then
    NM=yes
  else
    # Keyfile not accepted (older NM, unexpected schema): fall back to import so
    # a profile still ends up registered. This path does flash a notification.
    echo "!! keyfile not accepted, falling back to nmcli import"
    sudo nmcli connection import type wireguard file "/etc/wireguard/$WG_NAME.conf" >/dev/null 2>&1 \
      && sudo nmcli connection modify "$WG_NAME" connection.id "$NM_NAME" connection.autoconnect no >/dev/null 2>&1
    sudo nmcli connection down "$NM_NAME" >/dev/null 2>&1
    if sudo nmcli -g connection.id connection show "$NM_NAME" >/dev/null 2>&1; then NM=yes; fi
  fi
fi

printf '\n'
printf '  +--------------------------------------------------------------+\n'
printf '  |  VPN ready                                                   |\n'
printf '  +--------------------------------------------------------------+\n'
printf '\n     name: %s\n\n' "$NM_NAME"
if [ "$NM" = yes ]; then
  printf '   1) Desktop     click "%s" in the network menu to connect\n' "$NM_NAME"
  printf '                  or from a terminal:\n'
  printf '                     nmcli con up   "%s"\n' "$NM_NAME"
  printf '                     nmcli con down "%s"\n' "$NM_NAME"
  if [ "$NM_OLD" -gt 0 ]; then
    printf '                  (replaced %d older profile(s) for this tunnel; if one\n' "$NM_OLD"
    printf '                   was connected, connect again)\n'
  fi
else
  printf '   1) Desktop     NetworkManager is not running here, so nothing\n'
  printf '                  was registered. Use option 2.\n'
fi
printf '\n   2) Terminal    sudo wg-quick up   %s\n' "$WG_NAME"
printf '                  sudo wg-quick down %s\n' "$WG_NAME"
printf '\n   Check         sudo wg show          (expect a recent handshake)\n'
if [ "$WG_FULL" = yes ]; then
  printf '                 curl -4 ifconfig.me   (should print %s)\n' "$SRV_IP"
else
  printf '                 ip route get %s   (should say "dev %s")\n' "$WG_GW" "$WG_NAME"
  printf '\n   Split tunnel: only %s goes through the VPN. Your public IP\n' "$WG_NET"
  printf '                 and everything else are unchanged.\n'
fi
printf '\n   Use one or the other, not both at the same time.\n\n'
PART
    printf '#---------------------- to here ---------------------------\n'
}

# What the gateway device itself has to do. Its WireGuard config is NOT part of
# it — the server-side change is enough for the traffic to arrive. What is
# missing is plain Linux routing:
#
#   * ip_forward, or the kernel drops anything not addressed to it;
#   * MASQUERADE, which is the one people leave out. Packets arrive with the
#     ORIGINAL client source (10.8.0.x) on purpose, so the gateway can NAT them
#     to its own address. Without it they go out with a private source and the
#     replies are dropped somewhere on the internet — the tunnel looks up, the
#     handshake is fine, and nothing loads;
#   * explicit FORWARD accepts, because the policy is DROP on any host that has
#     run Docker, and on plenty of hardened images.
show_gateway() {  # show_gateway <name>
    local name=$1
    head1 "Set up '$name' as the gateway"
    printf '\nRun this ON %s. Nothing about its WireGuard config changes — this\n' "$name"
    printf 'is just Linux routing, which it does not do by default.\n\n'
    printf '#--------------------- copy from here ---------------------\n'
    cat <<EOF
WGIF=\$(sudo wg show interfaces | awk '{print \$1}')
test -n "\$WGIF" || echo '!! no wireguard interface is up here'

sudo tee /etc/sysctl.d/99-simplewire-gateway.conf >/dev/null <<SYSCTL
net.ipv4.ip_forward=1
# Strict reverse-path filtering drops forwarded tunnel traffic with no log and
# no counter, because the route back to $SUBNET is not the interface the
# reply would leave by. Loose (2) still rejects genuinely unroutable sources.
# The kernel takes max(all, <iface>), so both have to come down.
net.ipv4.conf.all.rp_filter=2
net.ipv4.conf.default.rp_filter=2
SYSCTL
sudo sysctl -q --system
sudo sysctl -qw "net.ipv4.conf.\$WGIF.rp_filter=2"

# NAT everything from the tunnel that is NOT heading back into the tunnel.
# Matching on "not the tunnel" rather than on a guessed WAN name keeps working
# on a laptop that moves between ethernet, wifi and a phone hotspot.
sudo iptables -t nat -A POSTROUTING -s $SUBNET ! -o "\$WGIF" -j MASQUERADE
sudo iptables -A FORWARD -i "\$WGIF" ! -o "\$WGIF" -s $SUBNET -j ACCEPT
sudo iptables -A FORWARD -o "\$WGIF" -d $SUBNET -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT

# If this machine's own default route is the VPN, forwarding hands the traffic
# straight back to the server, which sends it here again. Break the loop loudly
# rather than letting it ping-pong until the TTL runs out.
sudo iptables -A FORWARD -i "\$WGIF" -o "\$WGIF" -s $SUBNET ! -d $SUBNET -j REJECT

# Where would a forwarded packet from the tunnel actually go? Any interface
# other than \$WGIF is fine. If it says "dev \$WGIF", see the note below.
ip route get 8.8.8.8 from ${SUBNET%/*} iif "\$WGIF" 2>&1 | head -1
EOF
    printf '#---------------------- to here ---------------------------\n'
    printf '\n  The last line is the check: it asks the kernel where a packet from\n'
    printf '  the tunnel would actually go. If it answers with the tunnel\n'
    printf '  interface again, %s is full-tunnel and its own default route is\n' "$name"
    printf '  this server — traffic would loop, and the REJECT above stops it.\n'
    printf '  Make it split-tunnel with option 7 and re-import it.\n'
    printf '\n  Any OTHER interface is fine, including one belonging to a second\n'
    printf '  VPN (nordlynx, tun0, ...). That is worth knowing rather than\n'
    printf '  debugging later: the routed devices then come out of THAT VPN, so\n'
    printf '  the chain is device -> this server -> %s -> its VPN -> internet.\n' "$name"
    printf '\n  The iptables lines are not persistent. Re-run them after a reboot,\n'
    printf '  or save them with whatever your distro uses (iptables-persistent,\n'
    printf '  iptables-save > /etc/iptables/iptables.rules, ...). The sysctl ones\n'
    printf '  are — that is what the tee is for.\n'
    printf '\n  Note this makes %s a trusted device: to route for others it\n' "$name"
    printf '  holds 0.0.0.0/0 here, which also means this server now accepts any\n'
    printf '  source address from it, not just its own.\n'
}

# The DNAT lands the traffic on the proxy machine, but that machine's own
# firewall still has to accept it, and a Burp box is exactly the kind of laptop
# that has one. Printed rather than applied: it is a different machine.
show_proxy_open() {  # show_proxy_open <proxy-ip:port> <device-name> <device-ip>
    # Declared before assigning: `local a=$1 b=${a%%:*}` shadows a before b is
    # computed, so b comes out empty. resolve_proxy splits them for the same reason.
    local px=$1 dev=$2 devip=$3 host port who
    host=${px%%:*}; port=${px##*:}
    who=$(peer_by_ip "$host")
    printf '\n  If %s does not answer on %s, its firewall is the usual reason.\n' \
        "${who:-the machine at $host}" "$port"
    printf '  Run this there:\n\n'
    # The DNAT rewrites the destination, not the source, so packets reach the
    # proxy still carrying the device's own tunnel address — which makes the
    # rule exact instead of opening the port to the whole VPN.
    printf '    sudo iptables -I INPUT 1 -s %s -p tcp --dport %s -j ACCEPT\n\n' "$devip" "$port"
    printf '  That is %s only. Proxying another device to the same proxy needs\n' "$dev"
    printf '  the same line again with its address — this option prints it.\n'
    printf '  The proxy also has to BIND to %s or 0.0.0.0; on 127.0.0.1 it is\n' "$host"
    printf '  unreachable from the tunnel however the firewall is set.\n'
}

do_add() {
    head1 "Add a device"
    local name ip def want cur reach=no proxy='' ftun=no gw='' gwname=''

    name=$(ask "Device name (letters, digits, - and _)")
    valid_name "$name"
    if peer_exists "$name"; then die "a device named '$name' already exists"; fi

    def=$(next_ip)
    if [ "$PREFIX" -eq 24 ]; then
        want=$(ask "Address (last octet, or full IP)" "${def##*.}")
        if [[ $want =~ ^[0-9]{1,3}$ ]]; then want="${NET_ADDR%.*}.$want"; fi
    else
        want=$(ask "Address" "$def")
    fi
    valid_ipv4 "$want" || die "invalid address: $want"
    ip=$want

    cur=$(ip2int "$ip")
    [ "$cur" -gt "$(ip2int "$SERVER_IP")" ] && [ "$cur" -le "$MAX_HOST" ] \
        || die "$ip is outside the usable range of $SUBNET"
    if used_ips | grep -qxF -- "$ip"; then die "$ip is already assigned"; fi

    printf '\n  A device can send ALL its traffic through this server (a real VPN:\n'
    printf '  its public IP becomes %s), or only traffic to %s,\n' "$ENDPOINT" "$SUBNET"
    printf '  leaving its normal internet connection alone (split tunnel — for a\n'
    printf '  device you only want on the private network).\n'
    confirm_yes "  Route all of '$name' traffic through the VPN?" && ftun=yes

    # Only offered for a full-tunnel device: a custom gateway changes where the
    # traffic in the tunnel comes out, and a split-tunnel device does not put
    # its internet traffic in the tunnel in the first place.
    if [ "$ftun" = yes ] && [ -n "$(peer_names)" ]; then
        printf '\n  That traffic leaves through this server by default. It can leave\n'
        printf '  through another device on the VPN instead — so %s appears\n' "$name"
        printf '  to be browsing from that device rather than from here.\n'
        if confirm "  Send '$name' out through another device?"; then
            gw=$(resolve_gateway "$(ask "  Gateway (device name, or IP)" "")" "$ip")
            gwname=$(peer_by_ip "$gw")
        fi
    fi

    printf '\n  Every device is on the same tunnel subnet, so by default it can\n'
    printf '  reach the others (file shares, SSH, dev servers on 0.0.0.0...).\n'
    printf "  Answer 'n' for a device you do not fully trust — a phone you lend\n"
    printf '  out, a machine someone else uses. Your other devices can still\n'
    printf '  reach IN to it, and it still gets internet through this server.\n'
    confirm_yes "  Let '$name' reach the other devices?" && reach=yes

    printf '\n  Its web traffic (tcp/80 and tcp/443) can be diverted to an\n'
    printf '  intercepting proxy running on another device on this VPN — Burp\n'
    printf "  Suite with 'invisible proxying' enabled, or mitmproxy. The device\n"
    printf '  needs no proxy settings, so apps that ignore them are caught too.\n'
    if confirm "  Send '$name' web traffic through a proxy?"; then
        proxy=$(resolve_proxy "$(ask "  Proxy (device name, or ip[:port])" "")")
        [ "${proxy%%:*}" != "$ip" ] || die "a device cannot be its own proxy"
        info "proxying tcp/80 and tcp/443 to $proxy; udp/443 (QUIC) rejected"
    fi

    wg genkey > "$KEYDIR/$name.key"
    chmod 600 "$KEYDIR/$name.key"
    wg pubkey < "$KEYDIR/$name.key" > "$KEYDIR/$name.pub"
    chmod 644 "$KEYDIR/$name.pub"

    cat >> "$WG_CONF" <<EOF

### BEGIN peer $name
[Peer]
# $name
# full-tunnel = $ftun
# reach-peers = $reach${gw:+
# gateway = $gw}${proxy:+
# proxy = $proxy}
PublicKey  = $(cat "$KEYDIR/$name.pub")
AllowedIPs = $ip/32, $(v6_for "$ip")/128
### END peer $name
EOF

    sync_gateway_routes      # reloads wg; widens the gateway peer if there is one
    apply_rules add          # picks up this device's isolation and gateway rules
    write_client_conf "$name" "$ip" >/dev/null
    info "added '$name' at $ip$([ "$reach" = no ] && printf ', cannot open connections to the other devices' || true)"
    show_client "$name"
    [ -n "$proxy" ] && show_proxy_open "$proxy" "$name" "$ip"
    if [ -n "$gw" ]; then
        info "'$name' exits through '${gwname:-$gw}', which must be set up to forward:"
        show_gateway "${gwname:-$gw}"
    fi
}

do_remove() {
    head1 "Remove a device"
    list_peers
    local name gwip orphans=''
    name=$(ask "Device to remove")
    [ -n "$name" ] || return 0
    valid_name "$name"
    peer_exists "$name" || die "no such device: $name"

    # Removing the gateway would leave everything routed through it pointing at
    # an address that is no longer a peer, which blackholes their traffic
    # silently. Say so first, and drop the markers along with the device.
    gwip=$(peer_ip "$name")
    orphans=$(gateway_users | awk -v g="$gwip" '$2 == g {print $1}')
    if [ -n "$orphans" ]; then
        info "'$name' is the gateway for: $(printf '%s' "$orphans" | tr '\n' ' ')"
        info "they will go back to leaving through this server"
    fi

    confirm "Really remove '$name' and delete its keys?" || { info "aborted"; return 0; }

    # The rule set is derived from the peer list, so tear it down while this
    # device is still in the file — otherwise its isolation rules would be
    # orphaned in the chain — then rebuild from the trimmed one.
    apply_rules del

    awk -v w="$name" -v g="# gateway = $gwip" '
        $0 == "### BEGIN peer " w { skip=1 }
        !skip && $0 != g { print }
        $0 == "### END peer " w   { skip=0 }
    ' "$WG_CONF" > "$WG_CONF.new"
    mv "$WG_CONF.new" "$WG_CONF"
    chmod 600 "$WG_CONF"

    rm -f "$KEYDIR/$name.key" "$KEYDIR/$name.pub" "$CLIENTDIR/$name.conf"
    sync_gateway_routes      # reloads wg; narrows the peer that just lost the role
    apply_rules add
    info "removed '$name'"
}

do_isolate() {
    head1 "Device isolation"
    list_peers
    local name cur new=no
    name=$(ask "Device")
    [ -n "$name" ] || return 0
    valid_name "$name"
    peer_exists "$name" || die "no such device: $name"

    if peer_isolated "$name"; then cur=no; else cur=yes; fi
    if [ "$cur" = yes ]; then
        info "currently: '$name' can reach the other devices"
    else
        info "currently: '$name' cannot open connections to the other devices"
        info "           (they can still reach in to it)"
    fi

    # Default follows the current setting, so a stray Enter changes nothing.
    if [ "$cur" = yes ]; then
        confirm_yes "Let '$name' reach the other devices?" && new=yes
    else
        confirm     "Let '$name' reach the other devices?" && new=yes
    fi
    [ "$new" != "$cur" ] || { info "unchanged"; return 0; }

    apply_rules del          # built from the old marker; see do_remove
    # Always writes the marker, so devices added before this option existed —
    # which carry none at all — get one rather than staying unmanaged.
    awk -v w="$name" -v val="$new" '
        $0 == "### BEGIN peer " w    { f=1 }
        f && /^# reach-peers = /     { next }
        f && $0 == "### END peer " w { print "# reach-peers = " val; f=0 }
        { print }
    ' "$WG_CONF" > "$WG_CONF.new"
    mv "$WG_CONF.new" "$WG_CONF"
    chmod 600 "$WG_CONF"
    apply_rules add

    if [ "$new" = yes ]; then
        info "'$name' can now reach the other devices"
    else
        info "'$name' can no longer open connections to the other devices"
        [ -n "$(peer_proxy "$name")" ] && info "its proxy stays reachable, on the proxy port only"
    fi
    info "existing connections keep their old path until they are re-established"
}

# Two halves, because AllowedIPs is a client-side routing decision the protocol
# cannot push:
#   * the .conf here is rewritten, and the device has to be re-imported (option 3
#     or 4) before it stops SENDING its internet traffic into the tunnel;
#   * the firewall rule takes effect immediately, so the server stops CARRYING
#     it either way. That half needs nothing from the client, which is what makes
#     the setting enforceable rather than advisory.
do_route() {
    head1 "Default gateway"
    list_peers
    local name cur new=no ip mine gwcur gwnew='' gwname
    name=$(ask "Device")
    [ -n "$name" ] || return 0
    valid_name "$name"
    peer_exists "$name" || die "no such device: $name"
    mine=$(peer_ip "$name")

    if peer_full_tunnel "$name"; then cur=yes; else cur=no; fi
    gwcur=$(peer_gateway "$name")
    if [ "$cur" = yes ]; then
        if [ -n "$gwcur" ]; then
            gwname=$(peer_by_ip "$gwcur")
            info "currently: all of '$name' traffic goes through the VPN, leaving via '${gwname:-$gwcur}'"
        else
            info "currently: all of '$name' traffic goes through the VPN, leaving via this server"
        fi
        confirm_yes "Route all of '$name' traffic through the VPN?" && new=yes
    else
        info "currently: '$name' only routes $SUBNET through the VPN"
        confirm     "Route all of '$name' traffic through the VPN?" && new=yes
    fi

    # Where it comes OUT is a second question, and only has an answer while the
    # traffic is in the tunnel at all. A device turned split-tunnel loses its
    # gateway along with it, since there is nothing left to route.
    if [ "$new" = yes ]; then
        printf '\n  It can leave through this server, or through another device on\n'
        printf '  the VPN — so it appears to be browsing from that device.\n'
        if [ -n "$gwcur" ]; then
            gwname=$(peer_by_ip "$gwcur")
            if confirm_yes "  Keep sending '$name' out through '${gwname:-$gwcur}'?"; then
                gwnew=$(resolve_gateway "$(ask "  Gateway (device name, or IP)" "${gwname:-$gwcur}")" "$mine")
            fi
        elif confirm "  Send '$name' out through another device?"; then
            gwnew=$(resolve_gateway "$(ask "  Gateway (device name, or IP)" "")" "$mine")
        fi
    fi

    if [ "$new" = "$cur" ] && [ "$gwnew" = "$gwcur" ]; then info "unchanged"; return 0; fi

    if [ "$new" = no ] && [ "$cur" = yes ]; then
        printf '\n  The server stops forwarding its traffic to the internet as soon\n'
        printf '  as you confirm, and %s will not fall back to its own\n' "$name"
        printf '  connection until it has re-imported its config — so it loses\n'
        printf '  internet in between. Re-import it right after this.\n\n'
        confirm "  Go ahead?" || { info "aborted"; return 0; }
    fi

    apply_rules del          # built from the old markers; see do_remove
    # Always writes both markers, so devices added before these options existed —
    # which carry neither — get them rather than staying unmanaged.
    awk -v w="$name" -v val="$new" -v gw="$gwnew" '
        $0 == "### BEGIN peer " w    { f=1 }
        f && /^# full-tunnel = /     { next }
        f && /^# gateway = /         { next }
        f && $0 == "### END peer " w {
            print "# full-tunnel = " val
            if (gw != "") print "# gateway = " gw
            f=0
        }
        { print }
    ' "$WG_CONF" > "$WG_CONF.new"
    mv "$WG_CONF.new" "$WG_CONF"
    chmod 600 "$WG_CONF"
    sync_gateway_routes      # reloads wg; moves 0.0.0.0/0 to whoever holds the role now
    apply_rules add

    if [ ! -f "$KEYDIR/$name.key" ]; then
        die "'$name' is now full-tunnel=$new, but its private key is gone —
  its config cannot be rebuilt. Remove and re-add the device."
    fi
    ip=$(peer_ip "$name")
    write_client_conf "$name" "$ip" >/dev/null

    if [ "$new" = yes ]; then
        info "'$name' now uses the VPN as its default gateway"
        if [ -n "$gwnew" ]; then
            gwname=$(peer_by_ip "$gwnew")
            info "its traffic now leaves through '${gwname:-$gwnew}', in effect immediately"
            info "nothing on '$name' needs to change for that — the routing is all done here"
        else
            info "the server forwards its traffic to the internet again"
        fi
    else
        info "'$name' now routes only $SUBNET through the VPN"
        info "the server rejects its traffic to the internet as of now, re-imported or not"
        info "$SUBNET, this server and any proxy on the VPN stay reachable"
        [ -n "$gwcur" ] && info "it no longer exits through another device — there is nothing left to route"
        [ -n "$CLIENT_DNS" ] && info "the pushed DNS ($CLIENT_DNS) is dropped from its config — see option 8"
    fi
    if [ "$new" = "$cur" ]; then
        info "the tunnel setting itself did not change, so there is nothing to re-import"
    else
        info "re-import it (option 3 for the QR, option 4 for the Linux block) to take effect there"
    fi
    if [ -n "$gwnew" ] && [ "$gwnew" != "$gwcur" ]; then
        gwname=$(peer_by_ip "$gwnew")
        show_gateway "${gwname:-$gwnew}"
    fi
}

# Toggling the proxy is the thing you do constantly while testing, so it has to
# work without regenerating the device's keys and re-pairing it.
do_proxy() {
    head1 "Proxy for a device"
    list_peers
    local name cur new=''
    name=$(ask "Device")
    [ -n "$name" ] || return 0
    valid_name "$name"
    peer_exists "$name" || die "no such device: $name"

    cur=$(peer_proxy "$name")
    info "currently: ${cur:-no proxy}"
    if [ -n "$cur" ]; then
        confirm_yes "Keep proxying '$name'?" && new=$(resolve_proxy "$(ask "Proxy (device name, or ip[:port])" "$cur")")
    else
        confirm "Send '$name' web traffic through a proxy?" \
            && new=$(resolve_proxy "$(ask "Proxy (device name, or ip[:port])" "")")
    fi
    [ "${new%%:*}" != "$(peer_ip "$name")" ] || die "a device cannot be its own proxy"
    [ "$new" != "$cur" ] || { info "unchanged"; return 0; }

    apply_rules del          # built from the old marker; see do_remove
    awk -v w="$name" -v px="$new" '
        $0 == "### BEGIN peer " w    { f=1 }
        f && /^# proxy = /           { next }
        f && $0 == "### END peer " w { if (px != "") print "# proxy = " px; f=0 }
        { print }
    ' "$WG_CONF" > "$WG_CONF.new"
    mv "$WG_CONF.new" "$WG_CONF"
    chmod 600 "$WG_CONF"
    apply_rules add

    if [ -n "$new" ]; then
        info "'$name' now proxied to $new (tcp/80, tcp/443; udp/443 rejected)"
        info "the proxy must listen on $new and have invisible/transparent mode on"
    else
        info "'$name' is no longer proxied"
    fi
    info "existing connections keep their old path until they are re-established"
    [ -n "$new" ] && show_proxy_open "$new" "$name" "$(peer_ip "$name")"
    return 0
}

# Regenerate every client .conf from the current state and per-peer markers.
# Needed after anything that changes what goes INTO those files: the DNS option,
# and — because the generator itself can change — after upgrading this script.
# That second case is what `simplewire --rebuild-clients` is for. Server keys and
# the [Peer] blocks in wg0.conf are untouched, so the tunnel keeps running and no
# device has to be re-paired; they only have to re-import.
# Sets REBUILT to the number of configs written.
rebuild_confs() {
    local name ip
    REBUILT=0
    while read -r name; do
        [ -n "$name" ] || continue
        if [ ! -f "$KEYDIR/$name.key" ]; then
            info "skipped '$name' — its private key is gone, cannot rebuild its config"
            continue
        fi
        ip=$(peer_ip "$name")
        write_client_conf "$name" "$ip" >/dev/null
        REBUILT=$((REBUILT+1))
    done < <(peer_names)
}

# DNS lives in the CLIENT config, so this only changes what the .conf files on
# this server say. A device that already holds its config keeps the old resolver
# until it is re-imported — there is no way to push it from here.
do_dns() {
    head1 "DNS pushed to clients"
    info "current: ${CLIENT_DNS:-none}"
    printf '\n  This is the resolver written into each client config. Changing it\n'
    printf '  rebuilds the .conf files here, but a device that is already paired\n'
    printf '  keeps its old resolver until you re-import it (option 3 for the QR,\n'
    printf '  option 4 for the Linux block).\n\n'

    local dns
    dns=$(ask "DNS pushed to clients (or 'none')" "${CLIENT_DNS:-none}")
    if [ "$dns" = "none" ]; then dns=""; fi
    [ -z "$dns" ] || [[ $dns =~ ^[0-9a-fA-F.:,\ ]+$ ]] || die "DNS must be IP addresses: $dns"
    [ "$dns" != "$CLIENT_DNS" ] || { info "unchanged"; return 0; }

    CLIENT_DNS=$dns
    write_state
    rebuild_confs

    info "DNS is now ${CLIENT_DNS:-none}; rebuilt $REBUILT client config(s)"
    info "split-tunnel devices keep their own resolver — they get no DNS line"
    if [ "$REBUILT" -gt 0 ]; then
        info "re-import each device (option 3 or 4) before it takes effect there"
    fi
}

do_uninstall() {
    head1 "Uninstall"
    printf 'This removes the %s interface, the simplewire iptables rules and every key.\n' "$WG_IF"
    local ans
    ans=$(ask "Type UNINSTALL to confirm")
    [ "$ans" = "UNINSTALL" ] || { info "aborted"; return 0; }

    systemctl disable -q --now "wg-quick@$WG_IF" 2>/dev/null || true
    ip link del "$WG_IF" 2>/dev/null || true
    apply_rules del
    rm -f "$SYSCTL_FILE"
    sysctl -q --system
    rm -rf "$WGDIR"
    info "removed $WGDIR, iptables rules and $SYSCTL_FILE"

    local pm
    if pm=$(detect_pm) && confirm "Also remove the wireguard-tools and qrencode packages?"; then
        case $pm in
            apt-get) DEBIAN_FRONTEND=noninteractive apt-get purge -y -qq wireguard-tools qrencode ;;
            pacman)  pacman -Rns --noconfirm wireguard-tools qrencode ;;
            dnf)     dnf remove -y -q wireguard-tools qrencode ;;
            zypper)  zypper --non-interactive --quiet remove wireguard-tools qrencode ;;
        esac
    fi
    info "done"
}

do_status() {
    head1 "Status"
    systemctl is-active --quiet "wg-quick@$WG_IF" \
        && info "wg-quick@$WG_IF: active" || info "wg-quick@$WG_IF: INACTIVE"
    printf '\n'
    wg show "$WG_IF" 2>/dev/null || info "(interface is down)"
    printf '\nDevices:\n'
    list_peers
    printf '\nFirewall rules tagged "%s":\n' "$TAG"
    { iptables-save; ip6tables-save 2>/dev/null || true; } \
        | grep -- "$TAG" | sed 's/^/  /' || info "  (none)"
    if [ -n "$(gateway_users)" ]; then
        printf '\nPolicy routing for devices exiting through another device:\n'
        ip rule show | grep -- "lookup $GW_TABLE" | sed 's/^/  /' || info "  (no ip rules!)"
        ip route show table "$GW_TABLE" 2>/dev/null | sed "s/^/  table $GW_TABLE: /" \
            || info "  (table $GW_TABLE is empty!)"
    fi
}

# -------------------------------------------------------------------- menu ---

menu_installed() {
    while true; do
        load_state
        head1 "WireGuard on $ENDPOINT:$PORT — $SUBNET"
        list_peers
        printf '\n  1) Add a device\n  2) Remove a device\n'
        printf '  3) Show QR for a device        (phones, any QR-capable client)\n'
        printf '  4) Show paste-and-run setup    (Linux)\n'
        printf '  5) Device isolation            (reach other devices?)\n'
        printf '  6) Proxy for a device          (Burp / mitmproxy)\n'
        printf '  7) Default gateway             (all traffic? and out through whom?)\n'
        printf '  8) DNS pushed to clients\n'
        printf '  9) Status\n 10) Uninstall server\n  q) Quit\n\n'
        local choice
        choice=$(ask "Choice" "q")
        case $choice in
            1) do_add ;;
            2) do_remove ;;
            3) local n; n=$(ask "Device name"); if [ -n "$n" ]; then show_client "$n"; fi ;;
            4) local m; m=$(ask "Device name"); if [ -n "$m" ]; then show_linux  "$m"; fi ;;
            5) do_isolate ;;
            6) do_proxy ;;
            7) do_route ;;
            8) do_dns ;;
            9) do_status ;;
            10) do_uninstall; return 0 ;;
            q|Q) return 0 ;;
            *) info "no such option" ;;
        esac
    done
}

main() {
    need_root

    # Non-interactive mode, called from wg0.conf's PostUp. Handled before the
    # tty check below because at boot there is no terminal, and kept minimal so
    # a failure here cannot stop the tunnel from coming up.
    if [ "${1-}" = --apply-rules ]; then
        is_installed || die "not installed — no $STATE"
        load_state
        apply_rules add
        return 0
    fi

    # Rewrite every client .conf with the current generator. Run this after
    # dropping in a new version of this script: the configs on disk were written
    # by the old one and are not regenerated by anything else. Non-interactive
    # and safe to repeat — it changes no keys and does not touch the interface.
    if [ "${1-}" = --rebuild-clients ]; then
        is_installed || die "not installed — no $STATE"
        load_state
        rebuild_confs
        info "rebuilt $REBUILT client config(s) in $CLIENTDIR"
        info "re-import each device (menu option 3 or 4) before it changes there"
        return 0
    fi

    # Every prompt below reads stdin. Piped into bash (curl … | sudo bash) stdin
    # is the script itself, so `read` would silently eat its own source lines.
    [ -t 0 ] || die "run this from a terminal — download the script first, do not pipe it into bash"
    command -v ip >/dev/null || die "iproute2 is missing"
    require_platform

    if is_installed; then
        menu_installed
    else
        head1 "No WireGuard server configured on this host"
        printf '\n  1) Install WireGuard server\n  q) Quit\n\n'
        local choice
        choice=$(ask "Choice" "1")
        case $choice in
            1) do_install; load_state; menu_installed ;;
            *) return 0 ;;
        esac
    fi
}

main "$@"
